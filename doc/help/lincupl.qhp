<?xml version="1.0" encoding="UTF-8"?>
<!-- Qt Help project of the LinCUPL help: the contents tree and the index.
     Index keywords for CUPL words are in the form the editor's F1 lookup
     asks for: upper case words, "$WORD", ".ext" and ":&". -->
