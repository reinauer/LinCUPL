}

device ATF2500C_DIP40 : ATF2500C {}

device ATF2500C_PLCC44 : ATF2500C {
    mnemonic = v2500clcc
    package = PLCC44
    pins = 44
    pin_map {
        physical = [1..3, 5..10, 12..25, 27..32, 34..44]
        ground = [4, 26, 33]
        supply = [11]
    }
    variant v2500cppklcc { pin_keeper = enabled }
}
