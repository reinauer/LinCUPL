# Compile with tools/devcompile.py.
# See doc/device-implementation.md for supported behavior and differences.
format = 1

family GAL20V8 {
    architecture = gal20v8
    package = DIP24
    pins = 24
    fuses = 2706
    default_fuse = 0
    inputs = [2..11, 14, 23]
    outputs = [15..22]
    global_clock = pin(1)
    global_enable = inverted(pin(13))

    power { ground = 12 supply = 24 }

    array logic {
        rows = 64
        columns = 40
        first_fuse = 0
        address_order = row_major
        crosspoint { connected = 0 disconnected = 1 }
    }

    # Each listed source occupies a true/complement column pair, in order.
    # Registered feedback reads the register; other modes read the pad.
    pin_columns {
        registered = [2, 23, 3, 22, 4, 21, 5, 20, 6, 19, 7, 18, 8, 17, 9, 16, 10, 15, 11, 14]
        complex = [2, 1, 3, 23, 4, 21, 5, 20, 6, 19, 7, 18, 8, 17, 9, 16, 10, 14, 11, 13]
        simple = [2, 1, 3, 23, 4, 22, 5, 21, 6, 20, 7, 17, 8, 16, 9, 15, 10, 14, 11, 13]
    }

    setting mode {
        fuses = [2704, 2705] # SYN, AC0, least significant bit first
        registered = 2
        complex = 3
        simple = 1
    }

    signature {
        first_fuse = 2568
        bits = 64
        byte_order = text_order
        bit_order = most_significant_first
        default_bit = 0
    }

    product_disable {
        first_fuse = 2640
        bits = 64
        enabled = 1
        disabled = 0
    }

    macrocell_template configurable {
        parameters = [pin, first_row, polarity_fuse, cell_mode_fuse]
        product_terms {
            registered = rows(logic, first_row, 8)
            simple = rows(logic, first_row, 8)
            combinational = rows(logic, first_row + 1, 7)
            output_enable = product(logic, first_row)
        }
        setting polarity {
            fuses = [polarity_fuse]
            inverted = 0
            normal = 1
        }
        setting cell_mode {
            fuses = [cell_mode_fuse] # AC1 has different meanings by mode.
            registered = 0
            combinational = 1
            simple_output = 0
            simple_input = 1
        }
        register state {
            data = polarity(sum)
            clock = device.global_clock
            edge = rising
            type = d
            power_up = low
        }
        output {
            pin = pin
            registered = inverted(state.q)
            combinational = inverted(polarity(sum))
            registered_enable = device.global_enable
            combinational_enable = output_enable
            simple_enable = always
        }
        feedback {
            registered = inverted(state.q)
            combinational = pin_level(pin)
        }
    }

    macrocell output22 : configurable {
        pin = 22 first_row = 0 polarity_fuse = 2560 cell_mode_fuse = 2632
    }
    macrocell output21 : configurable {
        pin = 21 first_row = 8 polarity_fuse = 2561 cell_mode_fuse = 2633
    }
    macrocell output20 : configurable {
        pin = 20 first_row = 16 polarity_fuse = 2562 cell_mode_fuse = 2634
    }
    macrocell output19 : configurable {
        pin = 19 first_row = 24 polarity_fuse = 2563 cell_mode_fuse = 2635
    }
    macrocell output18 : configurable {
        pin = 18 first_row = 32 polarity_fuse = 2564 cell_mode_fuse = 2636
    }
    macrocell output17 : configurable {
        pin = 17 first_row = 40 polarity_fuse = 2565 cell_mode_fuse = 2637
    }
    macrocell output16 : configurable {
        pin = 16 first_row = 48 polarity_fuse = 2566 cell_mode_fuse = 2638
    }
    macrocell output15 : configurable {
        pin = 15 first_row = 56 polarity_fuse = 2567 cell_mode_fuse = 2639
    }
}

family GAL20V8CP : GAL20V8 {
    fuses = 2707
    power_down {
        control = pin(4)
        fuse = 2706
        disabled = 0
        pin_controlled = 1
        selection = pin_controlled
    }
}

family GAL20V8_PLCC28 : GAL20V8 {
    package = PLCC28
    pins = 28
    pin_map {
        physical = [2..7, 9..14, 16..21, 23..28]
        unconnected = [1, 8, 15, 22]
    }
}
family GAL20V8CP_PLCC28 : GAL20V8CP {
    package = PLCC28
    pins = 28
    pin_map {
        physical = [2..7, 9..14, 16..21, 23..28]
        unconnected = [1, 8, 15, 22]
    }
}

device G20V8 : GAL20V8 {
    mnemonic = g20v8
    mode = automatic
    mode_devices {
        registered = g20v8ms complex = g20v8ma simple = g20v8s
        combinational_feedback = complex
    }
}

device G20V8A : GAL20V8 {
    mnemonic = g20v8a
    mode = automatic
    mode_devices {
        registered = g20v8ms complex = g20v8ma simple = g20v8as
        combinational_feedback = simple
    }
}

device G20V8CP : GAL20V8CP {
    mnemonic = g20v8cp
    mode = automatic
    mode_devices {
        registered = g20v8cpms complex = g20v8cpma simple = g20v8cps
        combinational_feedback = simple
    }
}
device G20V8MS : GAL20V8 { mnemonic = g20v8ms mode = registered }
device G20V8MA : GAL20V8 { mnemonic = g20v8ma mode = complex }
device G20V8S : GAL20V8 { mnemonic = g20v8s mode = simple }
device G20V8AS : GAL20V8 { mnemonic = g20v8as mode = simple }
device G20V8CPMS : GAL20V8CP { mnemonic = g20v8cpms mode = registered }
device G20V8CPMA : GAL20V8CP { mnemonic = g20v8cpma mode = complex }
device G20V8CPS : GAL20V8CP { mnemonic = g20v8cps mode = simple }

device G20V8LCC : GAL20V8_PLCC28 {
    mnemonic = g20v8lcc
    mode = automatic
    mode_devices {
        registered = g20v8mslcc complex = g20v8malcc simple = g20v8slcc
        combinational_feedback = complex
    }
}

device G20V8ALCC : GAL20V8_PLCC28 {
    mnemonic = g20v8alcc
    mode = automatic
    mode_devices {
        registered = g20v8mslcc complex = g20v8malcc simple = g20v8aslcc
        combinational_feedback = simple
    }
}

device G20V8CPLCC : GAL20V8CP_PLCC28 {
    mnemonic = g20v8cplcc
    mode = automatic
    mode_devices {
        registered = g20v8cpmslcc complex = g20v8cpmalcc simple = g20v8cpslcc
        combinational_feedback = simple
    }
}
device G20V8MSLCC : GAL20V8_PLCC28 { mnemonic = g20v8mslcc mode = registered }
device G20V8MALCC : GAL20V8_PLCC28 { mnemonic = g20v8malcc mode = complex }
device G20V8SLCC : GAL20V8_PLCC28 { mnemonic = g20v8slcc mode = simple }
device G20V8ASLCC : GAL20V8_PLCC28 { mnemonic = g20v8aslcc mode = simple }
device G20V8CPMSLCC : GAL20V8CP_PLCC28 { mnemonic = g20v8cpmslcc mode = registered }
device G20V8CPMALCC : GAL20V8CP_PLCC28 { mnemonic = g20v8cpmalcc mode = complex }
device G20V8CPSLCC : GAL20V8CP_PLCC28 { mnemonic = g20v8cpslcc mode = simple }
