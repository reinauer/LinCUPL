# Compile with tools/devcompile.py.
# See doc/device-implementation.md for supported behavior and differences.
format = 1

family GAL16V8 {
    architecture = gal16v8
    package = DIP20
    pins = 20
    fuses = 2194
    default_fuse = 0
    inputs = [2..9]
    outputs = [12..19]
    global_clock = pin(1)
    global_enable = inverted(pin(11))

    power { ground = 10 supply = 20 }

    array logic {
        rows = 64
        columns = 32
        first_fuse = 0
        address_order = row_major
        crosspoint { connected = 0 disconnected = 1 }
    }

    # Each listed source occupies a true/complement column pair, in order.
    # Registered feedback reads the register; other modes read the pad.
    pin_columns {
        registered = [2, 19, 3, 18, 4, 17, 5, 16, 6, 15, 7, 14, 8, 13, 9, 12]
        complex = [2, 1, 3, 18, 4, 17, 5, 16, 6, 15, 7, 14, 8, 13, 9, 11]
        simple = [2, 1, 3, 19, 4, 18, 5, 17, 6, 14, 7, 13, 8, 12, 9, 11]
    }

    setting mode {
        fuses = [2192, 2193] # SYN, AC0, least significant bit first
        registered = 2
        complex = 3
        simple = 1
    }

    signature {
        first_fuse = 2056
        bits = 64
        byte_order = text_order
        bit_order = most_significant_first
        default_bit = 0
    }

    product_disable {
        first_fuse = 2128
        bits = 64
        enabled = 1
        disabled = 0
    }

    macrocell_template configurable {
        parameters = [pin, first_row, polarity_fuse, cell_mode_fuse]
        product_terms {
            registered = rows(logic, first_row, 8)
            simple = rows(logic, first_row, 8)
            combinational = rows(logic, first_row + 1, 7)
            output_enable = product(logic, first_row)
        }
        setting polarity {
            fuses = [polarity_fuse]
            inverted = 0
            normal = 1
        }
        setting cell_mode {
            fuses = [cell_mode_fuse] # AC1 has different meanings by mode.
            registered = 0
            combinational = 1
            simple_output = 0
            simple_input = 1
        }
        register state {
            data = polarity(sum)
            clock = device.global_clock
            edge = rising
            type = d
            power_up = low
        }
        output {
            pin = pin
            registered = inverted(state.q)
            combinational = inverted(polarity(sum))
            registered_enable = device.global_enable
            combinational_enable = output_enable
            simple_enable = always
        }
        feedback {
            registered = inverted(state.q)
            combinational = pin_level(pin)
        }
    }

    macrocell output19 : configurable {
        pin = 19 first_row = 0 polarity_fuse = 2048 cell_mode_fuse = 2120
    }
    macrocell output18 : configurable {
        pin = 18 first_row = 8 polarity_fuse = 2049 cell_mode_fuse = 2121
    }
    macrocell output17 : configurable {
        pin = 17 first_row = 16 polarity_fuse = 2050 cell_mode_fuse = 2122
    }
    macrocell output16 : configurable {
        pin = 16 first_row = 24 polarity_fuse = 2051 cell_mode_fuse = 2123
    }
    macrocell output15 : configurable {
        pin = 15 first_row = 32 polarity_fuse = 2052 cell_mode_fuse = 2124
    }
    macrocell output14 : configurable {
        pin = 14 first_row = 40 polarity_fuse = 2053 cell_mode_fuse = 2125
    }
    macrocell output13 : configurable {
        pin = 13 first_row = 48 polarity_fuse = 2054 cell_mode_fuse = 2126
    }
    macrocell output12 : configurable {
        pin = 12 first_row = 56 polarity_fuse = 2055 cell_mode_fuse = 2127
    }
}

device GAL16V8_AUTO : GAL16V8 {
    mnemonic = g16v8
    mode = automatic
    mode_devices { registered = g16v8ms complex = g16v8ma simple = g16v8s }
}
device GAL16V8_REGISTERED : GAL16V8 { mnemonic = g16v8ms mode = registered }
device GAL16V8_COMPLEX : GAL16V8 { mnemonic = g16v8ma mode = complex }
device GAL16V8_SIMPLE : GAL16V8 { mnemonic = g16v8s mode = simple }

# The A view retains complex-mode preference for combinational feedback.
device GAL16V8A_AUTO : GAL16V8 {
    mnemonic = g16v8a
    mode = automatic
    mode_devices { registered = g16v8ms complex = g16v8ma simple = g16v8as }
}
device GAL16V8A_SIMPLE : GAL16V8 { mnemonic = g16v8as mode = simple }

# C views prefer simple mode for feedback unless a register or output enable is used.
device GAL16V8C_AUTO : GAL16V8 {
    mnemonic = g16v8c
    mode = automatic
    mode_devices {
        registered = g16v8cms complex = g16v8cma simple = g16v8cas
        combinational_feedback = simple
    }
}
device GAL16V8C_REGISTERED : GAL16V8 { mnemonic = g16v8cms mode = registered }
device GAL16V8C_COMPLEX : GAL16V8 { mnemonic = g16v8cma mode = complex }
device GAL16V8C_SIMPLE : GAL16V8 { mnemonic = g16v8cas mode = simple }

family GAL16V8CP : GAL16V8 {
    fuses = 2195
    power_down {
        control = pin(4)
        fuse = 2194
        disabled = 0
        pin_controlled = 1
        selection = pin_controlled
    }
}
device GAL16V8CP_AUTO : GAL16V8CP {
    mnemonic = g16v8cp
    mode = automatic
    mode_devices {
        registered = g16v8cpms complex = g16v8cpma simple = g16v8cpas
        combinational_feedback = simple
    }
}
device GAL16V8CP_REGISTERED : GAL16V8CP { mnemonic = g16v8cpms mode = registered }
device GAL16V8CP_COMPLEX : GAL16V8CP { mnemonic = g16v8cpma mode = complex }
device GAL16V8CP_SIMPLE : GAL16V8CP { mnemonic = g16v8cpas mode = simple }
