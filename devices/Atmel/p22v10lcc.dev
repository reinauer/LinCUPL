# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p22v10lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 2
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 5828
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 17
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 132
        initial_term_capacity = 120
        array_slots = 23
        input_line_slots = 29
        extra_symbols = 30
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
