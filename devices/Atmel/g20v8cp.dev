# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20v8cp {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 2707
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 25
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(1, 1, none, unspecified),
            row(2, 2, none, unspecified),
            row(3, 3, none, unspecified),
            row(4, 4, extension_40, 25),
            row(5, 5, none, unspecified),
            row(6, 6, none, unspecified),
            row(7, 7, none, unspecified),
            row(8, 8, none, unspecified),
            row(9, 9, none, unspecified),
            row(10, 10, none, unspecified),
            row(11, 11, none, unspecified),
            row(12, 13, none, unspecified),
            row(13, 14, none, unspecified),
            row(14, 15, none, unspecified),
            row(15, 16, none, unspecified),
            row(16, 17, none, unspecified),
            row(17, 18, none, unspecified),
            row(18, 19, none, unspecified),
            row(19, 20, none, unspecified),
            row(20, 21, none, unspecified),
            row(21, 22, none, unspecified),
            row(22, 23, none, unspecified),
            row(23, 12, none, ground),
            row(24, 24, none, supply),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, row_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 22, array, control, 40, 1, 0, no, 0, no),
            row(1, 22, oe, control, 0, 0, 2, no, 0, no),
            row(2, 22, array, negative, 40, 7, 0, no, 0, no),
            row(2, 22, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(2, 22, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(3, 22, array, negative, 40, 8, 0, no, 0, no),
            row(3, 22, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(3, 22, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(4, 21, array, control, 40, 1, 0, no, 0, no),
            row(4, 21, oe, control, 0, 0, 2, no, 0, no),
            row(5, 21, array, negative, 40, 7, 0, no, 0, no),
            row(5, 21, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(5, 21, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(6, 21, array, negative, 40, 8, 0, no, 0, no),
            row(6, 21, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(6, 21, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(7, 20, array, control, 40, 1, 0, no, 0, no),
            row(7, 20, oe, control, 0, 0, 2, no, 0, no),
            row(8, 20, array, negative, 40, 7, 0, no, 0, no),
            row(8, 20, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(8, 20, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(9, 20, array, negative, 40, 8, 0, no, 0, no),
            row(9, 20, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(9, 20, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(10, 19, array, control, 40, 1, 0, no, 0, no),
            row(10, 19, oe, control, 0, 0, 2, no, 0, no),
            row(11, 19, array, negative, 40, 7, 0, no, 0, no),
            row(11, 19, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(11, 19, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(12, 19, array, negative, 40, 8, 0, no, 0, no),
            row(12, 19, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(12, 19, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(13, 18, array, control, 40, 1, 0, no, 0, no),
            row(13, 18, oe, control, 0, 0, 2, no, 0, no),
            row(14, 18, array, negative, 40, 7, 0, no, 0, no),
            row(14, 18, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(14, 18, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(15, 18, array, negative, 40, 8, 0, no, 0, no),
            row(15, 18, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(15, 18, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(16, 17, array, control, 40, 1, 0, no, 0, no),
            row(16, 17, oe, control, 0, 0, 2, no, 0, no),
            row(17, 17, array, negative, 40, 7, 0, no, 0, no),
            row(17, 17, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(17, 17, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(18, 17, array, negative, 40, 8, 0, no, 0, no),
            row(18, 17, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(18, 17, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(19, 16, array, control, 40, 1, 0, no, 0, no),
            row(19, 16, oe, control, 0, 0, 2, no, 0, no),
            row(20, 16, array, negative, 40, 7, 0, no, 0, no),
            row(20, 16, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(20, 16, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(21, 16, array, negative, 40, 8, 0, no, 0, no),
            row(21, 16, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(21, 16, d, programmable_negative, 0, 0, 0, no, 1, yes),
            row(22, 15, array, control, 40, 1, 0, no, 0, no),
            row(22, 15, oe, control, 0, 0, 2, no, 0, no),
            row(23, 15, array, negative, 40, 7, 0, no, 0, no),
            row(23, 15, none, programmable_positive, 0, 0, 0, yes, 1, yes),
            row(23, 15, none, programmable_negative, 0, 0, 0, yes, 1, yes),
            row(24, 15, array, negative, 40, 8, 0, no, 0, no),
            row(24, 15, d, programmable_positive, 0, 0, 0, no, 1, yes),
            row(24, 15, d, programmable_negative, 0, 0, 0, no, 1, yes),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

    alternatives {
        columns = [device, condition, priority]
        rows = [
            row("g20v8cpms", uses_d, 3),
            row("g20v8cpma", uses_oe, 2),
            row("g20v8cps", always, 1),
        ]
    }

}
