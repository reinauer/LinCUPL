# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20v8slcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2706
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 27
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
        }
        columns = [line, pin, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 3, unspecified, 0, 1, 0, 0, 65536),
            row(2, 2, unspecified, 2, 3, 0, 0, 65536),
            row(3, 4, unspecified, 4, 5, 0, 0, 65536),
            row(4, 27, unspecified, 6, 7, 0, 0, 65536),
            row(5, 5, unspecified, 8, 9, 0, 0, 65536),
            row(6, 26, unspecified, 10, 11, 1, 1, 2632),
            row(7, 6, unspecified, 12, 13, 0, 0, 0),
            row(8, 25, unspecified, 14, 15, 1, 1, 2633),
            row(9, 7, unspecified, 16, 17, 0, 0, 0),
            row(10, 24, unspecified, 18, 19, 1, 1, 2634),
            row(11, 9, unspecified, 20, 21, 0, 0, 0),
            row(12, 20, unspecified, 22, 23, 1, 1, 2637),
            row(13, 10, unspecified, 24, 25, 0, 0, 0),
            row(14, 19, unspecified, 26, 27, 1, 1, 2638),
            row(15, 11, unspecified, 28, 29, 0, 0, 0),
            row(16, 18, unspecified, 30, 31, 1, 1, 2639),
            row(17, 12, unspecified, 32, 33, 0, 0, 0),
            row(18, 17, unspecified, 34, 35, 0, 0, 0),
            row(19, 13, unspecified, 36, 37, 0, 0, 0),
            row(20, 16, unspecified, 38, 39, 0, 0, 0),
            row(21, 14, ground, 0, 0, 0, 0, 0),
            row(22, 28, supply, 0, 0, 0, 0, 0),
            row(23, 1, not_connected, 0, 0, 0, 0, 0),
            row(24, 8, not_connected, 0, 0, 0, 0, 0),
            row(25, 15, not_connected, 0, 0, 0, 0, 0),
            row(26, 22, not_connected, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, active]
        rows = [
            row(1, 26, array, negative, 0, 0, 0, 40, 0, 8, no, no),
            row(1, 26, none, programmable_positive, 1, 2560, 2632, 1, 1, 0, yes, yes),
            row(1, 26, none, programmable_negative, 0, 2560, 2632, 1, 1, 0, yes, yes),
            row(2, 25, array, negative, 0, 320, 0, 40, 0, 8, no, no),
            row(2, 25, none, programmable_positive, 1, 2561, 2633, 1, 1, 0, yes, yes),
            row(2, 25, none, programmable_negative, 0, 2561, 2633, 1, 1, 0, yes, yes),
            row(3, 24, array, negative, 0, 640, 0, 40, 0, 8, no, no),
            row(3, 24, none, programmable_positive, 1, 2562, 2634, 1, 1, 0, yes, yes),
            row(3, 24, none, programmable_negative, 0, 2562, 2634, 1, 1, 0, yes, yes),
            row(4, 23, array, negative, 0, 960, 0, 40, 0, 8, no, no),
            row(4, 23, none, programmable_positive, 1, 2563, 2635, 1, 1, 0, yes, yes),
            row(4, 23, none, programmable_negative, 0, 2563, 2635, 1, 1, 0, yes, yes),
            row(5, 21, array, negative, 0, 1280, 0, 40, 0, 8, no, no),
            row(5, 21, none, programmable_positive, 1, 2564, 2636, 1, 1, 0, yes, yes),
            row(5, 21, none, programmable_negative, 0, 2564, 2636, 1, 1, 0, yes, yes),
            row(6, 20, array, negative, 0, 1600, 0, 40, 0, 8, no, no),
            row(6, 20, none, programmable_positive, 1, 2565, 2637, 1, 1, 0, yes, yes),
            row(6, 20, none, programmable_negative, 0, 2565, 2637, 1, 1, 0, yes, yes),
            row(7, 19, array, negative, 0, 1920, 0, 40, 0, 8, no, no),
            row(7, 19, none, programmable_positive, 1, 2566, 2638, 1, 1, 0, yes, yes),
            row(7, 19, none, programmable_negative, 0, 2566, 2638, 1, 1, 0, yes, yes),
            row(8, 18, array, negative, 0, 2240, 0, 40, 0, 8, no, no),
            row(8, 18, none, programmable_positive, 1, 2567, 2639, 1, 1, 0, yes, yes),
            row(8, 18, none, programmable_negative, 0, 2567, 2639, 1, 1, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2704),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 26, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(set, 1, " ", 5, 2632, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 0, 0),
            row(if_equal, 1, " ", 1, 33, 0, 1),
            row(set, 1, " ", 2, 21, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 9),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2568, 2631, 0),
            row(2632, 2639, 1),
            row(2640, 2703, 1),
            row(2704, 2704, 1),
            row(2705, 2705, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
