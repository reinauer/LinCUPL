            row(9, 18, oe, 5, 1),
            row(12, 17, none, 6, 0),
            row(11, 17, oe, 6, 1),
            row(14, 16, none, 7, 0),
            row(13, 16, oe, 7, 1),
            row(16, 15, none, 8, 0),
            row(15, 15, oe, 8, 1),
