    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 22, none, 1, 0),
            row(1, 22, oe, 1, 1),
            row(4, 21, none, 2, 0),
            row(3, 21, oe, 2, 1),
            row(6, 20, none, 3, 0),
