# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20v8cpma {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2707
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 23
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, none, unspecified, 2, 3),
            row(2, 2, none, unspecified, 0, 1),
            row(3, 3, none, unspecified, 4, 5),
            row(4, 23, none, unspecified, 6, 7),
            row(5, 4, extension_40, 25, 0, 0),
            row(6, 21, none, feedback, 10, 11),
            row(7, 5, none, unspecified, 12, 13),
            row(8, 20, none, feedback, 14, 15),
            row(9, 6, none, unspecified, 16, 17),
            row(10, 19, none, feedback, 18, 19),
            row(11, 7, none, unspecified, 20, 21),
            row(12, 18, none, feedback, 22, 23),
            row(13, 8, none, unspecified, 24, 25),
            row(14, 17, none, feedback, 26, 27),
            row(15, 9, none, unspecified, 28, 29),
            row(16, 16, none, feedback, 30, 31),
            row(17, 10, none, unspecified, 32, 33),
            row(18, 14, none, unspecified, 34, 35),
            row(19, 11, none, unspecified, 36, 37),
            row(20, 13, none, unspecified, 38, 39),
            row(21, 12, none, ground, 0, 0),
            row(22, 24, none, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, config_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, default_rule, has_default, active, legacy_width]
        rows = [
            row(1, 22, array, control, 0, 0, 0, 0, 40, 0, 1, 0, no, no, 40),
            row(1, 22, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(2, 22, array, negative, 0, 0, 40, 0, 40, 0, 7, 0, no, no, 40),
            row(2, 22, none, programmable_positive, 1, 1, 2560, 2632, 1, 1, 0, 0, yes, yes, 0),
            row(2, 22, none, programmable_negative, 0, 1, 2560, 2632, 1, 1, 0, 0, yes, yes, 0),
            row(3, 21, array, control, 0, 0, 320, 0, 40, 0, 1, 0, no, no, 40),
            row(3, 21, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(4, 21, array, negative, 0, 0, 360, 0, 40, 0, 7, 0, no, no, 40),
            row(4, 21, none, programmable_positive, 1, 1, 2561, 2633, 1, 1, 0, 0, yes, yes, 0),
            row(4, 21, none, programmable_negative, 0, 1, 2561, 2633, 1, 1, 0, 0, yes, yes, 0),
            row(5, 20, array, control, 0, 0, 640, 0, 40, 0, 1, 0, no, no, 40),
            row(5, 20, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(6, 20, array, negative, 0, 0, 680, 0, 40, 0, 7, 0, no, no, 40),
            row(6, 20, none, programmable_positive, 1, 1, 2562, 2634, 1, 1, 0, 0, yes, yes, 0),
            row(6, 20, none, programmable_negative, 0, 1, 2562, 2634, 1, 1, 0, 0, yes, yes, 0),
            row(7, 19, array, control, 0, 0, 960, 0, 40, 0, 1, 0, no, no, 40),
            row(7, 19, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(8, 19, array, negative, 0, 0, 1000, 0, 40, 0, 7, 0, no, no, 40),
            row(8, 19, none, programmable_positive, 1, 1, 2563, 2635, 1, 1, 0, 0, yes, yes, 0),
            row(8, 19, none, programmable_negative, 0, 1, 2563, 2635, 1, 1, 0, 0, yes, yes, 0),
            row(9, 18, array, control, 0, 0, 1280, 0, 40, 0, 1, 0, no, no, 40),
            row(9, 18, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(10, 18, array, negative, 0, 0, 1320, 0, 40, 0, 7, 0, no, no, 40),
            row(10, 18, none, programmable_positive, 1, 1, 2564, 2636, 1, 1, 0, 0, yes, yes, 0),
            row(10, 18, none, programmable_negative, 0, 1, 2564, 2636, 1, 1, 0, 0, yes, yes, 0),
            row(11, 17, array, control, 0, 0, 1600, 0, 40, 0, 1, 0, no, no, 40),
            row(11, 17, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(12, 17, array, negative, 0, 0, 1640, 0, 40, 0, 7, 0, no, no, 40),
            row(12, 17, none, programmable_positive, 1, 1, 2565, 2637, 1, 1, 0, 0, yes, yes, 0),
            row(12, 17, none, programmable_negative, 0, 1, 2565, 2637, 1, 1, 0, 0, yes, yes, 0),
            row(13, 16, array, control, 0, 0, 1920, 0, 40, 0, 1, 0, no, no, 40),
            row(13, 16, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(14, 16, array, negative, 0, 0, 1960, 0, 40, 0, 7, 0, no, no, 40),
            row(14, 16, none, programmable_positive, 1, 1, 2566, 2638, 1, 1, 0, 0, yes, yes, 0),
            row(14, 16, none, programmable_negative, 0, 1, 2566, 2638, 1, 1, 0, 0, yes, yes, 0),
            row(15, 15, array, control, 0, 0, 2240, 0, 40, 0, 1, 0, no, no, 40),
            row(15, 15, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(16, 15, array, negative, 0, 0, 2280, 0, 40, 0, 7, 0, no, no, 40),
            row(16, 15, none, programmable_positive, 1, 1, 2567, 2639, 1, 1, 0, 0, yes, yes, 0),
            row(16, 15, none, programmable_negative, 0, 1, 2567, 2639, 1, 1, 0, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2704),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
