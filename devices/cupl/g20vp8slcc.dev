            row(4, 18, array, unspecified, 0, 2707, 0, 1, 0, 1, no, no),
            row(4, 18, tec, control, 0, 0, 0, 0, 0, 0, no, no),
            row(5, 17, array, negative, 0, 640, 0, 40, 0, 8, no, no),
            row(5, 17, none, programmable_positive, 1, 2562, 2634, 1, 1, 0, yes, yes),
            row(5, 17, none, programmable_negative, 0, 2562, 2634, 1, 1, 0, yes, yes),
            row(6, 17, array, unspecified, 0, 2708, 0, 1, 0, 1, no, no),
            row(6, 17, tec, control, 0, 0, 0, 0, 0, 0, no, no),
