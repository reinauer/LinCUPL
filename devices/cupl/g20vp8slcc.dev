            row(7, 16, none, programmable_negative, 0, 2563, 2635, 1, 1, 0, yes, yes),
            row(8, 16, array, unspecified, 0, 2709, 0, 1, 0, 1, no, no),
            row(8, 16, tec, control, 0, 0, 0, 0, 0, 0, no, no),
            row(9, 13, array, negative, 0, 1280, 0, 40, 0, 8, no, no),
            row(9, 13, none, programmable_positive, 1, 2564, 2636, 1, 1, 0, yes, yes),
            row(9, 13, none, programmable_negative, 0, 2564, 2636, 1, 1, 0, yes, yes),
            row(10, 13, array, unspecified, 0, 2710, 0, 1, 0, 1, no, no),
            row(10, 13, tec, control, 0, 0, 0, 0, 0, 0, no, no),
            row(11, 12, array, negative, 0, 1600, 0, 40, 0, 8, no, no),
            row(11, 12, none, programmable_positive, 1, 2565, 2637, 1, 1, 0, yes, yes),
            row(11, 12, none, programmable_negative, 0, 2565, 2637, 1, 1, 0, yes, yes),
            row(12, 12, array, unspecified, 0, 2711, 0, 1, 0, 1, no, no),
            row(12, 12, tec, control, 0, 0, 0, 0, 0, 0, no, no),
            row(13, 11, array, negative, 0, 1920, 0, 40, 0, 8, no, no),
            row(13, 11, none, programmable_positive, 1, 2566, 2638, 1, 1, 0, yes, yes),
            row(13, 11, none, programmable_negative, 0, 2566, 2638, 1, 1, 0, yes, yes),
            row(14, 11, array, unspecified, 0, 2712, 0, 1, 0, 1, no, no),
            row(14, 11, tec, control, 0, 0, 0, 0, 0, 0, no, no),
            row(15, 10, array, negative, 0, 2240, 0, 40, 0, 8, no, no),
            row(15, 10, none, programmable_positive, 1, 2567, 2639, 1, 1, 0, yes, yes),
            row(15, 10, none, programmable_negative, 0, 2567, 2639, 1, 1, 0, yes, yes),
            row(16, 10, array, unspecified, 0, 2713, 0, 1, 0, 1, no, no),
            row(16, 10, tec, control, 0, 0, 0, 0, 0, 0, no, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2704),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(set, 1, " ", 5, 2632, 0, 0),
            row(set, 1, " ", 6, 2706, 0, 0),
            row(setup_loop, 1, " ", 1, 32, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 13),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
