# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20vp8slcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2714
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 27
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "tec"
            function = tec
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 21, unspecified, 0, 1),
            row(2, 23, unspecified, 2, 3),
            row(3, 24, unspecified, 4, 5),
            row(4, 20, unspecified, 6, 7),
            row(5, 25, unspecified, 8, 9),
            row(6, 19, feedback, 10, 11),
            row(7, 26, unspecified, 12, 13),
            row(8, 18, feedback, 14, 15),
            row(9, 27, unspecified, 16, 17),
            row(10, 17, feedback, 18, 19),
            row(11, 2, unspecified, 20, 21),
            row(12, 12, feedback, 22, 23),
            row(13, 3, unspecified, 24, 25),
            row(14, 11, feedback, 26, 27),
            row(15, 4, unspecified, 28, 29),
            row(16, 10, feedback, 30, 31),
            row(17, 5, unspecified, 32, 33),
            row(18, 9, unspecified, 34, 35),
            row(19, 6, unspecified, 36, 37),
            row(20, 7, unspecified, 38, 39),
            row(21, 14, ground, 0, 0),
            row(22, 28, supply, 0, 0),
            row(23, 1, not_connected, 0, 0),
            row(24, 8, not_connected, 0, 0),
            row(25, 15, not_connected, 0, 0),
            row(26, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, active]
        rows = [
            row(1, 19, array, negative, 0, 0, 0, 40, 0, 8, no, no),
            row(1, 19, none, programmable_positive, 1, 2560, 2632, 1, 1, 0, yes, yes),
            row(1, 19, none, programmable_negative, 0, 2560, 2632, 1, 1, 0, yes, yes),
            row(2, 19, array, unspecified, 0, 2706, 0, 1, 0, 1, no, no),
