    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2568, 2631, 0),
            row(2632, 2639, 1),
            row(2640, 2703, 1),
            row(2704, 2704, 1),
            row(2705, 2705, 0),
            row(2706, 2713, 1),
