# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f163 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 225
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 9
        initial_term_capacity = 70
        array_slots = 10
        input_line_slots = 16
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 9
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 6, unspecified, 0, 1),
            row(2, 5, unspecified, 2, 3),
            row(3, 4, unspecified, 4, 5),
            row(4, 3, unspecified, 6, 7),
            row(5, 2, unspecified, 8, 9),
            row(6, 1, unspecified, 10, 11),
            row(7, 23, unspecified, 12, 13),
            row(8, 22, unspecified, 14, 15),
            row(9, 21, unspecified, 16, 17),
            row(10, 20, unspecified, 18, 19),
            row(11, 19, unspecified, 20, 21),
            row(12, 18, unspecified, 22, 23),
            row(13, 17, output_enable, 0, 0),
            row(14, 12, ground, 0, 0),
            row(15, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, active]
        rows = [
            row(1, 16, array, programmable, 0, 0, 24, 1, no),
            row(1, 16, none, programmable_positive, 1, 216, 1, 0, yes),
            row(1, 16, none, programmable_negative, 0, 216, 1, 0, yes),
            row(2, 15, array, programmable, 0, 24, 24, 1, no),
            row(2, 15, none, programmable_positive, 1, 217, 1, 0, yes),
            row(2, 15, none, programmable_negative, 0, 217, 1, 0, yes),
            row(3, 14, array, programmable, 0, 48, 24, 1, no),
            row(3, 14, none, programmable_positive, 1, 218, 1, 0, yes),
            row(3, 14, none, programmable_negative, 0, 218, 1, 0, yes),
            row(4, 13, array, programmable, 0, 72, 24, 1, no),
            row(4, 13, none, programmable_positive, 1, 219, 1, 0, yes),
            row(4, 13, none, programmable_negative, 0, 219, 1, 0, yes),
            row(5, 11, array, programmable, 0, 96, 24, 1, no),
            row(5, 11, none, programmable_positive, 1, 220, 1, 0, yes),
            row(5, 11, none, programmable_negative, 0, 220, 1, 0, yes),
            row(6, 10, array, programmable, 0, 120, 24, 1, no),
            row(6, 10, none, programmable_positive, 1, 221, 1, 0, yes),
            row(6, 10, none, programmable_negative, 0, 221, 1, 0, yes),
            row(7, 9, array, programmable, 0, 144, 24, 1, no),
            row(7, 9, none, programmable_positive, 1, 222, 1, 0, yes),
            row(7, 9, none, programmable_negative, 0, 222, 1, 0, yes),
            row(8, 8, array, programmable, 0, 168, 24, 1, no),
            row(8, 8, none, programmable_positive, 1, 223, 1, 0, yes),
            row(8, 8, none, programmable_negative, 0, 223, 1, 0, yes),
            row(9, 7, array, programmable, 0, 192, 24, 1, no),
            row(9, 7, none, programmable_positive, 1, 224, 1, 0, yes),
            row(9, 7, none, programmable_negative, 0, 224, 1, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 8, 1, 0, 216),
            row(text, 0, "*POL", 0, 0, 0, 0),
            row(fuses_reverse, 0, "LH", 0, 0, 1, 9),
            row(newline, 0, " ", 1, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 7, 0, 0, 0),
            row(setup_loop, 1, " ", 8, 9, 1, 0),
            row(print_two_digits, 1, "*G ", 7, 1, 0, 0),
            row(text, 1, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 1, "0HL-", 1, 0, 2, 24),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 1, 24),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 3, " ", 8, 1, 1, 216),
            row(address, 3, "", 1, 0, 0, 0),
            row(text, 3, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "LH", 1, 0, 1, 9),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 0),
            row(setup_loop, 4, " ", 8, 9, 1, 0),
            row(address, 4, "", 1, 0, 0, 0),
            row(fuses_forward, 4, "0HL-", 1, 0, 2, 24),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 1, 24),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 0
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(13, 17, oe_term, 1, 1),
            row(1, 16, none, 0, 0),
            row(2, 15, none, 0, 0),
            row(3, 14, none, 0, 0),
            row(4, 13, none, 0, 0),
            row(5, 11, none, 0, 0),
            row(6, 10, none, 0, 0),
            row(7, 9, none, 0, 0),
            row(8, 8, none, 0, 0),
            row(9, 7, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
