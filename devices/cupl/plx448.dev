# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device plx448 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 8
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 14
        attribute_7 = 1
        attribute_20 = 1
    }

    fuses {
        count = 5116
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
