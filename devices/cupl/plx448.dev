    compiler {
        revision = 13
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 98
        initial_term_capacity = 120
        array_slots = 23
        input_line_slots = 33
        extra_symbols = 40
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
