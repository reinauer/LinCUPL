            row(16, 17, ar, 16, 1),
            row(15, 17, s, 16, 0),
            row(20, 16, ar, 17, 1),
            row(19, 16, s, 17, 0),
            row(24, 15, ar, 18, 1),
            row(23, 15, s, 18, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
