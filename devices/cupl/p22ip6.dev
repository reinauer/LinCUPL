# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p22ip6 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 18
        supply = 6
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 0
    }

    fuses {
        count = 3294
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = 1
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 6
        clocked_resources = 6
        default_extension = none
        product_rows = 72
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 25
        extra_symbols = 18
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = s
        next_alternate = r
        next_count = 2
        input_function = s
        input_alternate = r
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 6
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
            row("r", r),
            row("s", s),
            row("t1", t1),
            row("t2", t2),
            row("ap", ap),
            row("ar", ar),
            row("io", io),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
