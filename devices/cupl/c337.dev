# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device c337 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 8
        supply = 22
    }

    fuses {
        count = 768
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 12
        clocked_resources = 0
        default_extension = none
        product_rows = 32
        initial_term_capacity = 140
        array_slots = 1
        input_line_slots = 21
        extra_symbols = 20
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 6
        name = "cupl2cyp"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        defaults {
            name = "dq"
            function = dq
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("ap", "ap"),
            row("ar", "ar"),
            row("ck", "c"),
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type, true_column, complement_column]
        rows = [
            row(0, 0, none, not_connected, 0, 0),
            row(1, 1, dq, unspecified, 0, 1),
            row(1, 1, none, unspecified, 0, 0),
            row(2, 2, dq, unspecified, 2, 3),
            row(2, 2, none, unspecified, 0, 0),
            row(3, 3, dq, unspecified, 4, 5),
            row(3, 3, none, unspecified, 0, 0),
            row(4, 4, dq, unspecified, 6, 7),
            row(4, 4, none, unspecified, 0, 0),
            row(5, 5, dq, unspecified, 8, 9),
            row(5, 5, none, unspecified, 0, 0),
            row(6, 6, dq, unspecified, 10, 11),
            row(6, 6, none, unspecified, 0, 0),
            row(7, 9, dq, unspecified, 12, 13),
            row(7, 9, none, unspecified, 0, 0),
            row(8, 10, dq, unspecified, 14, 15),
            row(8, 10, none, unspecified, 0, 0),
            row(9, 11, dq, unspecified, 16, 17),
            row(9, 11, none, unspecified, 0, 0),
            row(10, 12, dq, unspecified, 18, 19),
            row(10, 12, none, unspecified, 0, 0),
            row(11, 13, dq, unspecified, 20, 21),
            row(11, 13, none, unspecified, 0, 0),
            row(12, 14, dq, unspecified, 22, 23),
            row(12, 14, none, unspecified, 0, 0),
            row(13, 15, none, output_enable, 0, 0),
            row(14, 28, none, clock, 0, 0),
            row(15, 8, none, ground, 0, 0),
            row(16, 20, none, ground, 0, 0),
            row(17, 21, none, ground, 0, 0),
            row(18, 23, none, ground, 0, 0),
            row(19, 7, none, supply, 0, 0),
            row(20, 22, none, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        columns = [kind, text]
        rows = [
            row(pla_file, ""),
            row(literal, "-SILENT"),
            row(literal, "-JED"),
            row(jedec_file, ""),
            row(literal, "-RPT"),
            row(file_suffix, ".LOG"),
            row(none, ""),
        ]
    }

}
