            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 3, 45),
            row(setup_loop, 5, " ", 8, 9, 3, 1440),
            row(address, 5, "", 3, 0, 0, 0),
            row(fuses_forward, 4, "0.A-", 3, 0, 1, 9),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 3, 36),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 1, ck, 0, 1, 1, no),
            row(1, 19, d, 0, 0, 0, no),
            row(1, 18, d, 0, 0, 0, no),
            row(1, 17, d, 0, 0, 0, no),
