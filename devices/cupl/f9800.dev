            row(1, 14, none, programmable_positive, 1794, 1769, 41, 2, 0, 0, 0, yes, 1, yes),
            row(1, 14, none, programmable_negative, 1793, 1769, 41, 2, 0, 0, 0, yes, 1, yes),
            row(1, 13, d, programmable_positive, 1795, 1770, 42, 2, 0, 0, 0, yes, 1, yes),
            row(1, 13, d, programmable_negative, 1793, 1770, 42, 2, 0, 0, 0, yes, 1, yes),
            row(1, 13, none, programmable_positive, 1794, 1770, 42, 2, 0, 0, 0, yes, 1, yes),
            row(1, 13, none, programmable_negative, 1793, 1770, 42, 2, 0, 0, 0, yes, 1, yes),
            row(1, 12, d, programmable_positive, 1795, 1771, 43, 2, 0, 0, 0, yes, 1, yes),
            row(1, 12, d, programmable_negative, 1793, 1771, 43, 2, 0, 0, 0, yes, 1, yes),
            row(1, 12, none, programmable_positive, 1794, 1771, 43, 2, 0, 0, 0, yes, 1, yes),
            row(1, 12, none, programmable_negative, 1793, 1771, 43, 2, 0, 0, 0, yes, 1, yes),
            row(1, 11, none, programmable_positive, 1, 1780, 44, 1, 0, 0, 0, yes, 1, yes),
            row(1, 11, none, programmable_negative, 0, 1780, 44, 1, 0, 0, 0, yes, 1, yes),
            row(1, 0, array, control, 0, 0, 0, 36, 9, 32, 0, no, 0, no),
            row(2, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(2, 0, array, control, 0, 1728, 0, 36, 0, 1, 0, no, 0, no),
            row(3, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(3, 0, array, control, 0, 1692, 0, 36, 0, 1, 0, no, 0, no),
            row(4, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(4, 0, array, control, 0, 1656, 0, 36, 0, 1, 0, no, 0, no),
            row(5, 16, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(5, 0, array, control, 0, 1620, 0, 36, 0, 1, 0, no, 0, no),
            row(6, 15, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(6, 0, array, control, 0, 1584, 0, 36, 0, 1, 0, no, 0, no),
            row(7, 14, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(7, 0, array, control, 0, 1548, 0, 36, 0, 1, 0, no, 0, no),
            row(8, 13, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(8, 0, array, control, 0, 1512, 0, 36, 0, 1, 0, no, 0, no),
            row(9, 12, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(9, 0, array, control, 0, 1476, 0, 36, 0, 1, 0, no, 0, no),
            row(10, 11, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(10, 0, array, control, 0, 1440, 0, 36, 0, 1, 0, no, 0, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 10, 1, 1, 1772),
            row(address, 1, "", 1, 0, 0, 0),
            row(text, 1, "POL ", 0, 0, 0, 0),
            row(fuses_forward, 1, "LH", 1, 0, 1, 9),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 2, " ", 10, 1, 1, 1764),
            row(address, 2, "", 1, 0, 0, 0),
            row(text, 2, "SEL ", 0, 0, 0, 0),
            row(fuses_forward, 2, "LH", 1, 0, 1, 8),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 0),
            row(setup_loop, 3, " ", 10, 1, 1, 1781),
            row(address, 3, "", 1, 0, 0, 0),
