            row(1, 18, none, programmable_positive, 1794, 1765, 37, 2, 0, 0, 0, yes, 1, yes),
            row(1, 18, none, programmable_negative, 1793, 1765, 37, 2, 0, 0, 0, yes, 1, yes),
            row(1, 17, d, programmable_positive, 1795, 1766, 38, 2, 0, 0, 0, yes, 1, yes),
            row(1, 17, d, programmable_negative, 1793, 1766, 38, 2, 0, 0, 0, yes, 1, yes),
            row(1, 17, none, programmable_positive, 1794, 1766, 38, 2, 0, 0, 0, yes, 1, yes),
            row(1, 17, none, programmable_negative, 1793, 1766, 38, 2, 0, 0, 0, yes, 1, yes),
