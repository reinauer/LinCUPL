# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f9800 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 1830
        default = 0
    }

    signature {
        bits = 41
        first_fuse = 1789
    }

    compiler {
        revision = 2
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 45
        initial_term_capacity = 120
        array_slots = 11
        input_line_slots = 21
        extra_symbols = 9
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 9
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
        ]
    }

    pin_functions {
        defaults {
            function = none
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, variant, true_column, complement_column]
        rows = [
            row(1, 1, clock_input, default, 0, 1),
            row(2, 2, unspecified, default, 2, 3),
            row(3, 3, unspecified, default, 4, 5),
            row(4, 4, unspecified, default, 6, 7),
            row(5, 5, unspecified, default, 8, 9),
            row(6, 6, unspecified, default, 10, 11),
            row(7, 7, unspecified, default, 12, 13),
            row(8, 8, unspecified, default, 14, 15),
            row(9, 9, unspecified, default, 16, 17),
            row(10, 10, ground, default, 0, 0),
            row(11, 11, feedback, default, 18, 19),
            row(12, 12, feedback, default, 20, 21),
            row(12, 12, register_feedback, d, 20, 21),
            row(13, 13, feedback, default, 22, 23),
            row(13, 13, register_feedback, d, 22, 23),
            row(14, 14, feedback, default, 24, 25),
            row(14, 14, register_feedback, d, 24, 25),
            row(15, 15, feedback, default, 26, 27),
            row(15, 15, register_feedback, d, 26, 27),
            row(16, 16, feedback, default, 28, 29),
            row(16, 16, register_feedback, d, 28, 29),
            row(17, 17, feedback, default, 30, 31),
            row(17, 17, register_feedback, d, 30, 31),
            row(18, 18, feedback, default, 32, 33),
            row(18, 18, register_feedback, d, 32, 33),
            row(19, 19, feedback, default, 34, 35),
            row(19, 19, register_feedback, d, 34, 35),
            row(20, 20, supply, default, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 19, d, programmable_positive, 1795, 1764, 36, 2, 0, 0, 0, yes, 1, yes),
            row(1, 19, d, programmable_negative, 1793, 1764, 36, 2, 0, 0, 0, yes, 1, yes),
            row(1, 19, none, programmable_positive, 1794, 1764, 36, 2, 0, 0, 0, yes, 1, yes),
