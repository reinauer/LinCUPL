            row(1, 16, none, programmable_positive, 1794, 1767, 39, 2, 0, 0, 0, yes, 1, yes),
            row(1, 16, none, programmable_negative, 1793, 1767, 39, 2, 0, 0, 0, yes, 1, yes),
            row(1, 15, d, programmable_positive, 1795, 1768, 40, 2, 0, 0, 0, yes, 1, yes),
            row(1, 15, d, programmable_negative, 1793, 1768, 40, 2, 0, 0, 0, yes, 1, yes),
            row(1, 15, none, programmable_positive, 1794, 1768, 40, 2, 0, 0, 0, yes, 1, yes),
            row(1, 15, none, programmable_negative, 1793, 1768, 40, 2, 0, 0, 0, yes, 1, yes),
            row(1, 14, d, programmable_positive, 1795, 1769, 41, 2, 0, 0, 0, yes, 1, yes),
