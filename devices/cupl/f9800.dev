            row(fuses_forward, 3, "LH", 1, 0, 1, 8),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 0),
            row(setup_loop, 4, " ", 8, 32, 3, 0),
            row(address, 4, "", 3, 0, 0, 0),
            row(fuses_forward, 4, "0HL-", 3, 0, 2, 36),
