# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16rsp4 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2176
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = 2
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 4
        clocked_resources = 4
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 21
        extra_symbols = 4
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 19, feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 18, feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 17, register_feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 16, register_feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 15, register_feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 14, register_feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 13, feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 12, feedback, 30, 31),
            row(18, 11, output_enable, 0, 0),
            row(19, 10, ground, 0, 0),
            row(20, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, sharing_mode, active, legacy_width]
        rows = [
            row(1, 19, array, control, 0, 0, 0, 32, 0, 1, 0, no, 0, no, 32),
            row(1, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(2, 18, array, control, 0, 480, 0, 32, 0, 1, 0, no, 0, no, 32),
            row(2, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(3, 0, array, negative, 0, 32, 2056, 32, 2, 14, 0, no, 0, no, 0),
            row(3, 19, none, programmable_positive, 1, 2048, 0, 1, 0, 0, 0, yes, 0, yes, 0),
            row(3, 19, none, programmable_negative, 0, 2048, 0, 1, 0, 0, 0, yes, 0, yes, 0),
            row(3, 18, none, programmable_positive, 1, 2049, 1, 1, 0, 0, 0, yes, 0, yes, 0),
            row(3, 18, none, programmable_negative, 0, 2049, 1, 1, 0, 0, 0, yes, 0, yes, 0),
            row(4, 0, array, negative, 0, 512, 2084, 32, 2, 16, 0, no, 0, no, 0),
            row(4, 17, d, programmable_positive, 1, 2050, 0, 1, 0, 0, 0, no, 0, yes, 0),
            row(4, 17, d, programmable_negative, 0, 2050, 0, 1, 0, 0, 0, no, 0, yes, 0),
            row(4, 17, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(4, 16, d, programmable_positive, 1, 2051, 1, 1, 0, 0, 0, no, 0, yes, 0),
            row(4, 16, d, programmable_negative, 0, 2051, 1, 1, 0, 0, 0, no, 0, yes, 0),
            row(4, 16, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(5, 0, array, negative, 0, 1024, 2116, 32, 2, 16, 0, no, 0, no, 0),
            row(5, 15, d, programmable_positive, 1, 2052, 0, 1, 0, 0, 0, no, 0, yes, 0),
            row(5, 15, d, programmable_negative, 0, 2052, 0, 1, 0, 0, 0, no, 0, yes, 0),
            row(5, 15, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(5, 14, d, programmable_positive, 1, 2053, 1, 1, 0, 0, 0, no, 0, yes, 0),
            row(5, 14, d, programmable_negative, 0, 2053, 1, 1, 0, 0, 0, no, 0, yes, 0),
            row(5, 14, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(6, 13, array, control, 0, 1536, 0, 32, 0, 1, 0, no, 0, no, 32),
            row(6, 13, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(7, 12, array, control, 0, 2016, 0, 32, 0, 1, 0, no, 0, no, 32),
            row(7, 12, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(8, 0, array, negative, 0, 1568, 2148, 32, 2, 14, 0, no, 0, no, 0),
            row(8, 13, none, programmable_positive, 1, 2054, 0, 1, 0, 0, 0, yes, 0, yes, 0),
            row(8, 13, none, programmable_negative, 0, 2054, 0, 1, 0, 0, 0, yes, 0, yes, 0),
            row(8, 12, none, programmable_positive, 1, 2055, 1, 1, 0, 0, 0, yes, 0, yes, 0),
            row(8, 12, none, programmable_negative, 0, 2055, 1, 1, 0, 0, 0, yes, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2048, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 5, 2056),
            row(loop, 1, " ", 7, 0, 16, 12),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(if_equal, 1, " ", 1, 1, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 9),
            row(if_equal, 1, " ", 1, 16, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 7),
            row(if_equal, 1, " ", 1, 49, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 5),
            row(if_equal, 1, " ", 1, 64, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 3),
            row(address, 1, "  ", 5, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 2),
            row(add, 1, " ", 5, 2, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(3, 19, none, 1, 0, 0, yes),
            row(1, 19, oe, 1, 1, 0, yes),
            row(3, 18, none, 2, 0, 0, yes),
            row(2, 18, oe, 2, 1, 0, yes),
            row(8, 13, none, 3, 0, 0, yes),
            row(6, 13, oe, 3, 1, 0, yes),
            row(8, 12, none, 4, 0, 0, yes),
            row(7, 12, oe, 4, 1, 0, yes),
            row(1, 1, ck, 5, 1, 1, no),
            row(4, 17, d, 5, 0, 0, no),
            row(4, 16, d, 5, 0, 0, no),
            row(5, 15, d, 5, 0, 0, no),
            row(5, 14, d, 5, 0, 0, no),
            row(18, 11, oe_term, 6, 1, 1, no),
            row(4, 17, d, 6, 0, 0, no),
            row(4, 16, d, 6, 0, 0, no),
            row(5, 15, d, 6, 0, 0, no),
            row(5, 14, d, 6, 0, 0, no),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
