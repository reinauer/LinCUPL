# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16n8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 512
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 16
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 19
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 18, feedback, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 17, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 16, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 15, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 14, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 13, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 11, unspecified, 30, 31),
            row(17, 10, ground, 0, 0),
            row(18, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, default_rule, has_default, active, legacy_width]
        rows = [
            row(1, 19, array, control, 0, 32, 1, 0, no, no, 32),
            row(1, 19, oe, control, 0, 0, 0, 2, no, no, 0),
            row(2, 19, array, negative, 32, 32, 1, 0, no, no, 32),
            row(2, 19, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(3, 18, array, control, 64, 32, 1, 0, no, no, 32),
            row(3, 18, oe, control, 0, 0, 0, 2, no, no, 0),
            row(4, 18, array, negative, 96, 32, 1, 0, no, no, 32),
            row(4, 18, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(5, 17, array, control, 128, 32, 1, 0, no, no, 32),
            row(5, 17, oe, control, 0, 0, 0, 2, no, no, 0),
            row(6, 17, array, negative, 160, 32, 1, 0, no, no, 32),
            row(6, 17, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(7, 16, array, control, 192, 32, 1, 0, no, no, 32),
            row(7, 16, oe, control, 0, 0, 0, 2, no, no, 0),
            row(8, 16, array, negative, 224, 32, 1, 0, no, no, 32),
            row(8, 16, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(9, 15, array, control, 256, 32, 1, 0, no, no, 32),
            row(9, 15, oe, control, 0, 0, 0, 2, no, no, 0),
            row(10, 15, array, negative, 288, 32, 1, 0, no, no, 32),
            row(10, 15, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(11, 14, array, control, 320, 32, 1, 0, no, no, 32),
            row(11, 14, oe, control, 0, 0, 0, 2, no, no, 0),
            row(12, 14, array, negative, 352, 32, 1, 0, no, no, 32),
            row(12, 14, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(13, 13, array, control, 384, 32, 1, 0, no, no, 32),
            row(13, 13, oe, control, 0, 0, 0, 2, no, no, 0),
            row(14, 13, array, negative, 416, 32, 1, 0, no, no, 32),
            row(14, 13, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(15, 12, array, control, 448, 32, 1, 0, no, no, 32),
            row(15, 12, oe, control, 0, 0, 0, 2, no, no, 0),
            row(16, 12, array, negative, 480, 32, 1, 0, no, no, 32),
            row(16, 12, none, negative, 0, 0, 0, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(setup_loop, 1, " ", 1, 16, 0, 0),
            row(loop, 1, " ", 7, 0, 2, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 19, none, 1, 0),
            row(1, 19, oe, 1, 1),
            row(4, 18, none, 2, 0),
            row(3, 18, oe, 2, 1),
            row(6, 17, none, 3, 0),
            row(5, 17, oe, 3, 1),
            row(8, 16, none, 4, 0),
            row(7, 16, oe, 4, 1),
            row(10, 15, none, 5, 0),
            row(9, 15, oe, 5, 1),
            row(12, 14, none, 6, 0),
            row(11, 14, oe, 6, 1),
            row(14, 13, none, 7, 0),
            row(13, 13, oe, 7, 1),
            row(16, 12, none, 8, 0),
            row(15, 12, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
