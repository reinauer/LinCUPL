# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device plsi1048c_50lq8i {
    representation = library

    package {
        pins = 128
        drawing_style = 1
        internal_nodes = 192
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 57600
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 255
        clocked_resources = 96
        default_extension = none
        product_rows = 960
        initial_term_capacity = 1000
        array_slots = 1
        input_line_slots = 256
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 96
    }

    fitter {
        input_format = 4
        name = "plsifit"
        arguments = ""
        pla_options = [tool_header, omit_device, jedec_keyword, copy_tt2, omit_pin_zero, short_labels]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("l", l),
            row("j", j),
            row("k", k),
            row("oe", oe),
            row("oemux", oemux),
            row("ck", ck),
            row("ckmux", ckmux),
            row("le", le),
            row("lemux", lemux),
            row("ar", ar),
            row("sp", sp),
            row("sr", sr),
            row("dq", dq),
            row("lq", lq),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "D"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "SP"),
            row("sr", "SR"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "SP"),
            row("iosr", "SR"),
            row("iock", "C"),
            row("int", "D"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 1, none, ground),
            row(2, 2, none, feedback),
            row(2, 2, none, register_feedback),
