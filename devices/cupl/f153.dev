# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f153 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 1842
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 11
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 42
        initial_term_capacity = 100
        array_slots = 12
        input_line_slots = 21
        extra_symbols = 10
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 2, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 6, unspecified, 10, 11),
            row(7, 7, unspecified, 12, 13),
            row(8, 8, unspecified, 14, 15),
            row(9, 9, feedback, 16, 17),
            row(10, 11, feedback, 18, 19),
            row(11, 12, feedback, 20, 21),
            row(12, 13, feedback, 22, 23),
            row(13, 14, feedback, 24, 25),
            row(14, 15, feedback, 26, 27),
            row(15, 16, feedback, 28, 29),
            row(16, 17, feedback, 30, 31),
            row(17, 18, feedback, 32, 33),
            row(18, 19, feedback, 34, 35),
            row(19, 10, ground, 0, 0),
            row(20, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 9, array, control, 0, 1472, 0, 36, 0, 1, 0, no, no),
            row(1, 9, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(2, 11, array, control, 0, 1508, 0, 36, 0, 1, 0, no, no),
            row(2, 11, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(3, 12, array, control, 0, 1544, 0, 36, 0, 1, 0, no, no),
            row(3, 12, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(4, 13, array, control, 0, 1580, 0, 36, 0, 1, 0, no, no),
            row(4, 13, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(5, 14, array, control, 0, 1616, 0, 36, 0, 1, 0, no, no),
            row(5, 14, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(6, 15, array, control, 0, 1652, 0, 36, 0, 1, 0, no, no),
            row(6, 15, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(7, 16, array, control, 0, 1688, 0, 36, 0, 1, 0, no, no),
            row(7, 16, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(8, 17, array, control, 0, 1724, 0, 36, 0, 1, 0, no, no),
            row(8, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(9, 18, array, control, 0, 1760, 0, 36, 0, 1, 0, no, no),
            row(9, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(10, 19, array, control, 0, 1796, 0, 36, 0, 1, 0, no, no),
            row(10, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(11, 19, none, programmable_positive, 0, 1832, 36, 1, 0, 0, 0, yes, yes),
            row(11, 19, none, programmable_negative, 1, 1832, 36, 1, 0, 0, 0, yes, yes),
            row(11, 18, none, programmable_positive, 0, 1833, 37, 1, 0, 0, 0, yes, yes),
            row(11, 18, none, programmable_negative, 1, 1833, 37, 1, 0, 0, 0, yes, yes),
            row(11, 17, none, programmable_positive, 0, 1834, 38, 1, 0, 0, 0, yes, yes),
            row(11, 17, none, programmable_negative, 1, 1834, 38, 1, 0, 0, 0, yes, yes),
            row(11, 16, none, programmable_positive, 0, 1835, 39, 1, 0, 0, 0, yes, yes),
            row(11, 16, none, programmable_negative, 1, 1835, 39, 1, 0, 0, 0, yes, yes),
            row(11, 15, none, programmable_positive, 0, 1836, 40, 1, 0, 0, 0, yes, yes),
            row(11, 15, none, programmable_negative, 1, 1836, 40, 1, 0, 0, 0, yes, yes),
            row(11, 14, none, programmable_positive, 0, 1837, 41, 1, 0, 0, 0, yes, yes),
            row(11, 14, none, programmable_negative, 1, 1837, 41, 1, 0, 0, 0, yes, yes),
            row(11, 13, none, programmable_positive, 0, 1838, 42, 1, 0, 0, 0, yes, yes),
            row(11, 13, none, programmable_negative, 1, 1838, 42, 1, 0, 0, 0, yes, yes),
            row(11, 12, none, programmable_positive, 0, 1839, 43, 1, 0, 0, 0, yes, yes),
            row(11, 12, none, programmable_negative, 1, 1839, 43, 1, 0, 0, 0, yes, yes),
            row(11, 11, none, programmable_positive, 0, 1840, 44, 1, 0, 0, 0, yes, yes),
            row(11, 11, none, programmable_negative, 1, 1840, 44, 1, 0, 0, 0, yes, yes),
            row(11, 9, none, programmable_positive, 0, 1841, 45, 1, 0, 0, 0, yes, yes),
            row(11, 9, none, programmable_negative, 1, 1841, 45, 1, 0, 0, 0, yes, yes),
            row(11, 0, array, programmable, 0, 0, 0, 36, 10, 32, 0, no, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 1832),
            row(text, 1, "*POL", 0, 0, 0, 0),
            row(fuses_forward, 1, "HL", 0, 0, 1, 10),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(set, 2, " ", 7, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 32, 1, 0),
            row(print_two_digits, 2, "*P  ", 7, 1, 0, 0),
            row(text, 2, "*I ", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 0, 2, 16),
            row(text, 2, "*BI", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 16, 2, 20),
            row(text, 2, "*BO", 0, 0, 0, 0),
            row(fuses_forward, 2, "A.", 1, 36, 1, 10),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 46),
            row(set, 3, " ", 9, 9, 0, 0),
            row(setup_loop, 3, " ", 10, 10, 2, 1796),
            row(text, 3, "*P ", 0, 0, 0, 0),
            row(print_decrement, 3, "D", 9, 1, 0, 0),
            row(text, 3, "*I ", 0, 0, 0, 0),
            row(fuses_reverse, 3, "0HL-", 2, 0, 2, 16),
            row(text, 3, "*BI", 0, 0, 0, 0),
            row(fuses_reverse, 3, "0HL-", 2, 16, 2, 20),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 2, 36, 0, 0),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 5, " ", 6, 1, 0, 1832),
            row(address, 5, "", 0, 0, 0, 0),
            row(text, 5, "Pol", 0, 0, 0, 0),
            row(text, 5, "        ", 0, 0, 0, 0),
            row(text, 5, "      ", 0, 0, 0, 0),
            row(fuses_forward, 5, "HL", 0, 0, 1, 10),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 0, 0),
            row(setup_loop, 6, " ", 8, 32, 1, 0),
            row(address, 6, "", 1, 0, 0, 0),
            row(fuses_forward, 6, "0HL-", 1, 0, 2, 16),
            row(fuses_forward, 6, "0HL-", 1, 16, 2, 20),
            row(fuses_forward, 6, "A.", 1, 36, 1, 10),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(end_row, 6, " ", 0, 0, 1, 46),
            row(setup_loop, 7, " ", 10, 10, 2, 1472),
            row(address, 7, "", 2, 0, 0, 0),
            row(fuses_forward, 7, "0HL-", 2, 0, 2, 16),
            row(fuses_forward, 7, "0HL-", 2, 16, 2, 20),
            row(newline, 7, " ", 1, 0, 0, 0),
            row(end_row, 7, " ", 0, 0, 2, 36),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(11, 19, none, 1, 0),
            row(10, 19, oe, 1, 1),
            row(11, 18, none, 2, 0),
            row(9, 18, oe, 2, 1),
            row(11, 17, none, 3, 0),
            row(8, 17, oe, 3, 1),
            row(11, 16, none, 4, 0),
            row(7, 16, oe, 4, 1),
            row(11, 15, none, 5, 0),
            row(6, 15, oe, 5, 1),
            row(11, 14, none, 6, 0),
            row(5, 14, oe, 6, 1),
            row(11, 13, none, 7, 0),
            row(4, 13, oe, 7, 1),
            row(11, 12, none, 8, 0),
            row(3, 12, oe, 8, 1),
            row(11, 11, none, 9, 0),
            row(2, 11, oe, 9, 1),
            row(11, 9, none, 10, 0),
            row(1, 9, oe, 10, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
