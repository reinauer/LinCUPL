# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f30s16 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 4
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 7236
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = ifl
        extra_nodes_a = 2
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 16
        clocked_resources = 12
        default_extension = none
        product_rows = 71
        initial_term_capacity = 200
        array_slots = 12
        input_line_slots = 31
        extra_symbols = 64
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = high
        preload_polarity = 0
    }

    sequence {
        next_function = s
        next_alternate = r
        next_count = 2
        input_function = s
        input_alternate = r
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 12
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("s", s),
            row("r", r),
            row("ca", ca),
            row("oe", oe),
            row("ap", ap),
            row("ar", ar),
            row("obs", obs),
            row("dq", dq),
            row("ckmux", ckmux),
        ]
    }

    pin_functions {
