# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f162 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 165
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 5
        initial_term_capacity = 70
        array_slots = 6
        input_line_slots = 20
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 5
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 8, unspecified, 0, 1),
            row(2, 7, unspecified, 2, 3),
            row(3, 6, unspecified, 4, 5),
            row(4, 5, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 3, unspecified, 10, 11),
            row(7, 2, unspecified, 12, 13),
            row(8, 1, unspecified, 14, 15),
            row(9, 23, unspecified, 16, 17),
            row(10, 22, unspecified, 18, 19),
            row(11, 21, unspecified, 20, 21),
            row(12, 20, unspecified, 22, 23),
            row(13, 19, unspecified, 24, 25),
            row(14, 18, unspecified, 26, 27),
            row(15, 17, unspecified, 28, 29),
            row(16, 16, unspecified, 30, 31),
            row(17, 15, output_enable, 0, 0),
            row(18, 12, ground, 0, 0),
            row(19, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, active, legacy_width]
        rows = [
            row(1, 14, array, programmable, 0, 0, 32, 1, no, 32),
            row(1, 14, none, programmable_positive, 1, 160, 1, 0, yes, 0),
            row(1, 14, none, programmable_negative, 0, 160, 1, 0, yes, 0),
            row(2, 13, array, programmable, 0, 32, 32, 1, no, 32),
            row(2, 13, none, programmable_positive, 1, 161, 1, 0, yes, 0),
            row(2, 13, none, programmable_negative, 0, 161, 1, 0, yes, 0),
            row(3, 11, array, programmable, 0, 64, 32, 1, no, 32),
            row(3, 11, none, programmable_positive, 1, 162, 1, 0, yes, 0),
            row(3, 11, none, programmable_negative, 0, 162, 1, 0, yes, 0),
            row(4, 10, array, programmable, 0, 96, 32, 1, no, 32),
            row(4, 10, none, programmable_positive, 1, 163, 1, 0, yes, 0),
            row(4, 10, none, programmable_negative, 0, 163, 1, 0, yes, 0),
            row(5, 9, array, programmable, 0, 128, 32, 1, no, 32),
            row(5, 9, none, programmable_positive, 1, 164, 1, 0, yes, 0),
            row(5, 9, none, programmable_negative, 0, 164, 1, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 8, 1, 0, 160),
            row(text, 0, "*POL", 0, 0, 0, 0),
            row(fuses_reverse, 0, "LH", 0, 0, 1, 5),
            row(newline, 0, " ", 1, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 7, 0, 0, 0),
            row(setup_loop, 1, " ", 8, 5, 1, 0),
            row(print_two_digits, 1, "*G ", 7, 1, 0, 0),
            row(text, 1, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 1, "0HL-", 1, 0, 2, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 1, 32),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 3, " ", 8, 1, 1, 160),
            row(address, 3, "", 1, 0, 0, 0),
            row(text, 3, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "LH", 1, 0, 1, 5),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 0),
            row(setup_loop, 4, " ", 8, 5, 1, 0),
            row(address, 4, "", 1, 0, 0, 0),
            row(fuses_forward, 4, "0HL-", 1, 0, 2, 32),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 1, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 0
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(17, 15, oe_term, 1, 1),
            row(1, 14, none, 0, 0),
            row(2, 13, none, 0, 0),
            row(3, 11, none, 0, 0),
            row(4, 10, none, 0, 0),
            row(5, 9, none, 0, 0),
            row(0, 0, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
