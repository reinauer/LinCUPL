# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f173 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2178
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 42
        initial_term_capacity = 100
        array_slots = 12
        input_line_slots = 25
        extra_symbols = 10
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 2, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 6, unspecified, 10, 11),
            row(7, 7, unspecified, 12, 13),
            row(8, 8, unspecified, 14, 15),
            row(9, 9, unspecified, 16, 17),
            row(10, 10, unspecified, 18, 19),
            row(11, 11, unspecified, 20, 21),
            row(12, 13, unspecified, 22, 23),
            row(13, 14, feedback, 24, 25),
            row(14, 15, feedback, 26, 27),
            row(15, 16, feedback, 28, 29),
            row(16, 17, feedback, 30, 31),
            row(17, 18, feedback, 32, 33),
            row(18, 19, feedback, 34, 35),
            row(19, 20, feedback, 36, 37),
            row(20, 21, feedback, 38, 39),
            row(21, 22, feedback, 40, 41),
            row(22, 23, feedback, 42, 43),
            row(23, 12, ground, 0, 0),
            row(24, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 14, array, control, 0, 1728, 0, 44, 0, 1, 0, no, no),
            row(1, 14, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(2, 15, array, control, 0, 1772, 0, 44, 0, 1, 0, no, no),
            row(2, 15, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(3, 16, array, control, 0, 1816, 0, 44, 0, 1, 0, no, no),
            row(3, 16, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(4, 17, array, control, 0, 1860, 0, 44, 0, 1, 0, no, no),
            row(4, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(5, 18, array, control, 0, 1904, 0, 44, 0, 1, 0, no, no),
            row(5, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(6, 19, array, control, 0, 1948, 0, 44, 0, 1, 0, no, no),
            row(6, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(7, 20, array, control, 0, 1992, 0, 44, 0, 1, 0, no, no),
            row(7, 20, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(8, 21, array, control, 0, 2036, 0, 44, 0, 1, 0, no, no),
            row(8, 21, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(9, 22, array, control, 0, 2080, 0, 44, 0, 1, 0, no, no),
            row(9, 22, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(10, 23, array, control, 0, 2124, 0, 44, 0, 1, 0, no, no),
            row(10, 23, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(11, 23, none, programmable_positive, 0, 2168, 44, 1, 0, 0, 0, yes, yes),
            row(11, 23, none, programmable_negative, 1, 2168, 44, 1, 0, 0, 0, yes, yes),
            row(11, 22, none, programmable_positive, 0, 2169, 45, 1, 0, 0, 0, yes, yes),
            row(11, 22, none, programmable_negative, 1, 2169, 45, 1, 0, 0, 0, yes, yes),
            row(11, 21, none, programmable_positive, 0, 2170, 46, 1, 0, 0, 0, yes, yes),
            row(11, 21, none, programmable_negative, 1, 2170, 46, 1, 0, 0, 0, yes, yes),
            row(11, 20, none, programmable_positive, 0, 2171, 47, 1, 0, 0, 0, yes, yes),
            row(11, 20, none, programmable_negative, 1, 2171, 47, 1, 0, 0, 0, yes, yes),
            row(11, 19, none, programmable_positive, 0, 2172, 48, 1, 0, 0, 0, yes, yes),
            row(11, 19, none, programmable_negative, 1, 2172, 48, 1, 0, 0, 0, yes, yes),
            row(11, 18, none, programmable_positive, 0, 2173, 49, 1, 0, 0, 0, yes, yes),
            row(11, 18, none, programmable_negative, 1, 2173, 49, 1, 0, 0, 0, yes, yes),
            row(11, 17, none, programmable_positive, 0, 2174, 50, 1, 0, 0, 0, yes, yes),
            row(11, 17, none, programmable_negative, 1, 2174, 50, 1, 0, 0, 0, yes, yes),
            row(11, 16, none, programmable_positive, 0, 2175, 51, 1, 0, 0, 0, yes, yes),
            row(11, 16, none, programmable_negative, 1, 2175, 51, 1, 0, 0, 0, yes, yes),
            row(11, 15, none, programmable_positive, 0, 2176, 52, 1, 0, 0, 0, yes, yes),
            row(11, 15, none, programmable_negative, 1, 2176, 52, 1, 0, 0, 0, yes, yes),
            row(11, 14, none, programmable_positive, 0, 2177, 53, 1, 0, 0, 0, yes, yes),
            row(11, 14, none, programmable_negative, 1, 2177, 53, 1, 0, 0, 0, yes, yes),
            row(11, 0, array, programmable, 0, 0, 0, 44, 10, 32, 0, no, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 2168),
            row(text, 1, "*POL", 0, 0, 0, 0),
            row(fuses_forward, 1, "HL", 0, 0, 1, 10),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(set, 2, " ", 7, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 32, 1, 0),
            row(print_two_digits, 2, "*P  ", 7, 1, 0, 0),
            row(text, 2, "*I ", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 0, 2, 24),
            row(text, 2, "*BI", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 24, 2, 20),
            row(text, 2, "*BO", 0, 0, 0, 0),
            row(fuses_forward, 2, "A.", 1, 44, 1, 10),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 54),
            row(set, 3, " ", 9, 9, 0, 0),
            row(setup_loop, 3, " ", 10, 10, 2, 2124),
            row(text, 3, "*P ", 0, 0, 0, 0),
            row(print_decrement, 3, "D", 9, 1, 0, 0),
            row(text, 3, "*I ", 0, 0, 0, 0),
            row(fuses_reverse, 3, "0HL-", 2, 0, 2, 24),
            row(text, 3, "*BI", 0, 0, 0, 0),
            row(fuses_reverse, 3, "0HL-", 2, 24, 2, 20),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 2, 44, 0, 0),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 5, " ", 6, 1, 0, 2168),
            row(address, 5, "", 0, 0, 0, 0),
            row(text, 5, "Pol", 0, 0, 0, 0),
            row(text, 5, "        ", 0, 0, 0, 0),
            row(text, 5, "        ", 0, 0, 0, 0),
            row(text, 5, " ", 0, 0, 0, 0),
            row(fuses_forward, 5, "HL", 0, 0, 1, 10),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 0, 0),
            row(setup_loop, 6, " ", 8, 32, 1, 0),
            row(address, 6, "", 1, 0, 0, 0),
            row(fuses_forward, 6, "0HL-", 1, 0, 2, 24),
            row(fuses_forward, 6, "0HL-", 1, 24, 2, 20),
            row(fuses_forward, 6, "A.", 1, 44, 1, 10),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(end_row, 6, " ", 0, 0, 1, 54),
            row(setup_loop, 7, " ", 10, 10, 2, 1728),
            row(address, 7, "", 2, 0, 0, 0),
            row(fuses_forward, 7, "0HL-", 2, 0, 2, 24),
            row(fuses_forward, 7, "0HL-", 2, 24, 2, 20),
            row(newline, 7, " ", 1, 0, 0, 0),
            row(end_row, 7, " ", 0, 0, 2, 44),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(11, 23, none, 1, 0),
            row(10, 23, oe, 1, 1),
            row(11, 22, none, 2, 0),
            row(9, 22, oe, 2, 1),
            row(11, 21, none, 3, 0),
            row(8, 21, oe, 3, 1),
            row(11, 20, none, 4, 0),
            row(7, 20, oe, 4, 1),
            row(11, 19, none, 5, 0),
            row(6, 19, oe, 5, 1),
            row(11, 18, none, 6, 0),
            row(5, 18, oe, 6, 1),
            row(11, 17, none, 7, 0),
            row(4, 17, oe, 7, 1),
            row(11, 16, none, 8, 0),
            row(3, 16, oe, 8, 1),
            row(11, 15, none, 9, 0),
            row(2, 15, oe, 9, 1),
            row(11, 14, none, 10, 0),
            row(1, 14, oe, 10, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
