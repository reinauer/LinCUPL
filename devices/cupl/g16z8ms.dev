            row(12, 19, array, negative, 0, 0, 768, 0, 32, 0, 8, 0, no, 0, no, 32),
            row(12, 19, d, programmable_positive, 1, 0, 2051, 2123, 1, 1, 0, 0, no, 1, yes, 0),
