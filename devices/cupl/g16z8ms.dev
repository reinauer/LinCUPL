# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g16z8ms {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2195
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2056
    }

    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 25
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 3, unspecified, 0, 1),
            row(3, 22, feedback, 2, 3),
            row(4, 4, unspecified, 4, 5),
            row(5, 21, feedback, 6, 7),
            row(6, 5, unspecified, 8, 9),
            row(7, 20, feedback, 10, 11),
            row(8, 6, unspecified, 12, 13),
            row(9, 19, feedback, 14, 15),
            row(10, 7, unspecified, 16, 17),
            row(11, 18, feedback, 18, 19),
            row(12, 8, unspecified, 20, 21),
            row(13, 17, feedback, 22, 23),
            row(14, 9, unspecified, 24, 25),
            row(15, 16, feedback, 26, 27),
            row(16, 10, unspecified, 28, 29),
