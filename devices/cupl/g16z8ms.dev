            row(18, 17, d, programmable_positive, 1, 0, 2053, 2125, 1, 1, 0, 0, no, 1, yes, 0),
            row(18, 17, d, programmable_negative, 0, 0, 2053, 2125, 1, 1, 0, 0, no, 1, yes, 0),
            row(19, 16, array, control, 0, 0, 1536, 0, 32, 0, 1, 0, no, 0, no, 32),
            row(19, 16, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(20, 16, array, negative, 0, 0, 1568, 0, 32, 0, 7, 0, no, 0, no, 32),
            row(20, 16, none, programmable_positive, 1, 1, 2054, 2126, 1, 1, 0, 0, yes, 1, yes, 0),
            row(20, 16, none, programmable_negative, 0, 1, 2054, 2126, 1, 1, 0, 0, yes, 1, yes, 0),
