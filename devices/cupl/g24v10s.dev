    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(3862, 3941, 0),
            row(3850, 3859, 1),
            row(3860, 3860, 1),
            row(3860, 3860, 1),
            row(3861, 3861, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
