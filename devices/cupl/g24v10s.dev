            row(6, 20, array, negative, 0, 1920, 0, 48, 0, 8, no, no),
            row(6, 20, none, programmable_positive, 1, 3845, 3855, 1, 1, 0, yes, yes),
            row(6, 20, none, programmable_negative, 0, 3845, 3855, 1, 1, 0, yes, yes),
            row(7, 19, array, negative, 0, 2304, 0, 48, 0, 8, no, no),
            row(7, 19, none, programmable_positive, 1, 3846, 3856, 1, 1, 0, yes, yes),
            row(7, 19, none, programmable_negative, 0, 3846, 3856, 1, 1, 0, yes, yes),
            row(8, 18, array, negative, 0, 2688, 0, 48, 0, 8, no, no),
            row(8, 18, none, programmable_positive, 1, 3847, 3857, 1, 1, 0, yes, yes),
            row(8, 18, none, programmable_negative, 0, 3847, 3857, 1, 1, 0, yes, yes),
            row(9, 17, array, negative, 0, 3072, 0, 48, 0, 8, no, no),
            row(9, 17, none, programmable_positive, 1, 3848, 3858, 1, 1, 0, yes, yes),
            row(9, 17, none, programmable_negative, 0, 3848, 3858, 1, 1, 0, yes, yes),
            row(10, 16, array, negative, 0, 3456, 0, 48, 0, 8, no, no),
            row(10, 16, none, programmable_positive, 1, 3849, 3859, 1, 1, 0, yes, yes),
            row(10, 16, none, programmable_negative, 0, 3849, 3859, 1, 1, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 3860),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
