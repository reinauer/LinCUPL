# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g24v10s {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 21
        supply = 7
    }

    fuses {
        count = 3942
        default = 0
    }

    signature {
        bits = 80
        first_fuse = 3862
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 11
        input_line_slots = 27
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
        }
        columns = [line, pin, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, unspecified, 10, 11, 0, 0, 0),
            row(2, 2, unspecified, 0, 1, 0, 0, 0),
            row(3, 28, unspecified, 2, 3, 0, 0, 0),
            row(4, 3, unspecified, 4, 5, 0, 0, 0),
            row(5, 27, unspecified, 6, 7, 0, 0, 0),
            row(6, 4, unspecified, 8, 9, 0, 0, 0),
            row(7, 5, unspecified, 12, 13, 0, 0, 0),
            row(8, 25, unspecified, 14, 15, 1, 1, 3841),
            row(9, 6, unspecified, 16, 17, 0, 0, 0),
            row(10, 24, unspecified, 18, 19, 1, 1, 3842),
            row(11, 8, unspecified, 20, 21, 0, 0, 0),
            row(12, 23, unspecified, 22, 23, 1, 1, 3843),
            row(13, 9, unspecified, 24, 25, 0, 0, 0),
            row(14, 22, unspecified, 26, 27, 1, 1, 3844),
            row(15, 10, unspecified, 28, 29, 0, 0, 0),
            row(16, 20, unspecified, 30, 31, 1, 1, 3845),
            row(17, 11, unspecified, 32, 33, 0, 0, 0),
            row(18, 19, unspecified, 34, 35, 1, 1, 3846),
            row(19, 12, unspecified, 36, 37, 0, 0, 0),
            row(20, 18, unspecified, 38, 39, 1, 1, 3847),
            row(21, 13, unspecified, 40, 41, 0, 0, 0),
            row(22, 17, unspecified, 42, 43, 1, 1, 3848),
            row(23, 14, unspecified, 44, 45, 0, 0, 0),
            row(24, 15, unspecified, 46, 47, 0, 0, 0),
            row(25, 7, supply, 0, 0, 0, 0, 0),
            row(26, 21, ground, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, active]
        rows = [
            row(1, 26, array, negative, 0, 0, 0, 48, 0, 8, no, no),
            row(1, 26, none, programmable_positive, 1, 3840, 3850, 1, 1, 0, yes, yes),
