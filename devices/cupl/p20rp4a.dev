# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20rp4a {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 3450
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 4
        clocked_resources = 4
        default_extension = none
        product_rows = 86
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 25
        extra_symbols = 6
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("io", io),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 23, feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 22, feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 21, feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 20, register_feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 19, register_feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 18, register_feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 17, register_feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 16, feedback, 30, 31),
            row(18, 10, unspecified, 32, 33),
            row(19, 15, feedback, 34, 35),
            row(20, 11, unspecified, 36, 37),
            row(21, 14, feedback, 38, 39),
            row(22, 12, ground, 0, 0),
            row(23, 24, supply, 0, 0),
            row(24, 13, output_enable, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 23, array, control, 0, 0, 40, 1, 0, no, 0, no),
            row(1, 23, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(2, 23, array, negative, 0, 40, 40, 8, 0, no, 0, no),
            row(2, 23, none, programmable_positive, 1, 3440, 1, 0, 0, yes, 0, yes),
            row(2, 23, none, programmable_negative, 0, 3440, 1, 0, 0, yes, 0, yes),
            row(3, 22, array, control, 0, 360, 40, 1, 0, no, 0, no),
            row(3, 22, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(4, 22, array, negative, 0, 400, 40, 8, 0, no, 0, no),
            row(4, 22, none, programmable_positive, 1, 3441, 1, 0, 0, yes, 0, yes),
            row(4, 22, none, programmable_negative, 0, 3441, 1, 0, 0, yes, 0, yes),
            row(5, 21, array, control, 0, 720, 40, 1, 0, no, 0, no),
            row(5, 21, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(6, 21, array, negative, 0, 760, 40, 8, 0, no, 0, no),
            row(6, 21, none, programmable_positive, 1, 3442, 1, 0, 0, yes, 0, yes),
            row(6, 21, none, programmable_negative, 0, 3442, 1, 0, 0, yes, 0, yes),
            row(7, 20, array, negative, 0, 1080, 40, 8, 0, no, 0, no),
            row(7, 20, d, programmable_positive, 1, 3443, 1, 0, 0, no, 0, yes),
            row(7, 20, d, programmable_negative, 0, 3443, 1, 0, 0, no, 0, yes),
            row(7, 20, none, unspecified, 0, 0, 0, 0, 0, no, 2, no),
            row(8, 19, array, negative, 0, 1400, 40, 8, 0, no, 0, no),
            row(8, 19, d, programmable_positive, 1, 3444, 1, 0, 0, no, 0, yes),
            row(8, 19, d, programmable_negative, 0, 3444, 1, 0, 0, no, 0, yes),
            row(8, 19, none, unspecified, 0, 0, 0, 0, 0, no, 2, no),
            row(9, 18, array, negative, 0, 1720, 40, 8, 0, no, 0, no),
            row(9, 18, d, programmable_positive, 1, 3445, 1, 0, 0, no, 0, yes),
            row(9, 18, d, programmable_negative, 0, 3445, 1, 0, 0, no, 0, yes),
            row(9, 18, none, unspecified, 0, 0, 0, 0, 0, no, 2, no),
            row(10, 17, array, negative, 0, 2040, 40, 8, 0, no, 0, no),
            row(10, 17, d, programmable_positive, 1, 3446, 1, 0, 0, no, 0, yes),
            row(10, 17, d, programmable_negative, 0, 3446, 1, 0, 0, no, 0, yes),
            row(10, 17, none, unspecified, 0, 0, 0, 0, 0, no, 2, no),
            row(11, 16, array, control, 0, 2360, 40, 1, 0, no, 0, no),
            row(11, 16, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(12, 16, array, negative, 0, 2400, 40, 8, 0, no, 0, no),
            row(12, 16, none, programmable_positive, 1, 3447, 1, 0, 0, yes, 0, yes),
            row(12, 16, none, programmable_negative, 0, 3447, 1, 0, 0, yes, 0, yes),
            row(13, 15, array, control, 0, 2720, 40, 1, 0, no, 0, no),
            row(13, 15, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(14, 15, array, negative, 0, 2760, 40, 8, 0, no, 0, no),
            row(14, 15, none, programmable_positive, 1, 3448, 1, 0, 0, yes, 0, yes),
            row(14, 15, none, programmable_negative, 0, 3448, 1, 0, 0, yes, 0, yes),
            row(15, 14, array, control, 0, 3080, 40, 1, 0, no, 0, no),
            row(15, 14, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(16, 14, array, negative, 0, 3120, 40, 8, 0, no, 0, no),
            row(16, 14, none, programmable_positive, 1, 3449, 1, 0, 0, yes, 0, yes),
            row(16, 14, none, programmable_negative, 0, 3449, 1, 0, 0, yes, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 23, 0, 0),
            row(set, 1, " ", 6, 0, 0, 0),
            row(setup_loop, 1, " ", 1, 27, 4, 3440),
            row(loop, 1, " ", 7, 0, 9, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, "    ", 4, 0, 0, 0),
            row(text, 1, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(add, 1, " ", 4, 1, 0, 0),
            row(address, 1, " ", 6, 0, 0, 0),
            row(fuses_forward, 1, "x-", 6, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 6, 40),
            row(set, 2, " ", 2, 20, 0, 0),
            row(setup_loop, 2, " ", 1, 32, 0, 0),
            row(loop, 2, " ", 7, 0, 8, 6),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, "    ", 4, 0, 0, 0),
            row(text, 2, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(add, 2, " ", 4, 1, 0, 0),
            row(address, 2, " ", 6, 0, 0, 0),
            row(fuses_forward, 2, "x-", 6, 0, 1, 40),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 6, 40),
            row(set, 3, " ", 2, 16, 0, 0),
            row(setup_loop, 3, " ", 1, 27, 0, 0),
            row(loop, 3, " ", 7, 0, 9, 6),
            row(print_decrement, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, "    ", 4, 0, 0, 0),
            row(text, 3, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(add, 3, " ", 4, 1, 0, 0),
            row(address, 3, " ", 6, 0, 0, 0),
            row(fuses_forward, 3, "x-", 6, 0, 1, 40),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 6, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 23, oe, 0, 1, 0, yes),
            row(2, 23, none, 0, 0, 0, yes),
            row(3, 22, oe, 1, 1, 0, yes),
            row(4, 22, none, 1, 0, 0, yes),
            row(5, 21, oe, 2, 1, 0, yes),
            row(6, 21, none, 2, 0, 0, yes),
            row(11, 16, oe, 3, 1, 0, yes),
            row(12, 16, none, 3, 0, 0, yes),
            row(13, 15, oe, 4, 1, 0, yes),
            row(14, 15, none, 4, 0, 0, yes),
            row(15, 14, oe, 5, 1, 0, yes),
            row(16, 14, none, 5, 0, 0, yes),
            row(1, 1, ck, 6, 1, 1, no),
            row(7, 20, d, 6, 0, 0, no),
            row(8, 19, d, 6, 0, 0, no),
            row(9, 18, d, 6, 0, 0, no),
            row(10, 17, d, 6, 0, 0, no),
            row(24, 13, oe_term, 7, 1, 1, no),
            row(7, 20, d, 7, 0, 0, no),
            row(8, 19, d, 7, 0, 0, no),
            row(9, 18, d, 7, 0, 0, no),
            row(10, 17, d, 7, 0, 0, no),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
