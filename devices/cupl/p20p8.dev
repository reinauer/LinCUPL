# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20p8 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 2568
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 23
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 23, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 21, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 20, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 19, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 18, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 17, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 16, feedback, 30, 31),
            row(17, 10, unspecified, 32, 33),
            row(18, 14, unspecified, 34, 35),
            row(19, 11, unspecified, 36, 37),
            row(20, 13, unspecified, 38, 39),
            row(21, 12, ground, 0, 0),
            row(22, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 22, array, control, 0, 0, 40, 1, 0, no, no),
            row(1, 22, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 22, array, negative, 0, 40, 40, 7, 0, no, no),
            row(2, 22, none, programmable_positive, 1, 2560, 1, 0, 0, yes, yes),
            row(2, 22, none, programmable_negative, 0, 2560, 1, 0, 0, yes, yes),
            row(3, 21, array, control, 0, 320, 40, 1, 0, no, no),
            row(3, 21, oe, control, 0, 0, 0, 0, 2, no, no),
            row(4, 21, array, negative, 0, 360, 40, 7, 0, no, no),
            row(4, 21, none, programmable_positive, 1, 2561, 1, 0, 0, yes, yes),
            row(4, 21, none, programmable_negative, 0, 2561, 1, 0, 0, yes, yes),
            row(5, 20, array, control, 0, 640, 40, 1, 0, no, no),
            row(5, 20, oe, control, 0, 0, 0, 0, 2, no, no),
            row(6, 20, array, negative, 0, 680, 40, 7, 0, no, no),
            row(6, 20, none, programmable_positive, 1, 2562, 1, 0, 0, yes, yes),
            row(6, 20, none, programmable_negative, 0, 2562, 1, 0, 0, yes, yes),
            row(7, 19, array, control, 0, 960, 40, 1, 0, no, no),
            row(7, 19, oe, control, 0, 0, 0, 0, 2, no, no),
            row(8, 19, array, negative, 0, 1000, 40, 7, 0, no, no),
            row(8, 19, none, programmable_positive, 1, 2563, 1, 0, 0, yes, yes),
            row(8, 19, none, programmable_negative, 0, 2563, 1, 0, 0, yes, yes),
            row(9, 18, array, control, 0, 1280, 40, 1, 0, no, no),
            row(9, 18, oe, control, 0, 0, 0, 0, 2, no, no),
            row(10, 18, array, negative, 0, 1320, 40, 7, 0, no, no),
            row(10, 18, none, programmable_positive, 1, 2564, 1, 0, 0, yes, yes),
            row(10, 18, none, programmable_negative, 0, 2564, 1, 0, 0, yes, yes),
            row(11, 17, array, control, 0, 1600, 40, 1, 0, no, no),
            row(11, 17, oe, control, 0, 0, 0, 0, 2, no, no),
            row(12, 17, array, negative, 0, 1640, 40, 7, 0, no, no),
            row(12, 17, none, programmable_positive, 1, 2565, 1, 0, 0, yes, yes),
            row(12, 17, none, programmable_negative, 0, 2565, 1, 0, 0, yes, yes),
            row(13, 16, array, control, 0, 1920, 40, 1, 0, no, no),
            row(13, 16, oe, control, 0, 0, 0, 0, 2, no, no),
            row(14, 16, array, negative, 0, 1960, 40, 7, 0, no, no),
            row(14, 16, none, programmable_positive, 1, 2566, 1, 0, 0, yes, yes),
            row(14, 16, none, programmable_negative, 0, 2566, 1, 0, 0, yes, yes),
            row(15, 15, array, control, 0, 2240, 40, 1, 0, no, no),
            row(15, 15, oe, control, 0, 0, 0, 0, 2, no, no),
            row(16, 15, array, negative, 0, 2280, 40, 7, 0, no, no),
            row(16, 15, none, programmable_positive, 1, 2567, 1, 0, 0, yes, yes),
            row(16, 15, none, programmable_negative, 0, 2567, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 22, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 4, 2560),
            row(loop, 1, " ", 7, 0, 8, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(add, 1, " ", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 22, none, 1, 0),
            row(1, 22, oe, 1, 1),
            row(4, 21, none, 2, 0),
            row(3, 21, oe, 2, 1),
            row(6, 20, none, 3, 0),
            row(5, 20, oe, 3, 1),
            row(8, 19, none, 4, 0),
            row(7, 19, oe, 4, 1),
            row(10, 18, none, 5, 0),
            row(9, 18, oe, 5, 1),
            row(12, 17, none, 6, 0),
            row(11, 17, oe, 6, 1),
            row(14, 16, none, 7, 0),
            row(13, 16, oe, 7, 1),
            row(16, 15, none, 8, 0),
            row(15, 15, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
