# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p23s8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 6
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 6234
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 6
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 14
        clocked_resources = 14
        default_extension = none
        product_rows = 135
        initial_term_capacity = 140
        array_slots = 26
        input_line_slots = 27
        extra_symbols = 36
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("ar", ar),
            row("sp", sp),
            row("obs", obs),
            row("io", io),
            row("dfb", dfb),
        ]
    }

    pin_functions {
