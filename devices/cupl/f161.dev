# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f161 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 1544
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 14
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 48
        initial_term_capacity = 70
        array_slots = 2
        input_line_slots = 16
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 7, unspecified, 0, 1),
            row(2, 6, unspecified, 2, 3),
            row(3, 5, unspecified, 4, 5),
            row(4, 4, unspecified, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 2, unspecified, 10, 11),
            row(7, 23, unspecified, 12, 13),
            row(8, 22, unspecified, 14, 15),
            row(9, 21, unspecified, 16, 17),
            row(10, 20, unspecified, 18, 19),
            row(11, 19, unspecified, 20, 21),
            row(12, 18, unspecified, 22, 23),
            row(13, 17, output_enable, 0, 0),
            row(14, 12, ground, 0, 0),
            row(15, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            array = 1
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, active]
        rows = [
            row(16, none, programmable_positive, 0, 1536, 24, 1, 0, 0, yes),
            row(16, none, programmable_negative, 1, 1536, 24, 1, 0, 0, yes),
            row(15, none, programmable_positive, 0, 1537, 25, 1, 0, 0, yes),
            row(15, none, programmable_negative, 1, 1537, 25, 1, 0, 0, yes),
            row(14, none, programmable_positive, 0, 1538, 26, 1, 0, 0, yes),
            row(14, none, programmable_negative, 1, 1538, 26, 1, 0, 0, yes),
            row(13, none, programmable_positive, 0, 1539, 27, 1, 0, 0, yes),
            row(13, none, programmable_negative, 1, 1539, 27, 1, 0, 0, yes),
            row(11, none, programmable_positive, 0, 1540, 28, 1, 0, 0, yes),
            row(11, none, programmable_negative, 1, 1540, 28, 1, 0, 0, yes),
            row(10, none, programmable_positive, 0, 1541, 29, 1, 0, 0, yes),
            row(10, none, programmable_negative, 1, 1541, 29, 1, 0, 0, yes),
            row(9, none, programmable_positive, 0, 1542, 30, 1, 0, 0, yes),
            row(9, none, programmable_negative, 1, 1542, 30, 1, 0, 0, yes),
            row(8, none, programmable_positive, 0, 1543, 31, 1, 0, 0, yes),
            row(8, none, programmable_negative, 1, 1543, 31, 1, 0, 0, yes),
            row(0, array, programmable, 0, 0, 0, 24, 8, 48, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 1536),
            row(text, 1, "*A", 0, 0, 0, 0),
            row(fuses_reverse, 1, "HL", 0, 0, 1, 8),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 48, 1, 0),
            row(print_two_digits, 2, "*P ", 7, 1, 0, 0),
            row(text, 2, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 0, 2, 24),
            row(text, 2, "*F", 0, 0, 0, 0),
            row(fuses_reverse, 2, "A.", 1, 24, 1, 8),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 32),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 4, " ", 0, 0, 0, 0),
            row(setup_loop, 4, " ", 6, 1, 0, 1536),
            row(address, 4, "", 0, 0, 0, 0),
            row(text, 4, "Pol", 0, 0, 0, 0),
            row(text, 4, "        ", 0, 0, 0, 0),
            row(fuses_forward, 4, "HL", 0, 0, 1, 8),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 0),
            row(setup_loop, 5, " ", 8, 48, 1, 0),
            row(address, 5, "", 1, 0, 0, 0),
            row(fuses_forward, 5, "0HL-", 1, 0, 2, 24),
            row(fuses_forward, 5, "A.", 1, 24, 1, 8),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 1, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 0
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(13, 17, oe_term, 1, 1),
            row(1, 16, none, 0, 0),
            row(1, 15, none, 0, 0),
            row(1, 14, none, 0, 0),
            row(1, 13, none, 0, 0),
            row(1, 11, none, 0, 0),
            row(1, 10, none, 0, 0),
            row(1, 9, none, 0, 0),
            row(1, 8, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
