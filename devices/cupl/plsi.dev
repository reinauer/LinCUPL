# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device plsi {
    representation = library

    package {
        pins = 255
        drawing_style = 1
        internal_nodes = 255
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 99999
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 255
        clocked_resources = 128
        default_extension = none
        product_rows = 5000
        initial_term_capacity = 1200
        array_slots = 1
        input_line_slots = 256
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 255
    }

    fitter {
        input_format = 4
        name = "plsifit"
        arguments = ""
        pla_options = [tool_header, omit_device, jedec_keyword, copy_tt2, omit_pin_zero, short_labels]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("l", l),
            row("j", j),
            row("k", k),
            row("oe", oe),
            row("oemux", oemux),
            row("ck", ck),
            row("ckmux", ckmux),
            row("le", le),
            row("lemux", lemux),
            row("ar", ar),
            row("sp", sp),
            row("sr", sr),
            row("dq", dq),
            row("lq", lq),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "D"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "SP"),
            row("sr", "SR"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "SP"),
            row("iosr", "SR"),
            row("iock", "C"),
            row("int", "D"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            line = 0
            pin = 0
            function = none
            compiler_type = not_connected
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    node_functions {
        defaults {
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        columns = [kind, text]
        rows = [
            row(file_suffix, ".tt2"),
            row(part_name, ""),
            row(none, ""),
        ]
    }

}
