            row(19, 10, none, ground, default, 0, 0, 0, 0, 0),
            row(20, 20, none, supply, default, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
