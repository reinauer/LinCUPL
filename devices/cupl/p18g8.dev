        columns = [array, pin, function, polarity, invert, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active, legacy_width]
        rows = [
            row(0, 19, array, unspecified, no, 0, 0, 36, 1, 0, no, 0, no, 36),
            row(0, 19, oe, control, no, 1, 2594, 1, 0, 2, no, 0, no, 1),
            row(1, 19, array, unspecified, no, 0, 36, 36, 8, 0, no, 0, no, 36),
