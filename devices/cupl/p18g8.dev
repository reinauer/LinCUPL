# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p18g8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 1
        attribute_20 = 1
    }

    fuses {
        count = 2624
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 72
        initial_term_capacity = 120
        array_slots = 24
        input_line_slots = 21
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("io", io),
            row("dfb", dfb),
            row("oemux", oemux),
        ]
    }

    pin_functions {
        columns = [line, pin, function, compiler_type, variant, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, none, clock_input, default, 0, 1, 0, 0, 0),
            row(2, 19, none, feedback, default, 2, 3, 1, 1, 2595),
            row(2, 19, none, register_feedback, d, 2, 3, 0, 0, 0),
            row(2, 19, io, feedback, default, 2, 3, 1, 1, 2595),
            row(2, 19, dfb, register_feedback, default, 3, 2, 0, 0, 0),
            row(3, 2, none, unspecified, default, 4, 5, 0, 0, 0),
            row(4, 18, none, feedback, default, 6, 7, 1, 1, 2599),
            row(4, 18, none, register_feedback, d, 6, 7, 0, 0, 0),
            row(4, 18, io, feedback, default, 6, 7, 1, 1, 2599),
            row(4, 18, dfb, register_feedback, default, 7, 6, 0, 0, 0),
            row(5, 3, none, unspecified, default, 8, 9, 0, 0, 0),
            row(6, 17, none, feedback, default, 10, 11, 1, 1, 2603),
            row(6, 17, none, register_feedback, d, 10, 11, 0, 0, 0),
            row(6, 17, io, feedback, default, 10, 11, 1, 1, 2603),
            row(6, 17, dfb, register_feedback, default, 11, 10, 0, 0, 0),
            row(7, 4, none, unspecified, default, 12, 13, 0, 0, 0),
            row(8, 16, none, feedback, default, 14, 15, 1, 1, 2607),
            row(8, 16, none, register_feedback, d, 14, 15, 0, 0, 0),
            row(8, 16, io, feedback, default, 14, 15, 1, 1, 2607),
            row(8, 16, dfb, register_feedback, default, 15, 14, 0, 0, 0),
            row(9, 5, none, unspecified, default, 16, 17, 0, 0, 0),
            row(10, 15, none, feedback, default, 18, 19, 1, 1, 2611),
            row(10, 15, none, register_feedback, d, 18, 19, 0, 0, 0),
            row(10, 15, io, feedback, default, 18, 19, 1, 1, 2611),
            row(10, 15, dfb, register_feedback, default, 19, 18, 0, 0, 0),
