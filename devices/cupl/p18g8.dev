            row(9, 15, array, unspecified, no, 0, 1332, 36, 8, 0, no, 0, no, 36),
            row(9, 15, none, programmable_negative, no, 2, 2608, 2, 0, 0, yes, 1, yes, 2),
            row(9, 15, none, programmable_positive, no, 3, 2608, 2, 0, 0, yes, 1, yes, 2),
            row(9, 15, d, programmable_negative, no, 0, 2608, 2, 0, 0, yes, 1, yes, 2),
            row(9, 15, d, programmable_positive, yes, 1, 2608, 2, 0, 0, yes, 1, yes, 2),
            row(10, 14, array, unspecified, no, 0, 1620, 36, 1, 0, no, 0, no, 36),
            row(10, 14, oe, control, no, 1, 2614, 1, 0, 2, no, 0, no, 1),
            row(11, 14, array, unspecified, no, 0, 1656, 36, 8, 0, no, 0, no, 36),
