            row(3, 18, none, programmable_positive, no, 3, 2596, 2, 0, 0, yes, 1, yes, 2),
            row(3, 18, d, programmable_negative, no, 0, 2596, 2, 0, 0, yes, 1, yes, 2),
            row(3, 18, d, programmable_positive, yes, 1, 2596, 2, 0, 0, yes, 1, yes, 2),
            row(4, 17, array, unspecified, no, 0, 648, 36, 1, 0, no, 0, no, 36),
            row(4, 17, oe, control, no, 1, 2602, 1, 0, 2, no, 0, no, 1),
            row(5, 17, array, unspecified, no, 0, 684, 36, 8, 0, no, 0, no, 36),
            row(5, 17, none, programmable_negative, no, 2, 2600, 2, 0, 0, yes, 1, yes, 2),
            row(5, 17, none, programmable_positive, no, 3, 2600, 2, 0, 0, yes, 1, yes, 2),
            row(5, 17, d, programmable_negative, no, 0, 2600, 2, 0, 0, yes, 1, yes, 2),
            row(5, 17, d, programmable_positive, yes, 1, 2600, 2, 0, 0, yes, 1, yes, 2),
            row(6, 16, array, unspecified, no, 0, 972, 36, 1, 0, no, 0, no, 36),
            row(6, 16, oe, control, no, 1, 2606, 1, 0, 2, no, 0, no, 1),
            row(7, 16, array, unspecified, no, 0, 1008, 36, 8, 0, no, 0, no, 36),
