# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16p8v {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2072
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 19
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 18, feedback, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 17, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 16, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 15, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 14, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 13, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 11, unspecified, 30, 31),
            row(17, 10, ground, 0, 0),
            row(18, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 19, array, control, 0, 0, 32, 1, 0, no, no),
            row(1, 19, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 19, array, negative, 0, 32, 32, 7, 0, no, no),
            row(2, 19, none, programmable_positive, 1, 2050, 1, 0, 0, yes, yes),
            row(2, 19, none, programmable_negative, 0, 2050, 1, 0, 0, yes, yes),
            row(3, 18, array, control, 0, 256, 32, 1, 0, no, no),
            row(3, 18, oe, control, 0, 0, 0, 0, 2, no, no),
            row(4, 18, array, negative, 0, 288, 32, 7, 0, no, no),
            row(4, 18, none, programmable_positive, 1, 2053, 1, 0, 0, yes, yes),
            row(4, 18, none, programmable_negative, 0, 2053, 1, 0, 0, yes, yes),
            row(5, 17, array, control, 0, 512, 32, 1, 0, no, no),
            row(5, 17, oe, control, 0, 0, 0, 0, 2, no, no),
            row(6, 17, array, negative, 0, 544, 32, 7, 0, no, no),
            row(6, 17, none, programmable_positive, 1, 2056, 1, 0, 0, yes, yes),
            row(6, 17, none, programmable_negative, 0, 2056, 1, 0, 0, yes, yes),
            row(7, 16, array, control, 0, 768, 32, 1, 0, no, no),
            row(7, 16, oe, control, 0, 0, 0, 0, 2, no, no),
            row(8, 16, array, negative, 0, 800, 32, 7, 0, no, no),
            row(8, 16, none, programmable_positive, 1, 2059, 1, 0, 0, yes, yes),
            row(8, 16, none, programmable_negative, 0, 2059, 1, 0, 0, yes, yes),
            row(9, 15, array, control, 0, 1024, 32, 1, 0, no, no),
            row(9, 15, oe, control, 0, 0, 0, 0, 2, no, no),
            row(10, 15, array, negative, 0, 1056, 32, 7, 0, no, no),
            row(10, 15, none, programmable_positive, 1, 2062, 1, 0, 0, yes, yes),
            row(10, 15, none, programmable_negative, 0, 2062, 1, 0, 0, yes, yes),
            row(11, 14, array, control, 0, 1280, 32, 1, 0, no, no),
            row(11, 14, oe, control, 0, 0, 0, 0, 2, no, no),
            row(12, 14, array, negative, 0, 1312, 32, 7, 0, no, no),
            row(12, 14, none, programmable_positive, 1, 2065, 1, 0, 0, yes, yes),
            row(12, 14, none, programmable_negative, 0, 2065, 1, 0, 0, yes, yes),
            row(13, 13, array, control, 0, 1536, 32, 1, 0, no, no),
            row(13, 13, oe, control, 0, 0, 0, 0, 2, no, no),
            row(14, 13, array, negative, 0, 1568, 32, 7, 0, no, no),
            row(14, 13, none, programmable_positive, 1, 2068, 1, 0, 0, yes, yes),
            row(14, 13, none, programmable_negative, 0, 2068, 1, 0, 0, yes, yes),
            row(15, 12, array, control, 0, 1792, 32, 1, 0, no, no),
            row(15, 12, oe, control, 0, 0, 0, 0, 2, no, no),
            row(16, 12, array, negative, 0, 1824, 32, 7, 0, no, no),
            row(16, 12, none, programmable_positive, 1, 2071, 1, 0, 0, yes, yes),
            row(16, 12, none, programmable_negative, 0, 2071, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 4, 2048),
            row(loop, 1, " ", 7, 0, 8, 9),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Mode", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 2),
            row(add, 1, "", 4, 2, 0, 0),
            row(text, 1, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        defaults {
            value = 0
        }
        columns = [first_fuse, last_fuse]
        rows = [
            row(2048, 2048),
            row(2049, 2049),
            row(2051, 2051),
            row(2052, 2052),
            row(2054, 2054),
            row(2055, 2055),
            row(2057, 2057),
            row(2058, 2058),
            row(2060, 2060),
            row(2061, 2061),
            row(2063, 2063),
            row(2064, 2064),
            row(2066, 2066),
            row(2067, 2067),
            row(2069, 2069),
            row(2070, 2070),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 19, none, 1, 0),
            row(1, 19, oe, 1, 1),
            row(4, 18, none, 2, 0),
            row(3, 18, oe, 2, 1),
            row(6, 17, none, 3, 0),
            row(5, 17, oe, 3, 1),
            row(8, 16, none, 4, 0),
            row(7, 16, oe, 4, 1),
            row(10, 15, none, 5, 0),
            row(9, 15, oe, 5, 1),
            row(12, 14, none, 6, 0),
            row(11, 14, oe, 6, 1),
            row(14, 13, none, 7, 0),
            row(13, 13, oe, 7, 1),
            row(16, 12, none, 8, 0),
            row(15, 12, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
