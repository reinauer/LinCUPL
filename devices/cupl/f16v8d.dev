            row(7, 17, oe, 5, 1, 0, yes),
            row(11, 16, none, 6, 0, 0, yes),
            row(10, 16, oe, 6, 1, 0, yes),
            row(14, 15, none, 7, 0, 0, yes),
            row(13, 15, oe, 7, 1, 0, yes),
            row(17, 14, none, 8, 0, 0, yes),
            row(16, 14, oe, 8, 1, 0, yes),
            row(20, 13, none, 9, 0, 0, yes),
            row(19, 13, oe, 9, 1, 0, yes),
            row(23, 12, none, 10, 0, 0, yes),
            row(22, 12, oe, 10, 1, 0, yes),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
