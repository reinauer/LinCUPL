# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f16v8d {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2617
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 72
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 23
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            function = none
        }
        columns = [line, pin, compiler_type, variant, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, clock, default, 0, 0, 0, 0, 0),
            row(2, 2, unspecified, default, 0, 1, 0, 0, 0),
            row(3, 3, unspecified, default, 4, 5, 0, 0, 0),
            row(4, 4, unspecified, default, 8, 9, 0, 0, 0),
            row(5, 5, unspecified, default, 12, 13, 0, 0, 0),
            row(6, 6, unspecified, default, 16, 17, 0, 0, 0),
            row(7, 7, unspecified, default, 20, 21, 0, 0, 0),
            row(8, 8, unspecified, default, 24, 25, 0, 0, 0),
            row(9, 9, unspecified, default, 28, 29, 0, 0, 0),
            row(10, 11, output_enable, default, 0, 0, 0, 0, 0),
            row(11, 10, ground, default, 0, 0, 0, 0, 0),
            row(12, 20, supply, default, 0, 0, 0, 0, 0),
            row(13, 19, feedback, default, 2, 3, 1, 1, 2601),
            row(13, 19, register_feedback, d, 2, 3, 0, 0, 0),
            row(14, 18, feedback, default, 6, 7, 1, 1, 2603),
            row(14, 18, register_feedback, d, 6, 7, 0, 0, 0),
            row(15, 17, feedback, default, 10, 11, 1, 1, 2605),
            row(15, 17, register_feedback, d, 10, 11, 0, 0, 0),
            row(16, 16, feedback, default, 14, 15, 1, 1, 2607),
            row(16, 16, register_feedback, d, 14, 15, 0, 0, 0),
            row(17, 15, feedback, default, 18, 19, 1, 1, 2609),
            row(17, 15, register_feedback, d, 18, 19, 0, 0, 0),
            row(18, 14, feedback, default, 22, 23, 1, 1, 2611),
            row(18, 14, register_feedback, d, 22, 23, 0, 0, 0),
            row(19, 13, feedback, default, 26, 27, 1, 1, 2613),
            row(19, 13, register_feedback, d, 26, 27, 0, 0, 0),
            row(20, 12, feedback, default, 30, 31, 1, 1, 2615),
            row(20, 12, register_feedback, d, 30, 31, 0, 0, 0),
            row(21, 0, unspecified, default, 32, 33, 0, 0, 0),
            row(22, 0, unspecified, default, 34, 35, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, invert, select_value, config_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 19, array, control, no, 0, 0, 0, 0, 36, 0, 1, 0, no, 0, no),
            row(1, 19, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(2, 19, array, unspecified, no, 0, 0, 36, 0, 36, 0, 8, 0, no, 0, no),
            row(2, 19, none, programmable_positive, no, 1, 0, 2592, 2600, 1, 2, 0, 0, yes, 1, yes),
            row(2, 19, none, programmable_negative, no, 0, 0, 2592, 2600, 1, 2, 0, 0, yes, 1, yes),
            row(3, 19, array, unspecified, no, 0, 0, 36, 0, 36, 0, 8, 0, no, 0, no),
            row(3, 19, d, programmable_positive, yes, 1, 3, 2592, 2600, 1, 2, 0, 0, no, 1, yes),
            row(3, 19, d, programmable_negative, yes, 0, 3, 2592, 2600, 1, 2, 0, 0, no, 1, yes),
            row(4, 18, array, control, no, 0, 0, 324, 0, 36, 0, 1, 0, no, 0, no),
            row(4, 18, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(5, 18, array, unspecified, no, 0, 0, 360, 0, 36, 0, 8, 0, no, 0, no),
            row(5, 18, none, programmable_positive, no, 1, 0, 2593, 2602, 1, 2, 0, 0, yes, 1, yes),
            row(5, 18, none, programmable_negative, no, 0, 0, 2593, 2602, 1, 2, 0, 0, yes, 1, yes),
            row(6, 18, array, unspecified, no, 0, 0, 360, 0, 36, 0, 8, 0, no, 0, no),
            row(6, 18, d, programmable_positive, yes, 1, 3, 2593, 2602, 1, 2, 0, 0, no, 1, yes),
            row(6, 18, d, programmable_negative, yes, 0, 3, 2593, 2602, 1, 2, 0, 0, no, 1, yes),
            row(7, 17, array, control, no, 0, 0, 648, 0, 36, 0, 1, 0, no, 0, no),
            row(7, 17, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(8, 17, array, unspecified, no, 0, 0, 684, 0, 36, 0, 8, 0, no, 0, no),
            row(8, 17, none, programmable_positive, no, 1, 0, 2594, 2604, 1, 2, 0, 0, yes, 1, yes),
            row(8, 17, none, programmable_negative, no, 0, 0, 2594, 2604, 1, 2, 0, 0, yes, 1, yes),
            row(9, 17, array, unspecified, no, 0, 0, 684, 0, 36, 0, 8, 0, no, 0, no),
            row(9, 17, d, programmable_positive, yes, 1, 3, 2594, 2604, 1, 2, 0, 0, no, 1, yes),
            row(9, 17, d, programmable_negative, yes, 0, 3, 2594, 2604, 1, 2, 0, 0, no, 1, yes),
            row(10, 16, array, control, no, 0, 0, 972, 0, 36, 0, 1, 0, no, 0, no),
            row(10, 16, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(11, 16, array, unspecified, no, 0, 0, 1008, 0, 36, 0, 8, 0, no, 0, no),
            row(11, 16, none, programmable_positive, no, 1, 0, 2595, 2606, 1, 2, 0, 0, yes, 1, yes),
            row(11, 16, none, programmable_negative, no, 0, 0, 2595, 2606, 1, 2, 0, 0, yes, 1, yes),
            row(12, 16, array, unspecified, no, 0, 0, 1008, 0, 36, 0, 8, 0, no, 0, no),
            row(12, 16, d, programmable_positive, yes, 1, 3, 2595, 2606, 1, 2, 0, 0, no, 1, yes),
            row(12, 16, d, programmable_negative, yes, 0, 3, 2595, 2606, 1, 2, 0, 0, no, 1, yes),
            row(13, 15, array, control, no, 0, 0, 1296, 0, 36, 0, 1, 0, no, 0, no),
            row(13, 15, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(14, 15, array, unspecified, no, 0, 0, 1332, 0, 36, 0, 8, 0, no, 0, no),
            row(14, 15, none, programmable_positive, no, 1, 0, 2596, 2608, 1, 2, 0, 0, yes, 1, yes),
            row(14, 15, none, programmable_negative, no, 0, 0, 2596, 2608, 1, 2, 0, 0, yes, 1, yes),
            row(15, 15, array, unspecified, no, 0, 0, 1332, 0, 36, 0, 8, 0, no, 0, no),
            row(15, 15, d, programmable_positive, yes, 1, 3, 2596, 2608, 1, 2, 0, 0, no, 1, yes),
            row(15, 15, d, programmable_negative, yes, 0, 3, 2596, 2608, 1, 2, 0, 0, no, 1, yes),
            row(16, 14, array, control, no, 0, 0, 1620, 0, 36, 0, 1, 0, no, 0, no),
            row(16, 14, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(17, 14, array, unspecified, no, 0, 0, 1656, 0, 36, 0, 8, 0, no, 0, no),
            row(17, 14, none, programmable_positive, no, 1, 0, 2597, 2610, 1, 2, 0, 0, yes, 1, yes),
            row(17, 14, none, programmable_negative, no, 0, 0, 2597, 2610, 1, 2, 0, 0, yes, 1, yes),
            row(18, 14, array, unspecified, no, 0, 0, 1656, 0, 36, 0, 8, 0, no, 0, no),
            row(18, 14, d, programmable_positive, yes, 1, 3, 2597, 2610, 1, 2, 0, 0, no, 1, yes),
            row(18, 14, d, programmable_negative, yes, 0, 3, 2597, 2610, 1, 2, 0, 0, no, 1, yes),
            row(19, 13, array, control, no, 0, 0, 1944, 0, 36, 0, 1, 0, no, 0, no),
            row(19, 13, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(20, 13, array, unspecified, no, 0, 0, 1980, 0, 36, 0, 8, 0, no, 0, no),
            row(20, 13, none, programmable_positive, no, 1, 0, 2598, 2612, 1, 2, 0, 0, yes, 1, yes),
            row(20, 13, none, programmable_negative, no, 0, 0, 2598, 2612, 1, 2, 0, 0, yes, 1, yes),
            row(21, 13, array, unspecified, no, 0, 0, 1980, 0, 36, 0, 8, 0, no, 0, no),
            row(21, 13, d, programmable_positive, yes, 1, 3, 2598, 2612, 1, 2, 0, 0, no, 1, yes),
            row(21, 13, d, programmable_negative, yes, 0, 3, 2598, 2612, 1, 2, 0, 0, no, 1, yes),
            row(22, 12, array, control, no, 0, 0, 2268, 0, 36, 0, 1, 0, no, 0, no),
            row(22, 12, oe, control, no, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(23, 12, array, unspecified, no, 0, 0, 2304, 0, 36, 0, 8, 0, no, 0, no),
            row(23, 12, none, programmable_positive, no, 1, 0, 2599, 2614, 1, 2, 0, 0, yes, 1, yes),
            row(23, 12, none, programmable_negative, no, 0, 0, 2599, 2614, 1, 2, 0, 0, yes, 1, yes),
            row(24, 12, array, unspecified, no, 0, 0, 2304, 0, 36, 0, 8, 0, no, 0, no),
            row(24, 12, d, programmable_positive, yes, 1, 3, 2599, 2614, 1, 2, 0, 0, no, 1, yes),
            row(24, 12, d, programmable_negative, yes, 0, 3, 2599, 2614, 1, 2, 0, 0, no, 1, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2616),
            row(text, 0, "Config ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2592, 0, 0),
            row(set, 1, " ", 5, 2600, 0, 0),
            row(setup_loop, 1, " ", 1, 72, 0, 0),
            row(loop, 1, " ", 8, 0, 9, 13),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(add, 1, " ", 5, 1, 0, 0),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 36),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 36),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        defaults {
            first_fuse = 2616
            last_fuse = 2616
            value = 1
        }
        columns = []
        rows = [
            row(),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 1, ck, 1, 1, 1, no),
            row(3, 19, d, 1, 0, 0, no),
            row(6, 18, d, 1, 0, 0, no),
            row(9, 17, d, 1, 0, 0, no),
            row(12, 16, d, 1, 0, 0, no),
            row(15, 15, d, 1, 0, 0, no),
            row(18, 14, d, 1, 0, 0, no),
            row(21, 13, d, 1, 0, 0, no),
            row(24, 12, d, 1, 0, 0, no),
            row(10, 11, oe_term, 2, 1, 1, no),
            row(3, 19, d, 2, 0, 0, no),
            row(6, 18, d, 2, 0, 0, no),
            row(9, 17, d, 2, 0, 0, no),
            row(12, 16, d, 2, 0, 0, no),
            row(15, 15, d, 2, 0, 0, no),
            row(18, 14, d, 2, 0, 0, no),
            row(21, 13, d, 2, 0, 0, no),
            row(24, 12, d, 2, 0, 0, no),
            row(2, 19, none, 3, 0, 0, yes),
            row(1, 19, oe, 3, 1, 0, yes),
            row(5, 18, none, 4, 0, 0, yes),
