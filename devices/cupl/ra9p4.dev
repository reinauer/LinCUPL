# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ra9p4 {
    representation = library

    package {
        pins = 16
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 8
        supply = 16
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 0
    }

    fuses {
        count = 2048
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 4
        family = prom
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 512
        initial_term_capacity = 70
        array_slots = 2
        input_line_slots = 13
        extra_symbols = 0
        download = ascii_hex
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 9
        data_width = 4
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 131072
        }
        columns = [line, pin, compiler_type, true_column]
        rows = [
            row(1, 1, unspecified, 6),
            row(2, 2, unspecified, 5),
            row(3, 3, unspecified, 4),
            row(4, 4, unspecified, 3),
            row(5, 5, unspecified, 0),
            row(6, 6, unspecified, 1),
            row(7, 7, unspecified, 2),
            row(8, 8, ground, 0),
            row(9, 13, output_enable, 0),
            row(10, 14, unspecified, 8),
            row(11, 15, unspecified, 7),
            row(12, 16, supply, 0),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            array = 1
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 131072
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [pin, function, polarity, first_or_fuse, or_width, max_terms, active]
        rows = [
            row(12, none, programmable_negative, 0, 0, 0, yes),
            row(12, none, programmable_positive, 0, 0, 0, yes),
            row(11, none, programmable_negative, 1, 0, 0, yes),
            row(11, none, programmable_positive, 1, 0, 0, yes),
            row(10, none, programmable_negative, 2, 0, 0, yes),
            row(10, none, programmable_positive, 2, 0, 0, yes),
            row(9, none, programmable_negative, 3, 0, 0, yes),
            row(9, none, programmable_positive, 3, 0, 0, yes),
            row(0, array, positive, 0, 4, 512, no),
        ]
    }

    plot {
        defaults {
            group = 0
            text = ""
            a = 0
            b = 0
            c = 0
            d = 0
        }
        columns = [operation]
        rows = [
            row(begin_fuses),
            row(prom),
            row(end),
        ]
    }

    connections {
        defaults {
            group = 1
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(9, 13, oe, 1, 1),
            row(1, 12, none, 0, 0),
            row(1, 11, none, 0, 0),
            row(1, 10, none, 0, 0),
            row(1, 9, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
