# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f506lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 16
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 10680
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 6
        family = ifl
        extra_nodes_a = 2
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 24
        clocked_resources = 24
        default_extension = none
        product_rows = 98
        initial_term_capacity = 100
        array_slots = 5
        input_line_slots = 39
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("s", s),
            row("r", r),
            row("ca", ca),
            row("oe", oe),
            row("oemux", oemux),
            row("ckmux", ckmux),
