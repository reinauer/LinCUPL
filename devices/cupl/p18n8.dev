# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p18n8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 304
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 8
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 21
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "int"
            function = int
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            variant = default
        }
        columns = [line, pin, function, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, none, unspecified, 2, 3, 0, 0, 0),
            row(2, 2, none, unspecified, 0, 1, 0, 0, 0),
            row(3, 3, none, unspecified, 4, 5, 0, 0, 0),
            row(4, 19, none, feedback, 6, 7, 0, 1, 288),
            row(4, 19, int, register_feedback, 7, 6, 1, 1, 288),
            row(5, 4, none, unspecified, 8, 9, 0, 0, 0),
            row(6, 18, none, feedback, 10, 11, 0, 1, 289),
            row(6, 18, int, register_feedback, 11, 10, 1, 1, 289),
            row(7, 5, none, unspecified, 12, 13, 0, 0, 0),
            row(8, 17, none, feedback, 14, 15, 0, 1, 290),
            row(8, 17, int, register_feedback, 15, 14, 1, 1, 290),
            row(9, 6, none, unspecified, 16, 17, 0, 0, 0),
            row(10, 16, none, feedback, 18, 19, 0, 1, 291),
            row(10, 16, int, register_feedback, 19, 18, 1, 1, 291),
            row(11, 7, none, unspecified, 20, 21, 0, 0, 0),
            row(12, 15, none, feedback, 22, 23, 0, 1, 292),
            row(12, 15, int, register_feedback, 23, 22, 1, 1, 292),
            row(13, 8, none, unspecified, 24, 25, 0, 0, 0),
            row(14, 14, none, feedback, 26, 27, 0, 1, 293),
            row(14, 14, int, register_feedback, 27, 26, 1, 1, 293),
            row(15, 9, none, unspecified, 28, 29, 0, 0, 0),
            row(16, 13, none, feedback, 30, 31, 0, 1, 294),
            row(16, 13, int, register_feedback, 31, 30, 1, 1, 294),
            row(17, 11, none, unspecified, 32, 33, 0, 0, 0),
            row(18, 12, none, feedback, 34, 35, 0, 1, 295),
            row(18, 12, int, register_feedback, 35, 34, 1, 1, 295),
            row(19, 10, none, ground, 0, 0, 0, 0, 0),
            row(20, 20, none, supply, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            polarity = negative
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, select_value, first_row_fuse, row_width, max_terms, has_default, active]
        rows = [
            row(1, 19, array, 0, 0, 36, 1, no, no),
            row(1, 19, none, 1, 296, 1, 0, yes, yes),
            row(2, 18, array, 0, 36, 36, 1, no, no),
            row(2, 18, none, 1, 297, 1, 0, yes, yes),
            row(3, 17, array, 0, 72, 36, 1, no, no),
            row(3, 17, none, 1, 298, 1, 0, yes, yes),
            row(4, 16, array, 0, 108, 36, 1, no, no),
            row(4, 16, none, 1, 299, 1, 0, yes, yes),
            row(5, 15, array, 0, 144, 36, 1, no, no),
            row(5, 15, none, 1, 300, 1, 0, yes, yes),
            row(6, 14, array, 0, 180, 36, 1, no, no),
            row(6, 14, none, 1, 301, 1, 0, yes, yes),
            row(7, 13, array, 0, 216, 36, 1, no, no),
            row(7, 13, none, 1, 302, 1, 0, yes, yes),
            row(8, 12, array, 0, 252, 36, 1, no, no),
            row(8, 12, none, 1, 303, 1, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 3, 288, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 4, 296),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, "   ", 3, 0, 0, 0),
            row(text, 1, "FB", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 3, 0, 1, 1),
            row(address, 1, "   ", 4, 0, 0, 0),
            row(text, 1, "OE", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 36),
            row(newline, 1, " ", 2, 0, 0, 0),
            row(add, 1, " ", 3, 1, 4, 1),
            row(end_row, 1, " ", 0, 0, 0, 36),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
