    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 132
        initial_term_capacity = 120
        array_slots = 23
        input_line_slots = 29
        extra_symbols = 30
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
