# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p22v10tlcc {
    representation = library

    package {
        pins = 28
        drawing_style = 1
        internal_nodes = 0
    }

    power {
        ground = 6
        supply = 8
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 5828
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
