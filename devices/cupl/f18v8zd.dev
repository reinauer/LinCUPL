            row(7, 7, unspecified, default, 20, 21, 0, 0),
            row(8, 8, unspecified, default, 24, 25, 0, 0),
            row(9, 9, unspecified, default, 28, 29, 0, 0),
            row(10, 11, output_enable, default, 0, 0, 0, 0),
            row(11, 10, ground, default, 0, 0, 0, 0),
            row(12, 20, supply, default, 0, 0, 0, 0),
            row(13, 19, feedback, default, 2, 3, 1, 2600),
            row(13, 19, register_feedback, d, 2, 3, 0, 0),
            row(14, 18, feedback, default, 6, 7, 1, 2602),
