# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p1016c4 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2056
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 32
        initial_term_capacity = 40
        array_slots = 5
        input_line_slots = 21
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 27, unspecified, 2, 3),
            row(3, 2, unspecified, 4, 5),
            row(4, 26, unspecified, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 20, unspecified, 10, 11),
            row(7, 4, unspecified, 12, 13),
            row(8, 19, unspecified, 14, 15),
            row(9, 10, unspecified, 16, 17),
            row(10, 18, unspecified, 18, 19),
            row(11, 11, unspecified, 20, 21),
            row(12, 17, unspecified, 22, 23),
            row(13, 12, unspecified, 24, 25),
            row(14, 16, unspecified, 26, 27),
            row(15, 13, unspecified, 28, 29),
            row(16, 15, unspecified, 30, 31),
            row(17, 14, negative_supply, 0, 0),
            row(18, 7, supply, 0, 0),
            row(19, 23, supply, 0, 0),
            row(20, 28, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, has_default, active]
        rows = [
            row(1, 0, array, negative, 512, 32, 8, no, no),
            row(1, 24, none, positive, 0, 0, 0, yes, yes),
            row(1, 25, none, negative, 0, 0, 0, yes, yes),
            row(2, 0, array, negative, 768, 32, 8, no, no),
            row(2, 6, none, positive, 0, 0, 0, yes, yes),
            row(2, 5, none, negative, 0, 0, 0, yes, yes),
            row(3, 0, array, negative, 1024, 32, 8, no, no),
            row(3, 22, none, positive, 0, 0, 0, yes, yes),
            row(3, 21, none, negative, 0, 0, 0, yes, yes),
            row(4, 0, array, negative, 1280, 32, 8, no, no),
            row(4, 8, none, positive, 0, 0, 0, yes, yes),
            row(4, 9, none, negative, 0, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, "", 0, 512, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 2, 25),
            row(if_equal, 1, " ", 1, 8, 0, 3),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(print_decrement, 1, "and ", 2, 1, 0, 0),
            row(newline, 1, "", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(set, 2, "", 4, 2051, 0, 0),
            row(setup_loop, 2, " ", 1, 8, 2, 5),
            row(if_equal, 2, " ", 1, 8, 0, 3),
            row(print_increment, 2, "Pin #", 2, 1, 0, 0),
            row(print_increment, 2, "and ", 2, 1, 0, 0),
            row(newline, 2, "", 1, 0, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 32),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 32),
            row(set, 3, "", 4, 2052, 0, 0),
            row(setup_loop, 3, " ", 1, 8, 2, 22),
            row(if_equal, 3, " ", 1, 8, 0, 3),
            row(print_decrement, 3, "Pin #", 2, 1, 0, 0),
            row(print_decrement, 3, "and ", 2, 1, 0, 0),
            row(newline, 3, "", 1, 0, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 32),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 32),
            row(set, 4, "", 4, 2053, 0, 0),
            row(setup_loop, 4, " ", 1, 8, 2, 8),
            row(if_equal, 4, " ", 1, 8, 0, 3),
            row(print_increment, 4, "Pin #", 2, 1, 0, 0),
            row(print_increment, 4, "and ", 2, 1, 0, 0),
            row(newline, 4, "", 1, 0, 0, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 32),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
