# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p19r6rlcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2443
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 6
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 17
        clocked_resources = 6
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 11
        input_line_slots = 29
        extra_symbols = 2
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("dq", dq),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            variant = default
        }
        columns = [line, pin, function, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 2, none, clock, 0, 0, 0, 0, 0),
            row(2, 3, none, unspecified, 0, 1, 1, 1, 2433),
            row(2, 3, dq, unspecified, 0, 1, 0, 1, 2433),
            row(3, 27, none, unspecified, 2, 3, 1, 1, 2432),
            row(3, 27, dq, unspecified, 2, 3, 0, 1, 2432),
            row(4, 4, none, unspecified, 4, 5, 1, 1, 2434),
            row(4, 4, dq, unspecified, 4, 5, 0, 1, 2434),
            row(5, 26, none, feedback, 6, 7, 0, 0, 0),
            row(6, 5, none, unspecified, 8, 9, 1, 1, 2435),
            row(6, 5, dq, unspecified, 8, 9, 0, 1, 2435),
            row(7, 25, none, register_feedback, 10, 11, 0, 0, 0),
            row(8, 6, dq, unspecified, 12, 13, 0, 1, 2436),
            row(8, 6, none, unspecified, 12, 13, 1, 1, 2436),
            row(9, 24, none, register_feedback, 14, 15, 0, 0, 0),
            row(10, 7, none, unspecified, 16, 17, 1, 1, 2437),
            row(10, 7, dq, unspecified, 16, 17, 0, 1, 2437),
            row(11, 23, none, register_feedback, 18, 19, 0, 0, 0),
            row(12, 9, dq, unspecified, 20, 21, 0, 1, 2438),
            row(12, 9, none, unspecified, 20, 21, 1, 1, 2438),
            row(13, 21, none, register_feedback, 22, 23, 0, 0, 0),
            row(14, 10, dq, unspecified, 24, 25, 0, 1, 2439),
            row(14, 10, none, unspecified, 24, 25, 1, 1, 2439),
            row(15, 20, none, register_feedback, 26, 27, 0, 0, 0),
            row(16, 11, dq, unspecified, 28, 29, 0, 1, 2440),
            row(16, 11, none, unspecified, 28, 29, 1, 1, 2440),
            row(17, 19, none, register_feedback, 30, 31, 0, 0, 0),
            row(18, 12, dq, unspecified, 32, 33, 0, 1, 2441),
            row(18, 12, none, unspecified, 32, 33, 1, 1, 2441),
            row(19, 18, none, feedback, 34, 35, 0, 0, 0),
            row(20, 13, dq, unspecified, 36, 37, 0, 1, 2442),
            row(20, 13, none, unspecified, 36, 37, 1, 1, 2442),
            row(21, 17, none, clock, 0, 0, 0, 0, 0),
            row(22, 16, none, output_enable, 0, 0, 0, 0, 0),
            row(23, 14, none, ground, 0, 0, 0, 0, 0),
            row(24, 28, none, supply, 0, 0, 0, 0, 0),
            row(25, 1, none, not_connected, 0, 0, 0, 0, 0),
            row(26, 8, none, not_connected, 0, 0, 0, 0, 0),
            row(27, 15, none, not_connected, 0, 0, 0, 0, 0),
            row(28, 22, none, not_connected, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 26, array, control, 0, 38, 1, 0, no, 0, no),
            row(1, 26, oe, control, 0, 0, 0, 2, no, 0, no),
            row(2, 26, array, negative, 38, 38, 7, 0, no, 0, no),
            row(2, 26, none, negative, 0, 0, 0, 0, yes, 0, yes),
            row(3, 25, array, negative, 304, 38, 8, 0, no, 0, no),
            row(3, 25, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(3, 25, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(4, 24, array, negative, 608, 38, 8, 0, no, 0, no),
            row(4, 24, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(4, 24, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(5, 23, array, negative, 912, 38, 8, 0, no, 0, no),
            row(5, 23, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(5, 23, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(6, 21, array, negative, 1216, 38, 8, 0, no, 0, no),
            row(6, 21, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(6, 21, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(7, 20, array, negative, 1520, 38, 8, 0, no, 0, no),
            row(7, 20, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(7, 20, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(8, 19, array, negative, 1824, 38, 8, 0, no, 0, no),
            row(8, 19, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(8, 19, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(9, 18, array, control, 2128, 38, 1, 0, no, 0, no),
            row(9, 18, oe, control, 0, 0, 0, 2, no, 0, no),
            row(10, 18, array, negative, 2166, 38, 7, 0, no, 0, no),
            row(10, 18, none, negative, 0, 0, 0, 0, yes, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 2432),
            row(address, 1, " ", 0, 0, 0, 0),
            row(text, 1, "Mode ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 11),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(set, 2, " ", 2, 26, 0, 0),
            row(setup_loop, 2, " ", 1, 64, 0, 0),
            row(if_equal, 2, " ", 1, 33, 0, 1),
            row(set, 2, " ", 2, 21, 0, 0),
            row(loop, 2, " ", 7, 0, 8, 1),
            row(print_decrement, 2, "Pin #", 2, 1, 1, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 38),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 38),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(2, 26, none, 1, 0, 0, yes),
            row(1, 26, oe, 1, 1, 0, yes),
            row(10, 18, none, 2, 0, 0, yes),
            row(9, 18, oe, 2, 1, 0, yes),
            row(1, 2, ck, 3, 1, 1, no),
            row(3, 25, d, 3, 0, 0, no),
            row(4, 24, d, 3, 0, 0, no),
            row(5, 23, d, 3, 0, 0, no),
            row(6, 21, d, 3, 0, 0, no),
            row(7, 20, d, 3, 0, 0, no),
            row(8, 19, d, 3, 0, 0, no),
            row(22, 16, oe_term, 4, 1, 1, no),
            row(3, 25, d, 4, 0, 0, no),
            row(4, 24, d, 4, 0, 0, no),
            row(5, 23, d, 4, 0, 0, no),
            row(6, 21, d, 4, 0, 0, no),
            row(7, 20, d, 4, 0, 0, no),
            row(8, 19, d, 4, 0, 0, no),
            row(21, 17, ck, 5, 1, 1, no),
            row(2, 2, dq, 5, 0, 1, no),
            row(4, 4, dq, 5, 0, 1, no),
            row(6, 5, dq, 5, 0, 1, no),
            row(8, 6, dq, 5, 0, 1, no),
            row(10, 7, dq, 5, 0, 1, no),
            row(12, 9, dq, 5, 0, 1, no),
            row(14, 10, dq, 5, 0, 1, no),
            row(16, 11, dq, 5, 0, 1, no),
            row(18, 12, dq, 5, 0, 1, no),
            row(20, 13, dq, 5, 0, 1, no),
            row(3, 27, dq, 5, 0, 1, no),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
