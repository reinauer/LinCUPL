# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20s10 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 3322
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 17
        family = 1
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 80
        initial_term_capacity = 90
        array_slots = 17
        input_line_slots = 23
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 0, 1),
            row(2, 1, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 22, feedback, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 21, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 20, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 19, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 18, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 17, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 16, feedback, 30, 31),
            row(17, 10, unspecified, 32, 33),
            row(18, 15, feedback, 34, 35),
            row(19, 11, unspecified, 36, 37),
            row(20, 13, unspecified, 38, 39),
            row(21, 12, ground, 0, 0),
            row(22, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, active, legacy_width]
        rows = [
            row(1, 23, array, control, 0, 0, 0, 40, 0, 1, 0, no, no, 40),
            row(1, 23, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(2, 23, array, negative, 0, 40, 0, 40, 0, 7, 0, no, no, 40),
            row(2, 23, none, programmable_positive, 1, 3200, 0, 1, 0, 0, 0, yes, yes, 0),
            row(2, 23, none, programmable_negative, 0, 3200, 0, 1, 0, 0, 0, yes, yes, 0),
            row(3, 22, array, control, 0, 320, 0, 40, 0, 1, 0, no, no, 40),
            row(3, 22, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(4, 21, array, control, 0, 920, 0, 40, 0, 1, 0, no, no, 40),
            row(4, 21, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(5, 0, array, negative, 0, 360, 3210, 40, 2, 14, 0, no, no, 0),
            row(5, 22, none, programmable_positive, 1, 3201, 0, 1, 0, 0, 0, yes, yes, 0),
            row(5, 22, none, programmable_negative, 0, 3201, 0, 1, 0, 0, 0, yes, yes, 0),
            row(5, 21, none, programmable_positive, 1, 3202, 1, 1, 0, 0, 0, yes, yes, 0),
            row(5, 21, none, programmable_negative, 0, 3202, 1, 1, 0, 0, 0, yes, yes, 0),
            row(6, 20, array, control, 0, 960, 0, 40, 0, 1, 0, no, no, 40),
            row(6, 20, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(7, 19, array, control, 0, 1560, 0, 40, 0, 1, 0, no, no, 40),
            row(7, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(8, 0, array, negative, 0, 1000, 3238, 40, 2, 14, 0, no, no, 0),
            row(8, 20, none, programmable_positive, 1, 3203, 0, 1, 0, 0, 0, yes, yes, 0),
            row(8, 20, none, programmable_negative, 0, 3203, 0, 1, 0, 0, 0, yes, yes, 0),
            row(8, 19, none, programmable_positive, 1, 3204, 1, 1, 0, 0, 0, yes, yes, 0),
            row(8, 19, none, programmable_negative, 0, 3204, 1, 1, 0, 0, 0, yes, yes, 0),
            row(9, 18, array, control, 0, 1600, 0, 40, 0, 1, 0, no, no, 40),
            row(9, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(10, 17, array, control, 0, 2200, 0, 40, 0, 1, 0, no, no, 40),
            row(10, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(11, 0, array, negative, 0, 1640, 3266, 40, 2, 14, 0, no, no, 0),
            row(11, 18, none, programmable_positive, 1, 3205, 0, 1, 0, 0, 0, yes, yes, 0),
            row(11, 18, none, programmable_negative, 0, 3205, 0, 1, 0, 0, 0, yes, yes, 0),
            row(11, 17, none, programmable_positive, 1, 3206, 1, 1, 0, 0, 0, yes, yes, 0),
            row(11, 17, none, programmable_negative, 0, 3206, 1, 1, 0, 0, 0, yes, yes, 0),
            row(12, 16, array, control, 0, 2240, 0, 40, 0, 1, 0, no, no, 40),
            row(12, 16, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(13, 15, array, control, 0, 2840, 0, 40, 0, 1, 0, no, no, 40),
            row(13, 15, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(14, 0, array, negative, 0, 2280, 3294, 40, 2, 14, 0, no, no, 0),
            row(14, 16, none, programmable_positive, 1, 3207, 0, 1, 0, 0, 0, yes, yes, 0),
            row(14, 16, none, programmable_negative, 0, 3207, 0, 1, 0, 0, 0, yes, yes, 0),
            row(14, 15, none, programmable_positive, 1, 3208, 1, 1, 0, 0, 0, yes, yes, 0),
            row(14, 15, none, programmable_negative, 0, 3208, 1, 1, 0, 0, 0, yes, yes, 0),
            row(15, 14, array, control, 0, 3160, 0, 40, 0, 1, 0, no, no, 40),
            row(15, 14, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(16, 14, array, negative, 0, 2880, 0, 40, 0, 7, 0, no, no, 40),
            row(16, 14, none, programmable_positive, 1, 3209, 0, 1, 0, 0, 0, yes, yes, 0),
            row(16, 14, none, programmable_negative, 0, 3209, 0, 1, 0, 0, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 23, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 4, 3200),
            row(loop, 1, " ", 7, 0, 8, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(setup_loop, 2, " ", 1, 64, 5, 3210),
            row(loop, 2, " ", 7, 0, 16, 12),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 0, 0),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(if_equal, 2, " ", 7, 0, 0, 1),
            row(if_equal, 2, " ", 7, 17, 0, 5),
            row(if_equal, 2, " ", 7, 15, 0, 1),
            row(if_equal, 2, " ", 7, 17, 0, 3),
            row(address, 2, "  ", 5, 0, 0, 0),
            row(fuses_forward, 2, "x-", 5, 0, 1, 2),
            row(add, 2, " ", 5, 2, 0, 0),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(setup_loop, 3, " ", 1, 8, 9, 0),
            row(loop, 3, " ", 7, 0, 9, 6),
            row(print_decrement, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(add, 3, "", 4, 1, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 40),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 23, none, 1, 0),
            row(1, 23, oe, 1, 1),
            row(5, 22, none, 2, 0),
            row(3, 22, oe, 2, 1),
            row(5, 21, none, 3, 0),
            row(4, 21, oe, 3, 1),
            row(8, 20, none, 4, 0),
            row(6, 20, oe, 4, 1),
            row(8, 19, none, 5, 0),
            row(7, 19, oe, 5, 1),
            row(11, 18, none, 6, 0),
            row(9, 18, oe, 6, 1),
            row(11, 17, none, 7, 0),
            row(10, 17, oe, 7, 1),
            row(14, 16, none, 8, 0),
            row(12, 16, oe, 8, 1),
            row(14, 15, none, 9, 0),
            row(13, 15, oe, 9, 1),
            row(16, 14, none, 10, 0),
            row(15, 14, oe, 10, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
