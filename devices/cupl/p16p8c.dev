# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16p8c {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 2056
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 21
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 23, unspecified, 2, 3),
            row(3, 2, unspecified, 4, 5),
            row(4, 22, unspecified, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 21, feedback, 10, 11),
            row(7, 4, feedback, 12, 13),
            row(8, 17, feedback, 14, 15),
            row(9, 8, feedback, 16, 17),
            row(10, 16, unspecified, 18, 19),
            row(11, 9, unspecified, 20, 21),
            row(12, 15, unspecified, 22, 23),
            row(13, 10, unspecified, 24, 25),
            row(14, 14, unspecified, 26, 27),
            row(15, 11, unspecified, 28, 29),
            row(16, 13, unspecified, 30, 31),
            row(17, 12, negative_supply, 0, 0),
            row(18, 6, supply, 0, 0),
            row(19, 19, supply, 0, 0),
            row(20, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, has_default, active]
        rows = [
            row(1, 21, none, programmable_positive, 0, 2048, 1, 0, yes, yes),
            row(1, 21, none, programmable_negative, 1, 2048, 1, 0, yes, yes),
            row(1, 21, array, negative, 0, 0, 32, 8, no, no),
            row(2, 4, none, programmable_positive, 0, 2049, 1, 0, yes, yes),
            row(2, 4, none, programmable_negative, 1, 2049, 1, 0, yes, yes),
            row(2, 4, array, negative, 0, 256, 32, 8, no, no),
            row(3, 20, none, programmable_positive, 0, 2050, 1, 0, yes, yes),
            row(3, 20, none, programmable_negative, 1, 2050, 1, 0, yes, yes),
            row(3, 20, array, negative, 0, 512, 32, 8, no, no),
            row(4, 5, none, programmable_positive, 0, 2051, 1, 0, yes, yes),
            row(4, 5, none, programmable_negative, 1, 2051, 1, 0, yes, yes),
            row(4, 5, array, negative, 0, 768, 32, 8, no, no),
            row(5, 18, none, programmable_positive, 0, 2052, 1, 0, yes, yes),
            row(5, 18, none, programmable_negative, 1, 2052, 1, 0, yes, yes),
            row(5, 18, array, negative, 0, 1024, 32, 8, no, no),
            row(6, 7, none, programmable_positive, 0, 2053, 1, 0, yes, yes),
            row(6, 7, none, programmable_negative, 1, 2053, 1, 0, yes, yes),
            row(6, 7, array, negative, 0, 1280, 32, 8, no, no),
            row(7, 17, none, programmable_positive, 0, 2054, 1, 0, yes, yes),
            row(7, 17, none, programmable_negative, 1, 2054, 1, 0, yes, yes),
            row(7, 17, array, negative, 0, 1536, 32, 8, no, no),
            row(8, 8, none, programmable_positive, 0, 2055, 1, 0, yes, yes),
            row(8, 8, none, programmable_negative, 1, 2055, 1, 0, yes, yes),
            row(8, 8, array, negative, 0, 1792, 32, 8, no, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 21, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 4, 2048),
            row(loop, 1, " ", 7, 0, 8, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(set, 2, " ", 2, 4, 0, 0),
            row(setup_loop, 2, " ", 1, 8, 4, 2049),
            row(loop, 2, " ", 7, 0, 8, 6),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 32),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 32),
            row(set, 3, " ", 2, 20, 0, 0),
            row(setup_loop, 3, " ", 1, 8, 4, 2050),
            row(loop, 3, " ", 7, 0, 8, 6),
            row(print_decrement, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(add, 3, "", 4, 1, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 32),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 32),
            row(set, 4, " ", 2, 5, 0, 0),
            row(setup_loop, 4, " ", 1, 8, 4, 2051),
            row(loop, 4, " ", 7, 0, 8, 6),
            row(print_decrement, 4, "Pin #", 2, 1, 0, 0),
            row(address, 4, " ", 4, 0, 0, 0),
            row(text, 4, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 4, 0, 1, 1),
            row(newline, 4, "", 1, 0, 0, 0),
            row(add, 4, "", 4, 1, 0, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 32),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 32),
            row(set, 5, " ", 2, 18, 0, 0),
            row(setup_loop, 5, " ", 1, 8, 4, 2052),
            row(loop, 5, " ", 7, 0, 8, 6),
            row(print_decrement, 5, "Pin #", 2, 1, 0, 0),
            row(address, 5, " ", 4, 0, 0, 0),
            row(text, 5, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 5, "x-", 4, 0, 1, 1),
            row(newline, 5, "", 1, 0, 0, 0),
            row(add, 5, "", 4, 1, 0, 0),
            row(address, 5, " ", 0, 0, 0, 0),
            row(fuses_forward, 5, "x-", 0, 0, 1, 32),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 0, 32),
            row(set, 6, " ", 2, 7, 0, 0),
            row(setup_loop, 6, " ", 1, 8, 4, 2053),
            row(loop, 6, " ", 7, 0, 8, 6),
            row(print_decrement, 6, "Pin #", 2, 1, 0, 0),
            row(address, 6, " ", 4, 0, 0, 0),
            row(text, 6, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 6, "x-", 4, 0, 1, 1),
            row(newline, 6, "", 1, 0, 0, 0),
            row(add, 6, "", 4, 1, 0, 0),
            row(address, 6, " ", 0, 0, 0, 0),
            row(fuses_forward, 6, "x-", 0, 0, 1, 32),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(end_row, 6, " ", 0, 0, 0, 32),
            row(set, 7, " ", 2, 17, 0, 0),
            row(setup_loop, 7, " ", 1, 8, 4, 2054),
            row(loop, 7, " ", 7, 0, 8, 6),
            row(print_decrement, 7, "Pin #", 2, 1, 0, 0),
            row(address, 7, " ", 4, 0, 0, 0),
            row(text, 7, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 7, "x-", 4, 0, 1, 1),
            row(newline, 7, "", 1, 0, 0, 0),
            row(add, 7, "", 4, 1, 0, 0),
            row(address, 7, " ", 0, 0, 0, 0),
            row(fuses_forward, 7, "x-", 0, 0, 1, 32),
            row(newline, 7, " ", 1, 0, 0, 0),
            row(end_row, 7, " ", 0, 0, 0, 32),
            row(set, 8, " ", 2, 8, 0, 0),
            row(setup_loop, 8, " ", 1, 8, 4, 2055),
            row(loop, 8, " ", 7, 0, 8, 6),
            row(print_decrement, 8, "Pin #", 2, 1, 0, 0),
            row(address, 8, " ", 4, 0, 0, 0),
            row(text, 8, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 8, "x-", 4, 0, 1, 1),
            row(newline, 8, "", 1, 0, 0, 0),
            row(add, 8, "", 4, 1, 0, 0),
            row(address, 8, " ", 0, 0, 0, 0),
            row(fuses_forward, 8, "x-", 0, 0, 1, 32),
            row(newline, 8, " ", 1, 0, 0, 0),
            row(end_row, 8, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
