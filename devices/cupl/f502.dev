    compiler {
        revision = 1
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 144
        initial_term_capacity = 240
        array_slots = 161
        input_line_slots = 158
        extra_symbols = 20
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 24
    }

