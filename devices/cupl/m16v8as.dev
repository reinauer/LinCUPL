# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device m16v8as {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 3136
        default = 1
    }

    signature {
        bits = 16
        first_fuse = 3120
    }

    compiler {
        revision = 1
        family = 7
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 10
        input_line_slots = 19
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 19, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 18, unspecified, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 17, unspecified, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 14, unspecified, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 13, unspecified, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 12, unspecified, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 11, unspecified, 30, 31),
            row(17, 10, ground, 0, 0),
            row(18, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            pair_first_fuse = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, config_value, first_row_fuse, first_or_fuse, config_first_fuse, row_width, or_width, config_bits, max_terms, has_default, sharing_mode, active]
        rows = [
            row(1, 19, array, negative, 0, 0, 0, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(1, 19, none, programmable_positive, 3840, 1, 3096, 40, 3080, 2, 0, 1, 0, yes, 1, yes),
            row(1, 19, none, programmable_negative, 3840, 0, 3096, 40, 3080, 2, 0, 1, 0, yes, 1, yes),
            row(2, 18, array, negative, 0, 0, 384, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(2, 18, none, programmable_positive, 3840, 1, 3097, 41, 3081, 2, 0, 1, 0, yes, 1, yes),
            row(2, 18, none, programmable_negative, 3840, 0, 3097, 41, 3081, 2, 0, 1, 0, yes, 1, yes),
            row(3, 17, array, negative, 0, 0, 768, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(3, 17, none, programmable_positive, 3840, 1, 3098, 42, 3082, 2, 0, 1, 0, yes, 1, yes),
            row(3, 17, none, programmable_negative, 3840, 0, 3098, 42, 3082, 2, 0, 1, 0, yes, 1, yes),
            row(4, 16, array, negative, 0, 0, 1152, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(4, 16, none, programmable_positive, 3840, 1, 3099, 43, 3083, 2, 0, 1, 0, yes, 1, yes),
            row(4, 16, none, programmable_negative, 3840, 0, 3099, 43, 3083, 2, 0, 1, 0, yes, 1, yes),
            row(5, 15, array, negative, 0, 0, 1536, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(5, 15, none, programmable_positive, 3840, 1, 3100, 44, 3084, 2, 0, 1, 0, yes, 1, yes),
            row(5, 15, none, programmable_negative, 3840, 0, 3100, 44, 3084, 2, 0, 1, 0, yes, 1, yes),
            row(6, 14, array, negative, 0, 0, 1920, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(6, 14, none, programmable_positive, 3840, 1, 3101, 45, 3085, 2, 0, 1, 0, yes, 1, yes),
            row(6, 14, none, programmable_negative, 3840, 0, 3101, 45, 3085, 2, 0, 1, 0, yes, 1, yes),
            row(7, 13, array, negative, 0, 0, 2304, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(7, 13, none, programmable_positive, 3840, 1, 3102, 46, 3086, 2, 0, 1, 0, yes, 1, yes),
            row(7, 13, none, programmable_negative, 3840, 0, 3102, 46, 3086, 2, 0, 1, 0, yes, 1, yes),
            row(8, 12, array, negative, 0, 0, 2688, 0, 0, 32, 16, 0, 8, no, 0, no),
            row(8, 12, none, programmable_positive, 3840, 1, 3103, 47, 3087, 2, 0, 1, 0, yes, 1, yes),
            row(8, 12, none, programmable_negative, 3840, 0, 3103, 47, 3087, 2, 0, 1, 0, yes, 1, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 6, 19, 0, 0),
            row(set, 1, " ", 0, 3072, 0, 0),
            row(set, 1, " ", 1, 3080, 0, 0),
            row(set, 1, " ", 2, 3088, 0, 0),
            row(set, 1, " ", 3, 3096, 0, 0),
            row(set, 1, " ", 4, 3104, 0, 0),
            row(set, 1, " ", 5, 3112, 0, 0),
            row(setup_loop, 1, " ", 7, 64, 9, 0),
            row(loop, 1, " ", 8, 0, 8, 12),
            row(print_decrement, 1, "Pin #", 6, 1, 0, 0),
            row(text, 1, " F0-5:", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 1),
            row(fuses_forward, 1, "x-", 1, 0, 1, 1),
            row(fuses_forward, 1, "x-", 2, 0, 1, 1),
            row(fuses_forward, 1, "x-", 3, 0, 1, 1),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 0, 1, 1, 1),
            row(add, 1, "", 2, 1, 3, 1),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 9, 0, 0, 0),
            row(fuses_forward, 1, "x-", 9, 0, 1, 32),
            row(fuses_forward, 1, "x-", 9, 32, 1, 16),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 9, 48),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(3120, 3135, 0),
            row(3072, 3079, 1),
            row(3080, 3087, 1),
            row(3088, 3095, 1),
            row(3096, 3098, 1),
            row(3099, 3100, 0),
            row(3101, 3103, 1),
            row(3104, 3111, 0),
            row(3112, 3114, 1),
            row(3115, 3116, 0),
            row(3117, 3119, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
