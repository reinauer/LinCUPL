# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f7024lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 20
    }

    power {
        ground = 0
        supply = 0
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 0
    }

    fuses {
        count = 14088
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 14024
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 20
        clocked_resources = 20
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 1
        input_line_slots = 70
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 20
    }

    fitter {
        input_format = 8
        name = "ict7024"
        arguments = ""
        pla_options = [tool_header, jedec_keyword, omit_plus, omit_pin_zero]
        part = "f7024c"
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("io", io),
            row("d", d),
            row("t", t),
            row("ar", ar),
            row("ap", ap),
            row("j", j),
            row("k", k),
            row("ck", ck),
            row("iod", iod),
            row("iol", iol),
            row("dq", dq),
            row("lq", lq),
            row("ffm", ffm),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("j", "J"),
            row("k", "K"),
            row("l", ""),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("ce", "CE"),
            row("reg", "Q"),
            row("ffm", "FC"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 2, none, clock_input),
            row(2, 3, none, register_feedback),
            row(2, 3, none, combinational),
            row(2, 3, io, combinational),
            row(3, 4, none, register_feedback),
            row(3, 4, none, combinational),
            row(3, 4, io, combinational),
            row(4, 5, none, register_feedback),
            row(4, 5, none, combinational),
            row(4, 5, io, combinational),
            row(5, 6, none, register_feedback),
            row(5, 6, none, combinational),
            row(5, 6, io, combinational),
            row(6, 7, none, register_feedback),
            row(6, 7, none, combinational),
            row(6, 7, io, combinational),
            row(7, 9, none, register_feedback),
            row(7, 9, none, combinational),
            row(7, 9, io, combinational),
            row(8, 10, none, register_feedback),
            row(8, 10, none, combinational),
            row(8, 10, io, combinational),
            row(9, 11, none, register_feedback),
            row(9, 11, none, combinational),
            row(9, 11, io, combinational),
            row(10, 12, none, register_feedback),
            row(10, 12, none, combinational),
            row(10, 12, io, combinational),
            row(11, 13, none, register_feedback),
            row(11, 13, none, combinational),
            row(11, 13, io, combinational),
            row(12, 14, none, ground),
            row(13, 16, none, clock_input),
            row(14, 17, none, register_feedback),
            row(14, 17, none, combinational),
            row(14, 17, io, combinational),
            row(15, 18, none, register_feedback),
            row(15, 18, none, combinational),
            row(15, 18, io, combinational),
            row(16, 19, none, register_feedback),
            row(16, 19, none, combinational),
            row(16, 19, io, combinational),
            row(17, 20, none, register_feedback),
            row(17, 20, none, combinational),
            row(17, 20, io, combinational),
            row(18, 21, none, register_feedback),
            row(18, 21, none, combinational),
            row(18, 21, io, combinational),
            row(19, 23, none, register_feedback),
            row(19, 23, none, combinational),
            row(19, 23, io, combinational),
            row(20, 24, none, register_feedback),
            row(20, 24, none, combinational),
            row(20, 24, io, combinational),
            row(21, 25, none, register_feedback),
            row(21, 25, none, combinational),
            row(21, 25, io, combinational),
            row(22, 26, none, register_feedback),
            row(22, 26, none, combinational),
            row(22, 26, io, combinational),
            row(23, 27, none, register_feedback),
            row(23, 27, none, combinational),
            row(23, 27, io, combinational),
            row(24, 28, none, supply),
            row(25, 33, none, register_feedback),
            row(26, 34, none, register_feedback),
            row(27, 35, none, register_feedback),
            row(28, 36, none, register_feedback),
            row(29, 37, none, register_feedback),
            row(30, 39, none, register_feedback),
            row(31, 40, none, register_feedback),
            row(32, 41, none, register_feedback),
            row(33, 42, none, register_feedback),
            row(34, 43, none, register_feedback),
            row(35, 47, none, register_feedback),
            row(36, 48, none, register_feedback),
            row(37, 49, none, register_feedback),
            row(38, 50, none, register_feedback),
            row(39, 51, none, register_feedback),
            row(40, 53, none, register_feedback),
            row(41, 54, none, register_feedback),
            row(42, 55, none, register_feedback),
            row(43, 56, none, register_feedback),
            row(44, 57, none, register_feedback),
            row(45, 63, none, register_feedback),
            row(46, 64, none, register_feedback),
            row(47, 65, none, register_feedback),
            row(48, 66, none, register_feedback),
            row(49, 67, none, register_feedback),
            row(50, 69, none, register_feedback),
            row(51, 70, none, register_feedback),
            row(52, 71, none, register_feedback),
            row(53, 72, none, register_feedback),
            row(54, 73, none, register_feedback),
            row(55, 77, none, register_feedback),
            row(56, 78, none, register_feedback),
            row(57, 79, none, register_feedback),
            row(58, 80, none, register_feedback),
            row(59, 81, none, register_feedback),
            row(60, 83, none, register_feedback),
            row(61, 84, none, register_feedback),
            row(62, 85, none, register_feedback),
            row(63, 86, none, register_feedback),
            row(64, 87, none, register_feedback),
            row(65, 1, none, not_connected),
            row(67, 8, none, not_connected),
            row(68, 15, none, not_connected),
            row(69, 22, none, not_connected),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        columns = [kind, text]
        rows = [
            row(pla_file, ""),
            row(literal, "-log"),
            row(file_suffix, ".log"),
            row(none, ""),
        ]
    }

}
