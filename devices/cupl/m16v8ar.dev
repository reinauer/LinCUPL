        columns = [line, pin, compiler_type, true_column, complement_column, config_first_fuse]
        rows = [
            row(1, 1, clock, 0, 0, 0),
            row(2, 2, unspecified, 0, 1, 0),
            row(3, 19, feedback, 2, 3, 3096),
