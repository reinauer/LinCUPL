# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f507 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 18
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 7370
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 5
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 2
        extra_nodes_c = 6
        register_resources = 18
        clocked_resources = 18
        default_extension = none
        product_rows = 80
        initial_term_capacity = 100
        array_slots = 4
        input_line_slots = 31
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = s
        next_alternate = r
        next_count = 2
        input_function = s
        input_alternate = r
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
