# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device nfx780_84 {
    representation = library

    package {
        pins = 84
        drawing_style = 0
        internal_nodes = 80
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 31704
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 80
        clocked_resources = 60
        default_extension = none
        product_rows = 1024
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 165
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 60
    }

    fitter {
        input_format = 7
        name = "flexfit"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("io", io),
            row("int", int),
            row("ck", ck),
            row("ckmux", ckmux),
            row("ce", ce),
            row("dfb", dfb),
            row("tfb", tfb),
            row("oe", oe),
            row("oemux", oemux),
            row("le", le),
            row("lemux", lemux),
            row("ap", ap),
            row("ar", ar),
            row("sp", sp),
            row("sr", sr),
            row("ffm", ffm),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("j", "J"),
            row("k", "K"),
            row("r", "R"),
            row("s", "S"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
