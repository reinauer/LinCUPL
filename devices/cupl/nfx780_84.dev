            first_or_fuse = 0
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        defaults {
            text = ""
        }
        columns = [kind]
        rows = [
            row(pla_file),
            row(none),
        ]
    }

}
