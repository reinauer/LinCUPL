            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "SP"),
            row("iosr", "SR"),
            row("iock", "C"),
            row("int", "FB"),
            row("dfb", "FB"),
            row("tfb", "FB"),
            row("ckmux", "C"),
            row("lemux", "LE"),
            row("oemux", "OE"),
            row("ce", "CE"),
            row("ffm", "FC"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
