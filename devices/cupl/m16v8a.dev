            row(19, 13, array, control, 0, 0, 2304, 0, 0, 48, 0, 0, 1, 0, no, 0, no),
            row(19, 13, oe, control, 0, 0, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(20, 13, array, negative, 0, 0, 2352, 0, 0, 32, 16, 0, 7, 0, no, 0, no),
