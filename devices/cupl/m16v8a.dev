# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device m16v8a {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 3136
        default = 1
    }

    signature {
        bits = 16
        first_fuse = 3120
    }

    compiler {
        revision = 1
        family = 7
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 21
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("ckmux", ckmux),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 19, feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 18, feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 17, feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 16, feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 15, feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 14, feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 13, feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 12, feedback, 30, 31),
            row(18, 11, output_enable, 0, 0),
            row(19, 10, ground, 0, 0),
            row(20, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            pair_first_fuse = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, config_value, first_row_fuse, first_or_fuse, config_first_fuse, row_width, or_width, config_bits, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 19, array, control, 0, 0, 0, 0, 0, 48, 0, 0, 1, 0, no, 0, no),
            row(1, 19, oe, control, 0, 0, 0, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
