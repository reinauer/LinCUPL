# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f7140 {
    representation = library

    package {
        pins = 40
        drawing_style = 0
        internal_nodes = 144
    }

    power {
        ground = 0
        supply = 0
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 0
    }

    fuses {
        count = 22103
        default = 0
    }

    signature {
        bits = 16
        first_fuse = 22087
    }

    compiler {
        revision = 2
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 24
        extra_nodes_c = 0
        register_resources = 48
        clocked_resources = 24
        default_extension = none
        product_rows = 120
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 101
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 24
    }

    fitter {
        input_format = 8
        name = "ict7140"
        arguments = ""
        pla_options = [tool_header, jedec_keyword, omit_plus, omit_pin_zero]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("io", io),
            row("d", d),
            row("t", t),
            row("ar", ar),
            row("ap", ap),
            row("j", j),
            row("k", k),
            row("ck", ck),
            row("iod", iod),
            row("iol", iol),
            row("dq", dq),
            row("lq", lq),
            row("ffm", ffm),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("j", "J"),
            row("k", "K"),
            row("l", ""),
            row("dq", "Q"),
            row("tq", "Q"),
            row("lq", "Q"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "Q"),
            row("iol", "Q"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("ce", "CE"),
            row("reg", "Q"),
            row("ffm", "FC"),
            row("apmux", "AP"),
            row("armux", "AR"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 1, none, clock_input),
            row(2, 2, none, unspecified),
            row(3, 3, none, unspecified),
            row(4, 4, none, unspecified),
            row(5, 5, none, registered),
            row(5, 5, none, combinational),
            row(5, 5, io, combinational),
            row(6, 6, none, registered),
            row(6, 6, none, combinational),
            row(6, 6, io, combinational),
            row(7, 7, none, registered),
            row(7, 7, none, combinational),
            row(7, 7, io, combinational),
            row(8, 8, none, registered),
            row(8, 8, none, combinational),
            row(8, 8, io, combinational),
