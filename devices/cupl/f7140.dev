            row(36, 36, none, registered),
            row(36, 36, none, combinational),
            row(36, 36, io, combinational),
            row(37, 37, none, unspecified),
            row(38, 38, none, unspecified),
            row(39, 39, none, unspecified),
            row(40, 40, none, supply),
            row(41, 55, none, registered),
