# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20l8lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2560
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 9
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 27
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 2, 3),
            row(2, 3, unspecified, 0, 1),
            row(3, 4, unspecified, 4, 5),
            row(4, 27, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 25, feedback, 10, 11),
            row(7, 6, unspecified, 12, 13),
            row(8, 24, feedback, 14, 15),
            row(9, 7, unspecified, 16, 17),
            row(10, 23, feedback, 18, 19),
            row(11, 9, unspecified, 20, 21),
            row(12, 21, feedback, 22, 23),
            row(13, 10, unspecified, 24, 25),
            row(14, 20, feedback, 26, 27),
            row(15, 11, unspecified, 28, 29),
            row(16, 19, feedback, 30, 31),
            row(17, 12, unspecified, 32, 33),
            row(18, 17, unspecified, 34, 35),
            row(19, 13, unspecified, 36, 37),
            row(20, 16, unspecified, 38, 39),
            row(21, 14, ground, 0, 0),
            row(22, 28, supply, 0, 0),
            row(23, 1, not_connected, 0, 0),
            row(24, 8, not_connected, 0, 0),
            row(25, 15, not_connected, 0, 0),
            row(26, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, default_rule, has_default, active, legacy_width]
        rows = [
            row(1, 26, array, control, 0, 40, 1, 0, no, no, 40),
            row(1, 26, oe, control, 0, 0, 0, 2, no, no, 0),
            row(2, 26, array, negative, 40, 40, 7, 0, no, no, 40),
            row(2, 26, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(3, 25, array, control, 320, 40, 1, 0, no, no, 40),
            row(3, 25, oe, control, 0, 0, 0, 2, no, no, 0),
            row(4, 25, array, negative, 360, 40, 7, 0, no, no, 40),
            row(4, 25, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(5, 24, array, control, 640, 40, 1, 0, no, no, 40),
            row(5, 24, oe, control, 0, 0, 0, 2, no, no, 0),
            row(6, 24, array, negative, 680, 40, 7, 0, no, no, 40),
            row(6, 24, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(7, 23, array, control, 960, 40, 1, 0, no, no, 40),
            row(7, 23, oe, control, 0, 0, 0, 2, no, no, 0),
            row(8, 23, array, negative, 1000, 40, 7, 0, no, no, 40),
            row(8, 23, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(9, 21, array, control, 1280, 40, 1, 0, no, no, 40),
            row(9, 21, oe, control, 0, 0, 0, 2, no, no, 0),
            row(10, 21, array, negative, 1320, 40, 7, 0, no, no, 40),
            row(10, 21, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(11, 20, array, control, 1600, 40, 1, 0, no, no, 40),
            row(11, 20, oe, control, 0, 0, 0, 2, no, no, 0),
            row(12, 20, array, negative, 1640, 40, 7, 0, no, no, 40),
            row(12, 20, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(13, 19, array, control, 1920, 40, 1, 0, no, no, 40),
            row(13, 19, oe, control, 0, 0, 0, 2, no, no, 0),
            row(14, 19, array, negative, 1960, 40, 7, 0, no, no, 40),
            row(14, 19, none, negative, 0, 0, 0, 0, yes, yes, 0),
            row(15, 18, array, control, 2240, 40, 1, 0, no, no, 40),
            row(15, 18, oe, control, 0, 0, 0, 2, no, no, 0),
            row(16, 18, array, negative, 2280, 40, 7, 0, no, no, 40),
            row(16, 18, none, negative, 0, 0, 0, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 26, 0, 0),
            row(setup_loop, 1, " ", 1, 32, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(set, 2, " ", 2, 21, 0, 0),
            row(setup_loop, 2, " ", 1, 32, 0, 1280),
            row(loop, 2, " ", 7, 0, 8, 1),
            row(print_decrement, 2, "Pin #", 2, 1, 1, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 26, none, 1, 0),
            row(1, 26, oe, 1, 1),
            row(4, 25, none, 2, 0),
            row(3, 25, oe, 2, 1),
            row(6, 24, none, 3, 0),
            row(5, 24, oe, 3, 1),
            row(8, 23, none, 4, 0),
            row(7, 23, oe, 4, 1),
            row(10, 21, none, 5, 0),
            row(9, 21, oe, 5, 1),
            row(12, 20, none, 6, 0),
            row(11, 20, oe, 6, 1),
            row(14, 19, none, 7, 0),
            row(13, 19, oe, 7, 1),
            row(16, 18, none, 8, 0),
            row(15, 18, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
