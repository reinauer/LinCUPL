# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ep1800 {
    representation = library

    package {
        pins = 68
        drawing_style = 1
        internal_nodes = 48
    }

    power {
        ground = 1
        supply = 18
    }

    fuses {
        count = 42490
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 11
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 96
        clocked_resources = 48
        default_extension = none
        product_rows = 480
        initial_term_capacity = 400
        array_slots = 145
        input_line_slots = 85
        extra_symbols = 96
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 1
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 48
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("t", t),
            row("ar", ar),
            row("ck", ck),
            row("io", io),
            row("dfb", dfb),
            row("tfb", tfb),
            row("int", int),
        ]
    }

    pin_functions {
        columns = [line, pin, function, compiler_type, variant, true_column, complement_column, config_value, config_bits, config_first_fuse]
