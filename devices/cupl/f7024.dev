# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f7024 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 60
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 14088
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 14024
    }

    compiler {
        revision = 2
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 20
        clocked_resources = 20
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 1
        input_line_slots = 65
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 20
    }

    fitter {
        input_format = 8
        name = "ict7024"
        arguments = ""
        pla_options = [tool_header, jedec_keyword, omit_plus, omit_pin_zero]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("io", io),
            row("d", d),
            row("t", t),
            row("ar", ar),
            row("ap", ap),
            row("j", j),
            row("k", k),
            row("ck", ck),
            row("iod", iod),
            row("iol", iol),
            row("dq", dq),
            row("lq", lq),
            row("ffm", ffm),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("j", "J"),
            row("k", "K"),
            row("l", ""),
            row("dq", "Q"),
            row("tq", "Q"),
            row("lq", "Q"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "Q"),
            row("iol", "Q"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("ce", "CE"),
            row("reg", "Q"),
            row("ffm", "FC"),
            row("apmux", "AP"),
            row("armux", "AR"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 1, none, clock_input),
            row(2, 2, none, register_feedback),
            row(2, 2, none, feedback),
            row(2, 2, io, feedback),
            row(3, 3, none, register_feedback),
            row(3, 3, none, feedback),
            row(3, 3, io, feedback),
            row(4, 4, none, register_feedback),
            row(4, 4, none, feedback),
            row(4, 4, io, feedback),
            row(5, 5, none, register_feedback),
            row(5, 5, none, feedback),
            row(5, 5, io, feedback),
            row(6, 6, none, register_feedback),
            row(6, 6, none, feedback),
            row(6, 6, io, feedback),
            row(7, 7, none, register_feedback),
            row(7, 7, none, feedback),
            row(7, 7, io, feedback),
            row(8, 8, none, register_feedback),
            row(8, 8, none, feedback),
            row(8, 8, io, feedback),
            row(9, 9, none, register_feedback),
            row(9, 9, none, feedback),
            row(9, 9, io, feedback),
            row(10, 10, none, register_feedback),
            row(10, 10, none, feedback),
            row(10, 10, io, feedback),
            row(11, 11, none, register_feedback),
            row(11, 11, none, feedback),
            row(11, 11, io, feedback),
            row(12, 12, none, ground),
            row(13, 13, none, clock_input),
            row(14, 14, none, register_feedback),
            row(14, 14, none, feedback),
            row(14, 14, io, feedback),
            row(15, 15, none, register_feedback),
            row(15, 15, none, feedback),
            row(15, 15, io, feedback),
            row(16, 16, none, register_feedback),
            row(16, 16, none, feedback),
            row(16, 16, io, feedback),
            row(17, 17, none, register_feedback),
            row(17, 17, none, feedback),
            row(17, 17, io, feedback),
            row(18, 18, none, register_feedback),
            row(18, 18, none, feedback),
            row(18, 18, io, feedback),
            row(19, 19, none, register_feedback),
            row(19, 19, none, feedback),
            row(19, 19, io, feedback),
            row(20, 20, none, register_feedback),
            row(20, 20, none, feedback),
            row(20, 20, io, feedback),
            row(21, 21, none, register_feedback),
            row(21, 21, none, feedback),
            row(21, 21, io, feedback),
            row(22, 22, none, register_feedback),
            row(22, 22, none, feedback),
            row(22, 22, io, feedback),
            row(23, 23, none, register_feedback),
            row(23, 23, none, feedback),
            row(23, 23, io, feedback),
            row(24, 24, none, supply),
            row(25, 32, none, register_feedback),
            row(26, 33, none, register_feedback),
            row(27, 34, none, register_feedback),
            row(28, 35, none, register_feedback),
            row(29, 36, none, register_feedback),
            row(30, 37, none, register_feedback),
            row(31, 38, none, register_feedback),
            row(32, 39, none, register_feedback),
            row(33, 40, none, register_feedback),
            row(34, 41, none, register_feedback),
            row(35, 44, none, register_feedback),
            row(36, 45, none, register_feedback),
            row(37, 46, none, register_feedback),
            row(38, 47, none, register_feedback),
            row(39, 48, none, register_feedback),
            row(40, 49, none, register_feedback),
            row(41, 50, none, register_feedback),
            row(42, 51, none, register_feedback),
            row(43, 52, none, register_feedback),
            row(44, 53, none, register_feedback),
            row(45, 62, none, register_feedback),
            row(46, 63, none, register_feedback),
            row(47, 64, none, register_feedback),
            row(48, 65, none, register_feedback),
            row(49, 66, none, register_feedback),
            row(50, 67, none, register_feedback),
            row(51, 68, none, register_feedback),
            row(52, 69, none, register_feedback),
            row(53, 70, none, register_feedback),
            row(54, 71, none, register_feedback),
            row(55, 74, none, register_feedback),
            row(56, 75, none, register_feedback),
            row(57, 76, none, register_feedback),
            row(58, 77, none, register_feedback),
            row(59, 78, none, register_feedback),
            row(60, 79, none, register_feedback),
            row(61, 80, none, register_feedback),
            row(62, 81, none, register_feedback),
            row(63, 82, none, register_feedback),
            row(64, 83, none, register_feedback),
        ]
    }

    node_functions {
        defaults {
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        columns = [kind, text]
        rows = [
            row(pla_file, ""),
            row(literal, "-log"),
            row(file_suffix, ".log"),
            row(none, ""),
        ]
    }

}
