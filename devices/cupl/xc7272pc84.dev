# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device xc7272pc84 {
    representation = library

    package {
        pins = 84
        drawing_style = 1
        internal_nodes = 100
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 99999
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 3
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 32
        extra_nodes_c = 0
        register_resources = 255
        clocked_resources = 199
        default_extension = none
        product_rows = 5000
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 1
        extra_symbols = 128
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 1
        power_up = low
        preload_polarity = 1
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 199
    }

    fitter {
        input_format = 2
        name = "plaplus"
        arguments = ""
        pla_options = [tool_header, output_keyword]
        part = ""
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("a1", "a1"),
            row("a2", "a2"),
            row("add", "add"),
            row("ap", "ap"),
            row("ar", "ar"),
            row("ce", "cce"),
            row("cemux", "cce"),
            row("cin", "cin"),
            row("cout", "cout"),
            row("ck", "c"),
            row("ckmux", "cc"),
            row("d", "d"),
            row("d1", "d1"),
            row("d2", "d2"),
            row("dq", "dq"),
            row("dx1", "dx1"),
            row("dx2", "dx2"),
            row("export", "export"),
            row("fi", "fi"),
            row("fbk", "fbk"),
            row("gnd", "gnd"),
            row("io", "pin"),
            row("iocemux", "iocce"),
            row("iockmux", "iocc"),
            row("iock", "c"),
            row("iod", "iod"),
            row("oe", "oe"),
            row("oemux", "coe"),
            row("l", "l"),
            row("lq", "lq"),
            row("le", "le"),
            row("lemux", "cle"),
            row("t", "t"),
            row("reg", ""),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 1, none, ground),
            row(2, 2, none, unspecified),
            row(3, 3, none, unspecified),
            row(4, 4, none, unspecified),
            row(5, 5, none, unspecified),
            row(6, 6, none, unspecified),
            row(7, 7, none, unspecified),
            row(8, 8, none, ground),
            row(9, 9, none, combinational),
            row(9, 9, none, registered),
            row(9, 9, int, registered),
            row(9, 9, io, combinational),
            row(9, 9, none, clock_input),
            row(10, 10, none, combinational),
            row(10, 10, none, registered),
            row(10, 10, int, registered),
