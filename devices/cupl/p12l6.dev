# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p12l6 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 384
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 16
        initial_term_capacity = 40
        array_slots = 7
        input_line_slots = 15
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 6
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 8, 9),
            row(5, 5, unspecified, 10, 11),
            row(6, 6, unspecified, 12, 13),
            row(7, 7, unspecified, 14, 15),
            row(8, 8, unspecified, 16, 17),
            row(9, 9, unspecified, 20, 21),
            row(10, 10, ground, 0, 0),
            row(11, 11, unspecified, 22, 23),
            row(12, 12, unspecified, 18, 19),
            row(13, 19, unspecified, 6, 7),
            row(14, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            polarity = negative
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, first_row_fuse, row_width, max_terms, active, legacy_width]
        rows = [
            row(1, 18, array, 0, 24, 4, no, 32),
            row(1, 18, none, 0, 0, 0, yes, 0),
            row(2, 17, array, 96, 24, 2, no, 32),
            row(2, 17, none, 0, 0, 0, yes, 0),
            row(3, 16, array, 144, 24, 2, no, 32),
            row(3, 16, none, 0, 0, 0, yes, 0),
            row(4, 15, array, 192, 24, 2, no, 32),
            row(4, 15, none, 0, 0, 0, yes, 0),
            row(5, 14, array, 240, 24, 2, no, 32),
            row(5, 14, none, 0, 0, 0, yes, 0),
            row(6, 13, array, 288, 24, 4, no, 32),
            row(6, 13, none, 0, 0, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 18, 0, 0),
            row(setup_loop, 1, " ", 1, 4, 0, 0),
            row(loop, 1, " ", 3, 0, 4, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 24),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 24),
            row(setup_loop, 2, " ", 1, 8, 0, 96),
            row(loop, 2, " ", 3, 0, 2, 1),
            row(print_decrement, 2, "Pin #", 2, 1, 1, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 24),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 24),
            row(setup_loop, 3, " ", 1, 4, 0, 288),
            row(loop, 3, " ", 3, 0, 4, 1),
            row(print_decrement, 3, "Pin #", 2, 1, 1, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 24),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 24),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
