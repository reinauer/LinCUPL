# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20xv10 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 0
        attribute_20 = 1
