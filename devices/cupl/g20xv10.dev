    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 40
        initial_term_capacity = 70
        array_slots = 31
        input_line_slots = 25
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
