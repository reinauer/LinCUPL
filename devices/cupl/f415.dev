# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f415 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 8
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 5751
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 3
        family = ifl
        extra_nodes_a = 2
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 16
        clocked_resources = 8
        default_extension = none
        product_rows = 68
        initial_term_capacity = 120
        array_slots = 10
        input_line_slots = 31
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = j
        next_alternate = k
        next_count = 2
        input_function = j
        input_alternate = k
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("j", j),
            row("k", k),
            row("ca", ca),
            row("oe", oe),
            row("ap", ap),
            row("ar", ar),
            row("ckmux", ckmux),
            row("oemux", oemux),
            row("apmux", apmux),
            row("armux", armux),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
