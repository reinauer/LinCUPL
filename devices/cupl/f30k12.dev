# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f30k12 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 4
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 7424
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = ifl
        extra_nodes_a = 2
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 12
        clocked_resources = 12
        default_extension = none
        product_rows = 72
        initial_term_capacity = 70
        array_slots = 13
        input_line_slots = 31
        extra_symbols = 52
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = high
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 12
    }

    fitter {
