# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20r6mlcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2560
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 11
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 6
        clocked_resources = 6
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 11
        input_line_slots = 29
        extra_symbols = 2
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 27, unspecified, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 26, feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 25, register_feedback, 10, 11),
            row(8, 6, unspecified, 12, 13),
            row(9, 24, register_feedback, 14, 15),
            row(10, 7, unspecified, 16, 17),
            row(11, 23, register_feedback, 18, 19),
            row(12, 9, unspecified, 20, 21),
            row(13, 22, register_feedback, 22, 23),
            row(14, 10, unspecified, 24, 25),
            row(15, 21, register_feedback, 26, 27),
            row(16, 12, unspecified, 28, 29),
            row(17, 20, register_feedback, 30, 31),
            row(18, 13, unspecified, 32, 33),
            row(19, 18, feedback, 34, 35),
            row(20, 14, unspecified, 36, 37),
            row(21, 17, unspecified, 38, 39),
            row(22, 15, ground, 0, 0),
            row(23, 28, supply, 0, 0),
            row(24, 16, output_enable, 0, 0),
            row(25, 5, not_connected, 0, 0),
            row(26, 8, not_connected, 0, 0),
            row(27, 11, not_connected, 0, 0),
            row(28, 19, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 26, array, control, 0, 40, 1, 0, no, 0, no),
            row(1, 26, oe, control, 0, 0, 0, 2, no, 0, no),
            row(2, 26, array, negative, 40, 40, 7, 0, no, 0, no),
            row(2, 26, none, negative, 0, 0, 0, 0, yes, 0, yes),
            row(3, 25, array, negative, 320, 40, 8, 0, no, 0, no),
            row(3, 25, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(3, 25, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(4, 24, array, negative, 640, 40, 8, 0, no, 0, no),
            row(4, 24, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(4, 24, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(5, 23, array, negative, 960, 40, 8, 0, no, 0, no),
            row(5, 23, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(5, 23, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(6, 22, array, negative, 1280, 40, 8, 0, no, 0, no),
            row(6, 22, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(6, 22, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(7, 21, array, negative, 1600, 40, 8, 0, no, 0, no),
            row(7, 21, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(7, 21, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(8, 20, array, negative, 1920, 40, 8, 0, no, 0, no),
            row(8, 20, none, unspecified, 0, 0, 0, 0, no, 2, no),
            row(8, 20, d, negative, 0, 0, 0, 0, no, 0, yes),
            row(9, 18, array, control, 2240, 40, 1, 0, no, 0, no),
            row(9, 18, oe, control, 0, 0, 0, 2, no, 0, no),
            row(10, 18, array, negative, 2280, 40, 7, 0, no, 0, no),
            row(10, 18, none, negative, 0, 0, 0, 0, yes, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 26, 0, 0),
            row(setup_loop, 1, " ", 1, 56, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(set, 2, " ", 2, 18, 0, 2240),
            row(setup_loop, 2, " ", 1, 8, 0, 0),
            row(loop, 2, " ", 7, 0, 8, 1),
            row(print_decrement, 2, "Pin #", 2, 1, 1, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(nop, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 26, oe, 0, 1, 0, yes),
            row(2, 26, none, 0, 0, 0, yes),
            row(9, 18, oe, 1, 1, 0, yes),
            row(10, 18, none, 1, 0, 0, yes),
            row(1, 1, ck, 2, 1, 1, no),
            row(3, 25, d, 2, 0, 0, no),
            row(4, 24, d, 2, 0, 0, no),
            row(5, 23, d, 2, 0, 0, no),
            row(6, 22, d, 2, 0, 0, no),
            row(7, 21, d, 2, 0, 0, no),
            row(8, 20, d, 2, 0, 0, no),
            row(24, 16, oe_term, 3, 1, 1, no),
            row(3, 25, d, 3, 0, 0, no),
            row(4, 24, d, 3, 0, 0, no),
            row(5, 23, d, 3, 0, 0, no),
            row(6, 22, d, 3, 0, 0, no),
            row(7, 21, d, 3, 0, 0, no),
            row(8, 20, d, 3, 0, 0, no),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
