# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f151 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 564
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 13
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 15
        initial_term_capacity = 70
        array_slots = 16
        input_line_slots = 21
        extra_symbols = 12
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 12
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
        }
        columns = [line, pin, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, unspecified, 0, 1, 0, 0, 0),
            row(2, 2, unspecified, 2, 3, 0, 0, 0),
            row(3, 3, unspecified, 4, 5, 0, 0, 0),
            row(4, 4, unspecified, 6, 7, 0, 0, 0),
            row(5, 5, unspecified, 8, 9, 0, 0, 0),
            row(6, 6, unspecified, 10, 11, 0, 0, 0),
            row(7, 19, feedback, 12, 13, 1, 1, 563),
            row(8, 18, feedback, 14, 15, 1, 1, 562),
            row(9, 17, feedback, 16, 17, 1, 1, 561),
            row(10, 16, feedback, 18, 19, 1, 1, 560),
            row(11, 15, feedback, 20, 21, 1, 1, 559),
            row(12, 14, feedback, 22, 23, 1, 1, 558),
            row(13, 13, feedback, 24, 25, 1, 1, 557),
            row(14, 12, feedback, 26, 27, 1, 1, 556),
            row(15, 11, feedback, 28, 29, 1, 1, 555),
            row(16, 9, feedback, 30, 31, 1, 1, 554),
            row(17, 8, feedback, 32, 33, 1, 1, 553),
            row(18, 7, feedback, 34, 35, 1, 1, 552),
            row(19, 10, ground, 0, 0, 0, 0, 0),
            row(20, 20, supply, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 19, oe, control, 0, 0, 0, 0, 2, no, no),
            row(1, 18, oe, control, 0, 0, 0, 0, 2, no, no),
            row(1, 17, oe, control, 0, 0, 0, 0, 2, no, no),
            row(1, 16, oe, control, 0, 0, 0, 0, 2, no, no),
            row(1, 0, array, control, 0, 432, 36, 1, 0, no, no),
            row(2, 15, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 14, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 13, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 12, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 0, array, control, 0, 468, 36, 1, 0, no, no),
            row(3, 11, oe, control, 0, 0, 0, 0, 2, no, no),
            row(3, 9, oe, control, 0, 0, 0, 0, 2, no, no),
            row(3, 8, oe, control, 0, 0, 0, 0, 2, no, no),
            row(3, 7, oe, control, 0, 0, 0, 0, 2, no, no),
            row(3, 0, array, control, 0, 504, 36, 1, 0, no, no),
            row(4, 7, array, programmable, 0, 0, 36, 1, 0, no, no),
            row(4, 7, none, programmable_positive, 1, 540, 1, 0, 0, yes, yes),
            row(4, 7, none, programmable_negative, 0, 540, 1, 0, 0, yes, yes),
            row(5, 8, array, programmable, 0, 36, 36, 1, 0, no, no),
            row(5, 8, none, programmable_positive, 1, 541, 1, 0, 0, yes, yes),
            row(5, 8, none, programmable_negative, 0, 541, 1, 0, 0, yes, yes),
            row(6, 9, array, programmable, 0, 72, 36, 1, 0, no, no),
            row(6, 9, none, programmable_positive, 1, 542, 1, 0, 0, yes, yes),
            row(6, 9, none, programmable_negative, 0, 542, 1, 0, 0, yes, yes),
            row(7, 11, array, programmable, 0, 108, 36, 1, 0, no, no),
            row(7, 11, none, programmable_positive, 1, 543, 1, 0, 0, yes, yes),
            row(7, 11, none, programmable_negative, 0, 543, 1, 0, 0, yes, yes),
            row(8, 12, array, programmable, 0, 144, 36, 1, 0, no, no),
            row(8, 12, none, programmable_positive, 1, 544, 1, 0, 0, yes, yes),
            row(8, 12, none, programmable_negative, 0, 544, 1, 0, 0, yes, yes),
            row(9, 13, array, programmable, 0, 180, 36, 1, 0, no, no),
            row(9, 13, none, programmable_positive, 1, 545, 1, 0, 0, yes, yes),
            row(9, 13, none, programmable_negative, 0, 545, 1, 0, 0, yes, yes),
            row(10, 14, array, programmable, 0, 216, 36, 1, 0, no, no),
            row(10, 14, none, programmable_positive, 1, 546, 1, 0, 0, yes, yes),
            row(10, 14, none, programmable_negative, 0, 546, 1, 0, 0, yes, yes),
            row(11, 15, array, programmable, 0, 252, 36, 1, 0, no, no),
            row(11, 15, none, programmable_positive, 1, 547, 1, 0, 0, yes, yes),
            row(11, 15, none, programmable_negative, 0, 547, 1, 0, 0, yes, yes),
            row(12, 16, array, programmable, 0, 288, 36, 1, 0, no, no),
            row(12, 16, none, programmable_positive, 1, 548, 1, 0, 0, yes, yes),
            row(12, 16, none, programmable_negative, 0, 548, 1, 0, 0, yes, yes),
            row(13, 17, array, programmable, 0, 324, 36, 1, 0, no, no),
            row(13, 17, none, programmable_positive, 1, 549, 1, 0, 0, yes, yes),
            row(13, 17, none, programmable_negative, 0, 549, 1, 0, 0, yes, yes),
            row(14, 18, array, programmable, 0, 360, 36, 1, 0, no, no),
            row(14, 18, none, programmable_positive, 1, 550, 1, 0, 0, yes, yes),
            row(14, 18, none, programmable_negative, 0, 550, 1, 0, 0, yes, yes),
            row(15, 19, array, programmable, 0, 396, 36, 1, 0, no, no),
            row(15, 19, none, programmable_positive, 1, 551, 1, 0, 0, yes, yes),
            row(15, 19, none, programmable_negative, 0, 551, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 552, 0, 0),
            row(setup_loop, 1, " ", 1, 1, 0, 540),
            row(text, 1, "*DIR", 0, 0, 0, 0),
            row(fuses_reverse, 1, "A.", 2, 0, 1, 12),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(text, 1, "*POL", 0, 0, 0, 0),
            row(fuses_reverse, 1, "LH", 0, 0, 1, 12),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(set, 2, " ", 7, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 12, 1, 0),
            row(print_two_digits, 2, "*P ", 7, 1, 0, 0),
            row(text, 2, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 0, 2, 12),
            row(text, 2, "*B", 0, 0, 0, 0),
            row(fuses_forward, 2, "0HL-", 1, 12, 2, 24),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 36),
            row(set, 3, " ", 7, 0, 0, 0),
            row(setup_loop, 3, " ", 8, 3, 1, 432),
            row(print_two_digits, 3, "*D ", 7, 1, 0, 0),
            row(text, 3, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 3, "0HL-", 1, 0, 2, 12),
            row(text, 3, "*B", 0, 0, 0, 0),
            row(fuses_forward, 3, "0HL-", 1, 12, 2, 24),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 1, 36),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 5, " ", 8, 15, 1, 0),
            row(address, 5, "", 1, 0, 0, 0),
            row(fuses_forward, 5, "0HL-", 1, 0, 2, 36),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 1, 36),
            row(setup_loop, 6, " ", 8, 1, 1, 540),
            row(address, 6, "", 1, 0, 0, 0),
            row(fuses_forward, 6, "LH", 1, 0, 1, 12),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(add, 6, " ", 1, 12, 0, 0),
            row(address, 6, "", 1, 0, 0, 0),
            row(fuses_forward, 6, "A.", 1, 0, 1, 12),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(end_row, 6, " ", 0, 0, 0, 0),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(1, 19, oe, 1, 1),
            row(15, 19, none, 1, 0),
            row(1, 18, oe, 2, 1),
            row(14, 18, none, 2, 0),
            row(1, 17, oe, 3, 1),
            row(13, 17, none, 3, 0),
            row(1, 16, oe, 4, 1),
            row(12, 16, none, 4, 0),
            row(2, 15, oe, 5, 1),
            row(11, 15, none, 5, 0),
            row(2, 14, oe, 6, 1),
            row(10, 14, none, 6, 0),
            row(2, 13, oe, 7, 1),
            row(9, 13, none, 7, 0),
            row(2, 12, oe, 8, 1),
            row(8, 12, none, 8, 0),
            row(3, 11, oe, 9, 1),
            row(7, 11, none, 9, 0),
            row(3, 9, oe, 10, 1),
            row(6, 9, none, 10, 0),
            row(3, 8, oe, 11, 1),
            row(5, 8, none, 11, 0),
            row(3, 7, oe, 12, 1),
            row(4, 7, none, 12, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
