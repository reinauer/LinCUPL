# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p1016rm4 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 2
        attribute_20 = 1
    }

    fuses {
        count = 2056
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 4
        clocked_resources = 4
        default_extension = none
        product_rows = 32
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 25
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 1
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 4
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "d"
            function = d
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, 24, 0, 0),
            row(2, 5, register_feedback, 0, 1),
            row(3, 23, unspecified, 2, 3),
            row(4, 2, unspecified, 4, 5),
            row(5, 22, unspecified, 6, 7),
            row(6, 3, unspecified, 8, 9),
            row(7, 21, unspecified, 10, 11),
            row(8, 4, unspecified, 12, 13),
            row(9, 17, unspecified, 14, 15),
            row(10, 8, unspecified, 16, 17),
            row(11, 20, register_feedback, 18, 19),
            row(12, 7, register_feedback, 20, 21),
            row(13, 15, unspecified, 22, 23),
            row(14, 10, unspecified, 24, 25),
            row(15, 14, unspecified, 26, 27),
            row(16, 11, unspecified, 28, 29),
            row(17, 18, register_feedback, 30, 31),
            row(18, 9, clock, 0, 0),
            row(19, 16, clock, 0, 0),
            row(20, 13, clock, 0, 0),
            row(21, 12, negative_supply, 0, 0),
            row(22, 6, supply, 0, 0),
            row(23, 19, supply, 0, 0),
            row(24, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, sharing_mode, active, legacy_width]
        rows = [
            row(1, 20, array, negative, 0, 512, 32, 8, 0, no, 32),
            row(1, 20, d, programmable_positive, 0, 2050, 1, 0, 0, yes, 0),
            row(1, 20, d, programmable_negative, 1, 2050, 1, 0, 0, yes, 0),
            row(1, 20, none, unspecified, 0, 0, 0, 0, 2, no, 0),
            row(2, 5, array, negative, 0, 768, 32, 8, 0, no, 32),
            row(2, 5, d, programmable_positive, 0, 2051, 1, 0, 0, yes, 0),
            row(2, 5, d, programmable_negative, 1, 2051, 1, 0, 0, yes, 0),
            row(2, 5, none, unspecified, 0, 0, 0, 0, 2, no, 0),
            row(3, 18, array, negative, 0, 1024, 32, 8, 0, no, 32),
            row(3, 18, d, programmable_positive, 0, 2052, 1, 0, 0, yes, 0),
            row(3, 18, d, programmable_negative, 1, 2052, 1, 0, 0, yes, 0),
            row(3, 18, none, unspecified, 0, 0, 0, 0, 2, no, 0),
            row(4, 7, array, negative, 0, 1280, 32, 8, 0, no, 32),
            row(4, 7, d, programmable_positive, 0, 2053, 1, 0, 0, yes, 0),
            row(4, 7, d, programmable_negative, 1, 2053, 1, 0, 0, yes, 0),
            row(4, 7, none, unspecified, 0, 0, 0, 0, 2, no, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, "", 0, 512, 0, 0),
            row(set, 1, "", 4, 2050, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 2, 20),
            row(if_equal, 1, " ", 1, 8, 0, 5),
            row(print_increment, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(set, 2, "", 4, 2051, 0, 0),
            row(setup_loop, 2, " ", 1, 8, 2, 5),
            row(if_equal, 2, " ", 1, 8, 0, 5),
            row(print_increment, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 32),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 32),
            row(set, 3, "", 4, 2052, 0, 0),
            row(setup_loop, 3, " ", 1, 8, 2, 18),
            row(if_equal, 3, " ", 1, 8, 0, 5),
            row(print_increment, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 32),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 32),
            row(set, 4, "", 4, 2053, 0, 0),
            row(setup_loop, 4, " ", 1, 8, 2, 7),
            row(if_equal, 4, " ", 1, 8, 0, 5),
            row(print_increment, 4, "Pin #", 2, 1, 0, 0),
            row(address, 4, " ", 4, 0, 0, 0),
            row(text, 4, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 4, 0, 1, 1),
            row(newline, 4, "", 1, 0, 0, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 32),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(18, 9, ck, 0, 1, 1),
            row(2, 5, d, 0, 0, 0),
            row(4, 7, d, 0, 0, 0),
            row(19, 16, ck, 1, 1, 1),
            row(1, 20, d, 1, 0, 0),
            row(3, 18, d, 1, 0, 0),
            row(20, 13, ck, 2, 1, 1),
            row(2, 5, d, 2, 0, 0),
            row(3, 18, d, 2, 0, 0),
            row(4, 7, d, 2, 0, 0),
            row(1, 20, d, 2, 0, 0),
            row(1, 1, extension_47, 3, 1, 1),
            row(1, 20, d, 3, 0, 0),
            row(2, 5, d, 3, 0, 0),
            row(3, 18, d, 3, 0, 0),
            row(4, 7, d, 3, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
