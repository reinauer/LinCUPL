# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p12p10 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 490
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 20
        initial_term_capacity = 40
        array_slots = 11
        input_line_slots = 15
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 6, unspecified, 10, 11),
            row(7, 7, unspecified, 12, 13),
            row(8, 8, unspecified, 14, 15),
            row(9, 9, unspecified, 16, 17),
            row(10, 10, unspecified, 18, 19),
            row(11, 11, unspecified, 20, 21),
            row(12, 13, unspecified, 22, 23),
            row(13, 12, ground, 0, 0),
            row(14, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, active, legacy_width]
        rows = [
            row(1, 23, array, negative, 0, 0, 24, 2, no, 40),
            row(1, 23, none, programmable_positive, 1, 480, 1, 0, yes, 0),
            row(1, 23, none, programmable_negative, 0, 480, 1, 0, yes, 0),
            row(2, 22, array, negative, 0, 48, 24, 2, no, 40),
            row(2, 22, none, programmable_positive, 1, 481, 1, 0, yes, 0),
            row(2, 22, none, programmable_negative, 0, 481, 1, 0, yes, 0),
            row(3, 21, array, negative, 0, 96, 24, 2, no, 40),
            row(3, 21, none, programmable_positive, 1, 482, 1, 0, yes, 0),
            row(3, 21, none, programmable_negative, 0, 482, 1, 0, yes, 0),
            row(4, 20, array, negative, 0, 144, 24, 2, no, 40),
            row(4, 20, none, programmable_positive, 1, 483, 1, 0, yes, 0),
            row(4, 20, none, programmable_negative, 0, 483, 1, 0, yes, 0),
            row(5, 19, array, negative, 0, 192, 24, 2, no, 40),
            row(5, 19, none, programmable_positive, 1, 484, 1, 0, yes, 0),
            row(5, 19, none, programmable_negative, 0, 484, 1, 0, yes, 0),
            row(6, 18, array, negative, 0, 240, 24, 2, no, 40),
            row(6, 18, none, programmable_positive, 1, 485, 1, 0, yes, 0),
            row(6, 18, none, programmable_negative, 0, 485, 1, 0, yes, 0),
            row(7, 17, array, negative, 0, 288, 24, 2, no, 40),
            row(7, 17, none, programmable_positive, 1, 486, 1, 0, yes, 0),
            row(7, 17, none, programmable_negative, 0, 486, 1, 0, yes, 0),
            row(8, 16, array, negative, 0, 336, 24, 2, no, 40),
            row(8, 16, none, programmable_positive, 1, 487, 1, 0, yes, 0),
            row(8, 16, none, programmable_negative, 0, 487, 1, 0, yes, 0),
            row(9, 15, array, negative, 0, 384, 24, 2, no, 40),
            row(9, 15, none, programmable_positive, 1, 488, 1, 0, yes, 0),
            row(9, 15, none, programmable_negative, 0, 488, 1, 0, yes, 0),
            row(10, 14, array, negative, 0, 432, 24, 2, no, 40),
            row(10, 14, none, programmable_positive, 1, 489, 1, 0, yes, 0),
            row(10, 14, none, programmable_negative, 0, 489, 1, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 23, 0, 0),
            row(setup_loop, 1, " ", 1, 20, 4, 480),
            row(loop, 1, " ", 7, 0, 2, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 24),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 24),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
