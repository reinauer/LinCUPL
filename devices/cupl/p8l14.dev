# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p8l14 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 224
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 16
        initial_term_capacity = 40
        array_slots = 15
        input_line_slots = 11
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 16
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 3, unspecified, 0, 1),
            row(2, 4, unspecified, 2, 3),
            row(3, 5, unspecified, 4, 5),
            row(4, 6, unspecified, 6, 7),
            row(5, 7, unspecified, 8, 9),
            row(6, 8, unspecified, 10, 11),
            row(7, 9, unspecified, 12, 13),
            row(8, 10, unspecified, 14, 15),
            row(9, 12, ground, 0, 0),
            row(10, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            polarity = negative
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, first_row_fuse, row_width, max_terms, active]
        rows = [
            row(1, 1, array, 0, 16, 1, no),
            row(1, 1, none, 0, 0, 0, yes),
            row(2, 23, array, 16, 16, 1, no),
            row(2, 23, none, 0, 0, 0, yes),
            row(3, 2, array, 32, 16, 1, no),
            row(3, 2, none, 0, 0, 0, yes),
            row(4, 22, array, 48, 16, 1, no),
            row(4, 22, none, 0, 0, 0, yes),
            row(5, 21, array, 64, 16, 1, no),
            row(5, 21, none, 0, 0, 0, yes),
            row(6, 20, array, 80, 16, 1, no),
            row(6, 20, none, 0, 0, 0, yes),
            row(7, 19, array, 96, 16, 1, no),
            row(7, 19, none, 0, 0, 0, yes),
            row(8, 18, array, 112, 16, 1, no),
            row(8, 18, none, 0, 0, 0, yes),
            row(9, 17, array, 128, 16, 1, no),
            row(9, 17, none, 0, 0, 0, yes),
            row(10, 16, array, 144, 16, 1, no),
            row(10, 16, none, 0, 0, 0, yes),
            row(11, 15, array, 160, 16, 1, no),
            row(11, 15, none, 0, 0, 0, yes),
            row(12, 14, array, 176, 16, 1, no),
            row(12, 14, none, 0, 0, 0, yes),
            row(13, 11, array, 192, 16, 1, no),
            row(13, 11, none, 0, 0, 0, yes),
            row(14, 13, array, 208, 16, 1, no),
            row(14, 13, none, 0, 0, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 1, 0, 0),
            row(setup_loop, 1, " ", 1, 1, 0, 0),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 16),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 16),
            row(setup_loop, 2, " ", 1, 1, 2, 23),
            row(print_decrement, 2, "Pin #", 2, 1, 1, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 16),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 16),
            row(setup_loop, 3, " ", 1, 1, 2, 2),
            row(print_increment, 3, "Pin #", 2, 1, 1, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 16),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 16),
            row(setup_loop, 4, " ", 1, 9, 2, 22),
            row(print_decrement, 4, "Pin #", 2, 1, 1, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 16),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 16),
            row(setup_loop, 5, " ", 1, 1, 2, 11),
            row(print_decrement, 5, "Pin #", 2, 1, 1, 0),
            row(address, 5, " ", 0, 0, 0, 0),
            row(fuses_forward, 5, "x-", 0, 0, 1, 16),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 0, 16),
            row(setup_loop, 6, " ", 1, 1, 2, 13),
            row(print_decrement, 6, "Pin #", 2, 1, 1, 0),
            row(address, 6, " ", 0, 0, 0, 0),
            row(fuses_forward, 6, "x-", 0, 0, 1, 16),
            row(newline, 6, " ", 1, 0, 0, 0),
            row(end_row, 6, " ", 0, 0, 0, 16),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
