# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f100 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 1928
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 10
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 48
        initial_term_capacity = 70
        array_slots = 2
        input_line_slots = 20
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 9, unspecified, 0, 1),
            row(2, 8, unspecified, 2, 3),
            row(3, 7, unspecified, 4, 5),
            row(4, 6, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 4, unspecified, 10, 11),
            row(7, 3, unspecified, 12, 13),
            row(8, 2, unspecified, 14, 15),
            row(9, 27, unspecified, 16, 17),
            row(10, 26, unspecified, 18, 19),
            row(11, 25, unspecified, 20, 21),
            row(12, 24, unspecified, 22, 23),
            row(13, 23, unspecified, 24, 25),
            row(14, 22, unspecified, 26, 27),
            row(15, 21, unspecified, 28, 29),
            row(16, 20, unspecified, 30, 31),
            row(17, 19, output_enable, 0, 0),
            row(18, 14, ground, 0, 0),
            row(19, 28, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            array = 1
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, active]
        rows = [
            row(18, none, programmable_positive, 0, 1920, 32, 1, 0, 0, yes),
            row(18, none, programmable_negative, 1, 1920, 32, 1, 0, 0, yes),
            row(17, none, programmable_positive, 0, 1921, 33, 1, 0, 0, yes),
            row(17, none, programmable_negative, 1, 1921, 33, 1, 0, 0, yes),
            row(16, none, programmable_positive, 0, 1922, 34, 1, 0, 0, yes),
            row(16, none, programmable_negative, 1, 1922, 34, 1, 0, 0, yes),
            row(15, none, programmable_positive, 0, 1923, 35, 1, 0, 0, yes),
            row(15, none, programmable_negative, 1, 1923, 35, 1, 0, 0, yes),
            row(13, none, programmable_positive, 0, 1924, 36, 1, 0, 0, yes),
            row(13, none, programmable_negative, 1, 1924, 36, 1, 0, 0, yes),
            row(12, none, programmable_positive, 0, 1925, 37, 1, 0, 0, yes),
            row(12, none, programmable_negative, 1, 1925, 37, 1, 0, 0, yes),
            row(11, none, programmable_positive, 0, 1926, 38, 1, 0, 0, yes),
            row(11, none, programmable_negative, 1, 1926, 38, 1, 0, 0, yes),
            row(10, none, programmable_positive, 0, 1927, 39, 1, 0, 0, yes),
            row(10, none, programmable_negative, 1, 1927, 39, 1, 0, 0, yes),
            row(0, array, programmable, 0, 0, 0, 32, 8, 48, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 1920),
            row(text, 1, "*A", 0, 0, 0, 0),
            row(fuses_reverse, 1, "HL", 0, 0, 1, 8),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 48, 1, 0),
            row(print_two_digits, 2, "*P ", 7, 1, 0, 0),
            row(text, 2, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 2, "0HL-", 1, 0, 2, 32),
            row(text, 2, "*F", 0, 0, 0, 0),
            row(fuses_reverse, 2, "A.", 1, 32, 1, 8),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 40),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 4, " ", 0, 0, 0, 0),
            row(setup_loop, 4, " ", 6, 1, 0, 1920),
            row(address, 4, "", 0, 0, 0, 0),
            row(text, 4, "POL    ", 0, 0, 0, 0),
            row(text, 4, "        ", 0, 0, 0, 0),
            row(fuses_forward, 4, "HL", 0, 0, 1, 8),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 0),
            row(setup_loop, 5, " ", 8, 48, 1, 0),
            row(address, 5, "", 1, 0, 0, 0),
            row(fuses_forward, 5, "0HL-", 1, 0, 2, 32),
            row(fuses_forward, 5, "A.", 1, 32, 1, 8),
            row(newline, 5, " ", 1, 0, 0, 0),
            row(end_row, 5, " ", 0, 0, 1, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 0
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(17, 19, oe_term, 1, 1),
            row(1, 18, none, 0, 0),
            row(1, 17, none, 0, 0),
            row(1, 16, none, 0, 0),
            row(1, 15, none, 0, 0),
            row(1, 13, none, 0, 0),
            row(1, 12, none, 0, 0),
            row(1, 11, none, 0, 0),
            row(1, 10, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
