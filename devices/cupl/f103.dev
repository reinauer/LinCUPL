# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f103 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 297
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 9
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 9
        initial_term_capacity = 70
        array_slots = 10
        input_line_slots = 20
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 9
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 8, unspecified, 0, 1),
            row(2, 7, unspecified, 2, 3),
            row(3, 6, unspecified, 4, 5),
            row(4, 5, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 3, unspecified, 10, 11),
            row(7, 2, unspecified, 12, 13),
            row(8, 1, unspecified, 14, 15),
            row(9, 27, unspecified, 16, 17),
            row(10, 26, unspecified, 18, 19),
            row(11, 25, unspecified, 20, 21),
            row(12, 24, unspecified, 22, 23),
            row(13, 23, unspecified, 24, 25),
            row(14, 22, unspecified, 26, 27),
            row(15, 21, unspecified, 28, 29),
            row(16, 20, unspecified, 30, 31),
            row(17, 19, output_enable, 0, 0),
            row(18, 14, ground, 0, 0),
            row(19, 28, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, active, legacy_width]
        rows = [
            row(1, 18, array, programmable, 0, 0, 32, 1, no, 32),
            row(1, 18, none, programmable_positive, 1, 32, 1, 0, yes, 0),
            row(1, 18, none, programmable_negative, 0, 32, 1, 0, yes, 0),
            row(2, 17, array, programmable, 0, 33, 32, 1, no, 32),
            row(2, 17, none, programmable_positive, 1, 65, 1, 0, yes, 0),
            row(2, 17, none, programmable_negative, 0, 65, 1, 0, yes, 0),
            row(3, 16, array, programmable, 0, 66, 32, 1, no, 32),
            row(3, 16, none, programmable_positive, 1, 98, 1, 0, yes, 0),
            row(3, 16, none, programmable_negative, 0, 98, 1, 0, yes, 0),
            row(4, 15, array, programmable, 0, 99, 32, 1, no, 32),
            row(4, 15, none, programmable_positive, 1, 131, 1, 0, yes, 0),
            row(4, 15, none, programmable_negative, 0, 131, 1, 0, yes, 0),
            row(5, 13, array, programmable, 0, 132, 32, 1, no, 32),
            row(5, 13, none, programmable_positive, 1, 164, 1, 0, yes, 0),
            row(5, 13, none, programmable_negative, 0, 164, 1, 0, yes, 0),
            row(6, 12, array, programmable, 0, 165, 32, 1, no, 32),
            row(6, 12, none, programmable_positive, 1, 197, 1, 0, yes, 0),
            row(6, 12, none, programmable_negative, 0, 197, 1, 0, yes, 0),
            row(7, 11, array, programmable, 0, 198, 32, 1, no, 32),
            row(7, 11, none, programmable_positive, 1, 230, 1, 0, yes, 0),
            row(7, 11, none, programmable_negative, 0, 230, 1, 0, yes, 0),
            row(8, 10, array, programmable, 0, 231, 32, 1, no, 32),
            row(8, 10, none, programmable_positive, 1, 263, 1, 0, yes, 0),
            row(8, 10, none, programmable_negative, 0, 263, 1, 0, yes, 0),
            row(9, 9, array, programmable, 0, 264, 32, 1, no, 32),
            row(9, 9, none, programmable_positive, 1, 296, 1, 0, yes, 0),
            row(9, 9, none, programmable_negative, 0, 296, 1, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_hl, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 7, 0, 0, 0),
            row(setup_loop, 1, " ", 8, 9, 1, 0),
            row(print_two_digits, 1, "*G ", 7, 1, 0, 0),
            row(text, 1, "*A", 0, 0, 0, 0),
            row(fuses_forward, 1, "LH", 1, 32, 1, 1),
            row(text, 1, "*I", 0, 0, 0, 0),
            row(fuses_reverse, 1, "0HL-", 1, 0, 2, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 1, 33),
            row(end, 0, "", 0, 0, 0, 0),
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 3, " ", 8, 9, 1, 0),
            row(address, 3, "", 1, 0, 0, 0),
            row(fuses_forward, 3, "0HL-", 1, 0, 2, 32),
            row(fuses_forward, 3, "LH", 1, 32, 1, 1),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 1, 33),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 0
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(17, 19, oe_term, 1, 1),
            row(1, 18, none, 0, 0),
            row(2, 17, none, 0, 0),
            row(3, 16, none, 0, 0),
            row(4, 15, none, 0, 0),
            row(5, 13, none, 0, 0),
            row(6, 12, none, 0, 0),
            row(7, 11, none, 0, 0),
            row(8, 10, none, 0, 0),
            row(9, 9, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
