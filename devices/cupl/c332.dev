# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device c332 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 24
    }

    power {
        ground = 8
        supply = 22
    }

    fuses {
        count = 9902
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 43
        clocked_resources = 26
        default_extension = none
        product_rows = 194
        initial_term_capacity = 340
        array_slots = 1
        input_line_slots = 41
        extra_symbols = 70
        download = jedec
    }

    simulation {
        output_enable_mode = 4
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 12
    }

    fitter {
        input_format = 6
        name = "cupl2cyp"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("dq", dq),
            row("lq", lq),
            row("lemux", lemux),
            row("oe", oe),
            row("iockmux", iockmux),
            row("ckmux", ckmux),
            row("oemux", oemux),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
        }
        columns = [line, pin, function, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, none, clock_input, 0, 1, 0, 0, 9600),
            row(1, 1, none, 21, 0, 1, 0, 0, 9600),
            row(1, 1, dq, unspecified, 0, 1, 3, 2, 9600),
            row(1, 1, lq, unspecified, 0, 1, 2, 2, 9600),
