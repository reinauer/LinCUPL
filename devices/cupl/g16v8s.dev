# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g16v8s {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2194
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2056
    }

    compiler {
        revision = 9
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 19
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
        }
        columns = [line, pin, compiler_type, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 2, unspecified, 0, 1, 0, 0, 0),
            row(2, 1, unspecified, 2, 3, 0, 0, 0),
            row(3, 3, unspecified, 4, 5, 0, 0, 0),
            row(4, 19, unspecified, 6, 7, 1, 1, 2120),
            row(5, 4, unspecified, 8, 9, 0, 0, 0),
            row(6, 18, unspecified, 10, 11, 1, 1, 2121),
            row(7, 5, unspecified, 12, 13, 0, 0, 0),
            row(8, 17, unspecified, 14, 15, 1, 1, 2122),
            row(9, 6, unspecified, 16, 17, 0, 0, 0),
            row(10, 14, unspecified, 18, 19, 1, 1, 2125),
            row(11, 7, unspecified, 20, 21, 0, 0, 0),
            row(12, 13, unspecified, 22, 23, 1, 1, 2126),
            row(13, 8, unspecified, 24, 25, 0, 0, 0),
            row(14, 12, unspecified, 26, 27, 1, 1, 2127),
            row(15, 9, unspecified, 28, 29, 0, 0, 0),
            row(16, 11, unspecified, 30, 31, 0, 0, 0),
            row(17, 10, ground, 0, 0, 0, 0, 0),
            row(18, 20, supply, 0, 0, 0, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, active, legacy_width]
        rows = [
            row(1, 19, array, negative, 0, 0, 0, 32, 0, 8, no, no, 32),
            row(1, 19, none, programmable_positive, 1, 2048, 2120, 1, 1, 0, yes, yes, 0),
            row(1, 19, none, programmable_negative, 0, 2048, 2120, 1, 1, 0, yes, yes, 0),
            row(2, 18, array, negative, 0, 256, 0, 32, 0, 8, no, no, 32),
            row(2, 18, none, programmable_positive, 1, 2049, 2121, 1, 1, 0, yes, yes, 0),
            row(2, 18, none, programmable_negative, 0, 2049, 2121, 1, 1, 0, yes, yes, 0),
            row(3, 17, array, negative, 0, 512, 0, 32, 0, 8, no, no, 32),
            row(3, 17, none, programmable_positive, 1, 2050, 2122, 1, 1, 0, yes, yes, 0),
            row(3, 17, none, programmable_negative, 0, 2050, 2122, 1, 1, 0, yes, yes, 0),
            row(4, 16, array, negative, 0, 768, 0, 32, 0, 8, no, no, 32),
            row(4, 16, none, programmable_positive, 1, 2051, 2123, 1, 1, 0, yes, yes, 0),
            row(4, 16, none, programmable_negative, 0, 2051, 2123, 1, 1, 0, yes, yes, 0),
            row(5, 15, array, negative, 0, 1024, 0, 32, 0, 8, no, no, 32),
            row(5, 15, none, programmable_positive, 1, 2052, 2124, 1, 1, 0, yes, yes, 0),
            row(5, 15, none, programmable_negative, 0, 2052, 2124, 1, 1, 0, yes, yes, 0),
            row(6, 14, array, negative, 0, 1280, 0, 32, 0, 8, no, no, 32),
            row(6, 14, none, programmable_positive, 1, 2053, 2125, 1, 1, 0, yes, yes, 0),
            row(6, 14, none, programmable_negative, 0, 2053, 2125, 1, 1, 0, yes, yes, 0),
            row(7, 13, array, negative, 0, 1536, 0, 32, 0, 8, no, no, 32),
            row(7, 13, none, programmable_positive, 1, 2054, 2126, 1, 1, 0, yes, yes, 0),
            row(7, 13, none, programmable_negative, 0, 2054, 2126, 1, 1, 0, yes, yes, 0),
            row(8, 12, array, negative, 0, 1792, 0, 32, 0, 8, no, no, 32),
            row(8, 12, none, programmable_positive, 1, 2055, 2127, 1, 1, 0, yes, yes, 0),
            row(8, 12, none, programmable_negative, 0, 2055, 2127, 1, 1, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2192),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2048, 0, 0),
            row(set, 1, " ", 5, 2120, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 9),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2056, 2119, 0),
            row(2120, 2127, 1),
            row(2128, 2191, 1),
            row(2192, 2192, 1),
            row(2193, 2193, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
