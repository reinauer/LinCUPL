# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20xrp10 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 3210
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 11
        input_line_slots = 25
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "d"
            function = d
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 23, register_feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 22, register_feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 21, register_feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 20, register_feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 19, register_feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 18, register_feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 17, register_feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 16, register_feedback, 30, 31),
            row(18, 10, unspecified, 32, 33),
            row(19, 15, register_feedback, 34, 35),
            row(20, 11, unspecified, 36, 37),
            row(21, 14, register_feedback, 38, 39),
            row(22, 12, ground, 0, 0),
            row(23, 24, supply, 0, 0),
            row(24, 13, output_enable, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            default_rule = 0
            has_default = no
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, split_terms, sharing_mode, active]
        rows = [
            row(1, 23, array, negative, 0, 0, 40, 8, 2, 0, no),
            row(1, 23, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(1, 23, d, programmable_positive, 1, 3200, 1, 0, 0, 0, yes),
            row(1, 23, d, programmable_negative, 0, 3200, 1, 0, 0, 0, yes),
            row(2, 22, array, negative, 0, 320, 40, 8, 2, 0, no),
            row(2, 22, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(2, 22, d, programmable_positive, 1, 3201, 1, 0, 0, 0, yes),
            row(2, 22, d, programmable_negative, 0, 3201, 1, 0, 0, 0, yes),
            row(3, 21, array, negative, 0, 640, 40, 8, 2, 0, no),
            row(3, 21, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(3, 21, d, programmable_positive, 1, 3202, 1, 0, 0, 0, yes),
            row(3, 21, d, programmable_negative, 0, 3202, 1, 0, 0, 0, yes),
            row(4, 20, array, negative, 0, 960, 40, 8, 2, 0, no),
            row(4, 20, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(4, 20, d, programmable_positive, 1, 3203, 1, 0, 0, 0, yes),
            row(4, 20, d, programmable_negative, 0, 3203, 1, 0, 0, 0, yes),
            row(5, 19, array, negative, 0, 1280, 40, 8, 2, 0, no),
            row(5, 19, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(5, 19, d, programmable_positive, 1, 3204, 1, 0, 0, 0, yes),
            row(5, 19, d, programmable_negative, 0, 3204, 1, 0, 0, 0, yes),
            row(6, 18, array, negative, 0, 1600, 40, 8, 2, 0, no),
            row(6, 18, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(6, 18, d, programmable_positive, 1, 3205, 1, 0, 0, 0, yes),
            row(6, 18, d, programmable_negative, 0, 3205, 1, 0, 0, 0, yes),
            row(7, 17, array, negative, 0, 1920, 40, 8, 2, 0, no),
            row(7, 17, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(7, 17, d, programmable_positive, 1, 3206, 1, 0, 0, 0, yes),
            row(7, 17, d, programmable_negative, 0, 3206, 1, 0, 0, 0, yes),
            row(8, 16, array, negative, 0, 2240, 40, 8, 2, 0, no),
            row(8, 16, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(8, 16, d, programmable_positive, 1, 3207, 1, 0, 0, 0, yes),
            row(8, 16, d, programmable_negative, 0, 3207, 1, 0, 0, 0, yes),
            row(9, 15, array, negative, 0, 2560, 40, 8, 2, 0, no),
            row(9, 15, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(9, 15, d, programmable_positive, 1, 3208, 1, 0, 0, 0, yes),
            row(9, 15, d, programmable_negative, 0, 3208, 1, 0, 0, 0, yes),
            row(10, 14, array, negative, 0, 2880, 40, 8, 2, 0, no),
            row(10, 14, none, unspecified, 0, 0, 0, 0, 0, 2, no),
            row(10, 14, d, programmable_positive, 1, 3209, 1, 0, 0, 0, yes),
            row(10, 14, d, programmable_negative, 0, 3209, 1, 0, 0, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 23, 0, 0),
            row(setup_loop, 1, " ", 1, 80, 4, 3200),
            row(loop, 1, " ", 3, 0, 8, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(add, 1, " ", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(1, 1, ck, 0, 1, 1),
            row(1, 23, d, 0, 0, 0),
            row(2, 22, d, 0, 0, 0),
            row(3, 21, d, 0, 0, 0),
            row(4, 20, d, 0, 0, 0),
            row(5, 19, d, 0, 0, 0),
            row(6, 18, d, 0, 0, 0),
            row(7, 17, d, 0, 0, 0),
            row(8, 16, d, 0, 0, 0),
            row(9, 15, d, 0, 0, 0),
            row(10, 14, d, 0, 0, 0),
            row(24, 13, oe_term, 1, 1, 1),
            row(1, 23, d, 1, 0, 0),
            row(2, 22, d, 1, 0, 0),
            row(3, 21, d, 1, 0, 0),
            row(4, 20, d, 1, 0, 0),
            row(5, 19, d, 1, 0, 0),
            row(6, 18, d, 1, 0, 0),
            row(7, 17, d, 1, 0, 0),
            row(8, 16, d, 1, 0, 0),
            row(9, 15, d, 1, 0, 0),
            row(10, 14, d, 1, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
