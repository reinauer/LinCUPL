# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p14h4 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 448
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 16
        initial_term_capacity = 40
        array_slots = 5
        input_line_slots = 17
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 4
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 8, 9),
            row(5, 5, unspecified, 12, 13),
            row(6, 6, unspecified, 14, 15),
            row(7, 7, unspecified, 16, 17),
            row(8, 8, unspecified, 20, 21),
            row(9, 9, unspecified, 24, 25),
            row(10, 10, ground, 0, 0),
            row(11, 11, unspecified, 26, 27),
            row(12, 12, unspecified, 22, 23),
            row(13, 13, unspecified, 18, 19),
            row(14, 18, unspecified, 10, 11),
            row(15, 19, unspecified, 6, 7),
            row(16, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, active]
        rows = [
            row(1, 17, array, negative, 0, 28, 4, no),
            row(1, 17, none, positive, 0, 0, 0, yes),
            row(2, 16, array, negative, 112, 28, 4, no),
            row(2, 16, none, positive, 0, 0, 0, yes),
            row(3, 15, array, negative, 224, 28, 4, no),
            row(3, 15, none, positive, 0, 0, 0, yes),
            row(4, 14, array, negative, 336, 28, 4, no),
            row(4, 14, none, positive, 0, 0, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 17, 0, 0),
            row(setup_loop, 1, " ", 1, 16, 0, 0),
            row(loop, 1, " ", 3, 0, 4, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 28),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 28),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
