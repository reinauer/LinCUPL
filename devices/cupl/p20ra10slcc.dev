# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20ra10slcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 3210
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 15
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 80
        initial_term_capacity = 140
        array_slots = 52
        input_line_slots = 24
        extra_symbols = 30
        download = jedec
    }

    simulation {
        output_enable_mode = 3
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d_special),
            row("ar", ar),
            row("ap", ap),
            row("ck", ck),
            row("io", io),
        ]
    }

    pin_functions {
