            row(15, none, 9, 0),
            row(22, oe, 10, 1),
            row(22, none, 10, 0),
            row(21, oe, 11, 1),
            row(21, none, 11, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
