# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16rp6v {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2072
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 6
        clocked_resources = 6
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 11
        input_line_slots = 21
        extra_symbols = 2
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 19, feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 18, register_feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 17, register_feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 16, register_feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 15, register_feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 14, register_feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 13, register_feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 12, feedback, 30, 31),
            row(18, 11, output_enable, 0, 0),
            row(19, 10, ground, 0, 0),
            row(20, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, invert, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active, legacy_width]
        rows = [
            row(1, 19, array, control, no, 0, 0, 32, 1, 0, no, 0, no, 32),
            row(1, 19, oe, control, no, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(2, 19, array, negative, no, 0, 32, 32, 7, 0, no, 0, no, 32),
            row(2, 19, none, programmable_positive, no, 1, 2050, 1, 0, 0, yes, 0, yes, 0),
            row(2, 19, none, programmable_negative, no, 0, 2050, 1, 0, 0, yes, 0, yes, 0),
            row(3, 18, array, negative, no, 0, 256, 32, 8, 0, no, 0, no, 32),
            row(3, 18, d, programmable_positive, yes, 1, 2053, 1, 0, 0, no, 0, yes, 0),
            row(3, 18, d, programmable_negative, no, 0, 2053, 1, 0, 0, no, 0, yes, 0),
            row(3, 18, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(4, 17, array, negative, no, 0, 512, 32, 8, 0, no, 0, no, 32),
            row(4, 17, d, programmable_positive, yes, 1, 2056, 1, 0, 0, no, 0, yes, 0),
            row(4, 17, d, programmable_negative, no, 0, 2056, 1, 0, 0, no, 0, yes, 0),
            row(4, 17, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(5, 16, array, negative, no, 0, 768, 32, 8, 0, no, 0, no, 32),
            row(5, 16, d, programmable_positive, yes, 1, 2059, 1, 0, 0, no, 0, yes, 0),
            row(5, 16, d, programmable_negative, no, 0, 2059, 1, 0, 0, no, 0, yes, 0),
            row(5, 16, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(6, 15, array, negative, no, 0, 1024, 32, 8, 0, no, 0, no, 32),
            row(6, 15, d, programmable_positive, yes, 1, 2062, 1, 0, 0, no, 0, yes, 0),
            row(6, 15, d, programmable_negative, no, 0, 2062, 1, 0, 0, no, 0, yes, 0),
            row(6, 15, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(7, 14, array, negative, no, 0, 1280, 32, 8, 0, no, 0, no, 32),
            row(7, 14, d, programmable_positive, yes, 1, 2065, 1, 0, 0, no, 0, yes, 0),
            row(7, 14, d, programmable_negative, no, 0, 2065, 1, 0, 0, no, 0, yes, 0),
            row(7, 14, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(8, 13, array, negative, no, 0, 1536, 32, 8, 0, no, 0, no, 32),
            row(8, 13, d, programmable_positive, yes, 1, 2068, 1, 0, 0, no, 0, yes, 0),
            row(8, 13, d, programmable_negative, no, 0, 2068, 1, 0, 0, no, 0, yes, 0),
            row(8, 13, none, unspecified, no, 0, 0, 0, 0, 0, no, 2, no, 0),
            row(9, 12, array, control, no, 0, 1792, 32, 1, 0, no, 0, no, 32),
            row(9, 12, oe, control, no, 0, 0, 0, 0, 2, no, 0, no, 0),
            row(10, 12, array, negative, no, 0, 1824, 32, 7, 0, no, 0, no, 32),
            row(10, 12, none, programmable_positive, no, 1, 2071, 1, 0, 0, yes, 0, yes, 0),
            row(10, 12, none, programmable_negative, no, 0, 2071, 1, 0, 0, yes, 0, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 4, 2048),
            row(loop, 1, " ", 7, 0, 8, 9),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Mode", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 2),
            row(add, 1, "", 4, 2, 0, 0),
            row(text, 1, "Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        defaults {
            value = 0
        }
        columns = [first_fuse, last_fuse]
        rows = [
            row(2048, 2048),
            row(2049, 2049),
            row(2051, 2051),
            row(2052, 2052),
            row(2054, 2054),
            row(2055, 2055),
            row(2057, 2057),
            row(2058, 2058),
            row(2060, 2060),
            row(2061, 2061),
            row(2063, 2063),
            row(2064, 2064),
            row(2066, 2066),
            row(2067, 2067),
            row(2069, 2069),
            row(2070, 2070),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 19, oe, 0, 1, 0, yes),
            row(2, 19, none, 0, 0, 0, yes),
            row(9, 12, oe, 1, 1, 0, yes),
            row(10, 12, none, 1, 0, 0, yes),
            row(1, 1, ck, 2, 1, 1, no),
            row(3, 18, d, 2, 0, 0, no),
            row(4, 17, d, 2, 0, 0, no),
            row(5, 16, d, 2, 0, 0, no),
            row(6, 15, d, 2, 0, 0, no),
            row(7, 14, d, 2, 0, 0, no),
            row(8, 13, d, 2, 0, 0, no),
            row(18, 11, oe_term, 3, 1, 1, no),
            row(3, 18, d, 3, 0, 0, no),
            row(4, 17, d, 3, 0, 0, no),
            row(5, 16, d, 3, 0, 0, no),
            row(6, 15, d, 3, 0, 0, no),
            row(7, 14, d, 3, 0, 0, no),
            row(8, 13, d, 3, 0, 0, no),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
