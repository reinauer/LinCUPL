# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device pc508 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 256
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 8
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 21
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = l
        next_alternate = none
        next_count = 1
        input_function = l
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "l"
            function = l
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 15, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 3, unspecified, 2, 3),
            row(4, 6, unspecified, 4, 5),
            row(5, 7, unspecified, 6, 7),
            row(6, 10, unspecified, 8, 9),
            row(7, 11, unspecified, 10, 11),
            row(8, 16, unspecified, 12, 13),
            row(9, 17, unspecified, 14, 15),
            row(10, 26, unspecified, 16, 17),
            row(11, 27, unspecified, 18, 19),
            row(12, 12, unspecified, 20, 21),
            row(13, 13, unspecified, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 9, unspecified, 26, 27),
            row(16, 4, unspecified, 28, 29),
            row(17, 5, unspecified, 30, 31),
            row(18, 18, not_connected, 0, 0),
            row(19, 19, not_connected, 0, 0),
            row(20, 20, not_connected, 0, 0),
            row(21, 21, not_connected, 0, 0),
            row(22, 22, not_connected, 0, 0),
            row(23, 23, not_connected, 0, 0),
            row(24, 24, not_connected, 0, 0),
            row(25, 25, not_connected, 0, 0),
            row(26, 14, ground, 0, 0),
            row(27, 1, supply, 0, 0),
            row(28, 28, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            polarity = negative
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, first_row_fuse, row_width, max_terms, has_default, active]
        rows = [
            row(1, 18, l, 0, 0, 0, yes, yes),
            row(1, 18, array, 0, 32, 1, no, no),
            row(2, 19, l, 0, 0, 0, yes, yes),
            row(2, 19, array, 32, 32, 1, no, no),
            row(3, 20, l, 0, 0, 0, yes, yes),
            row(3, 20, array, 64, 32, 1, no, no),
            row(4, 21, l, 0, 0, 0, yes, yes),
            row(4, 21, array, 96, 32, 1, no, no),
            row(5, 22, l, 0, 0, 0, yes, yes),
            row(5, 22, array, 128, 32, 1, no, no),
            row(6, 23, l, 0, 0, 0, yes, yes),
            row(6, 23, array, 160, 32, 1, no, no),
            row(7, 24, l, 0, 0, 0, yes, yes),
            row(7, 24, array, 192, 32, 1, no, no),
            row(8, 25, l, 0, 0, 0, yes, yes),
            row(8, 25, array, 224, 32, 1, no, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 18, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 0, 0),
            row(print_increment, 1, "Pin #", 2, 1, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 1
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(1, 15, le, 1, 1),
            row(1, 18, l, 0, 0),
            row(2, 19, l, 0, 0),
            row(3, 20, l, 0, 0),
            row(4, 21, l, 0, 0),
            row(5, 22, l, 0, 0),
            row(6, 23, l, 0, 0),
            row(7, 24, l, 0, 0),
            row(8, 25, l, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
