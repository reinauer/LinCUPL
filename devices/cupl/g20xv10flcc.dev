# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20xv10flcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 1671
        default = 0
    }

    signature {
        bits = 40
        first_fuse = 1631
    }

    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 40
        initial_term_capacity = 70
        array_slots = 31
        input_line_slots = 29
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 10
