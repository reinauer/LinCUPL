# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device c374t {
    representation = library

    package {
        pins = 100
        drawing_style = 12
        internal_nodes = 64
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 15552
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 64
        extra_nodes_c = 0
        register_resources = 64
        clocked_resources = 64
        default_extension = none
        product_rows = 280
        initial_term_capacity = 300
        array_slots = 217
        input_line_slots = 149
        extra_symbols = 128
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 1
        power_up = low
        preload_polarity = 1
    }

    prom {
        address_bits = 0
        data_width = 64
    }

    fitter {
        input_format = 6
        name = "cy37xfit"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("", none),
            row("l", l),
            row("dq", dq),
            row("lq", lq),
            row("ap", ap),
            row("ar", ar),
            row("ck", ck),
            row("ckmux", ckmux),
            row("le", le),
            row("lemux", lemux),
            row("oe", oe),
            row("oemux", oemux),
            row("int", int),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "CMB"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type, variant]
        rows = [
            row(0, 0, none, not_connected, default),
            row(1, 1, none, not_connected, default),
            row(2, 2, none, ground, default),
            row(3, 3, none, feedback, default),
            row(3, 3, none, registered, d),
            row(3, 3, none, registered, t),
            row(3, 3, int, register_feedback, default),
