# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p1020rp4 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2568
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 4
        clocked_resources = 4
        default_extension = none
        product_rows = 32
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 29
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 1
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 4
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "d"
            function = d
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 27, unspecified, 2, 3),
            row(3, 2, unspecified, 4, 5),
            row(4, 26, unspecified, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 25, unspecified, 10, 11),
            row(7, 4, unspecified, 12, 13),
            row(8, 24, register_feedback, 14, 15),
            row(9, 5, unspecified, 16, 17),
            row(10, 22, register_feedback, 18, 19),
            row(11, 6, register_feedback, 20, 21),
            row(12, 21, unspecified, 22, 23),
            row(13, 8, register_feedback, 24, 25),
            row(14, 18, unspecified, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 17, unspecified, 30, 31),
            row(17, 12, unspecified, 32, 33),
            row(18, 16, unspecified, 34, 35),
            row(19, 13, unspecified, 36, 37),
            row(20, 15, unspecified, 38, 39),
            row(21, 11, clock, 0, 0),
            row(22, 19, clock, 0, 0),
            row(23, 10, unspecified, 0, 0),
            row(24, 20, unspecified, 0, 0),
            row(25, 14, negative_supply, 0, 0),
            row(26, 7, supply, 0, 0),
            row(27, 23, supply, 0, 0),
            row(28, 28, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, invert, select_value, first_row_fuse, row_width, max_terms, has_default, active, legacy_width]
        rows = [
            row(1, 24, array, negative, no, 0, 640, 40, 8, no, no, 40),
            row(1, 24, d, programmable_positive, yes, 1, 2562, 1, 0, yes, yes, 0),
            row(1, 24, d, programmable_negative, yes, 0, 2562, 1, 0, yes, yes, 0),
            row(2, 6, array, negative, no, 0, 960, 40, 8, no, no, 40),
            row(2, 6, d, programmable_positive, yes, 1, 2563, 1, 0, yes, yes, 0),
            row(2, 6, d, programmable_negative, yes, 0, 2563, 1, 0, yes, yes, 0),
            row(3, 22, array, negative, no, 0, 1280, 40, 8, no, no, 40),
            row(3, 22, d, programmable_positive, yes, 1, 2564, 1, 0, yes, yes, 0),
            row(3, 22, d, programmable_negative, yes, 0, 2564, 1, 0, yes, yes, 0),
            row(4, 8, array, negative, no, 0, 1600, 40, 8, no, no, 40),
            row(4, 8, d, programmable_positive, yes, 1, 2565, 1, 0, yes, yes, 0),
            row(4, 8, d, programmable_negative, yes, 0, 2565, 1, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, "", 0, 640, 0, 0),
            row(set, 1, "", 4, 2562, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 2, 24),
            row(if_equal, 1, " ", 1, 8, 0, 5),
            row(print_increment, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(set, 2, "", 4, 2563, 0, 0),
            row(setup_loop, 2, " ", 1, 8, 2, 6),
            row(if_equal, 2, " ", 1, 8, 0, 5),
            row(print_increment, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(set, 3, "", 4, 2564, 0, 0),
            row(setup_loop, 3, " ", 1, 8, 2, 22),
            row(if_equal, 3, " ", 1, 8, 0, 5),
            row(print_increment, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 40),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 40),
            row(set, 4, "", 4, 2565, 0, 0),
            row(setup_loop, 4, " ", 1, 8, 2, 8),
            row(if_equal, 4, " ", 1, 8, 0, 5),
            row(print_increment, 4, "Pin #", 2, 1, 0, 0),
            row(address, 4, " ", 4, 0, 0, 0),
            row(text, 4, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 4, 0, 1, 1),
            row(newline, 4, "", 1, 0, 0, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 40),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(21, 11, ck, 0, 1, 1),
            row(1, 24, d, 0, 0, 0),
            row(2, 6, d, 0, 0, 0),
            row(3, 22, d, 0, 0, 0),
            row(4, 8, d, 0, 0, 0),
            row(22, 19, ck, 1, 1, 1),
            row(1, 24, d, 1, 0, 0),
            row(2, 6, d, 1, 0, 0),
            row(3, 22, d, 1, 0, 0),
            row(4, 8, d, 1, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
