# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device mapl128 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 11
    }

    power {
        ground = 12
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 14833
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 27
        clocked_resources = 16
        default_extension = none
        product_rows = 132
        initial_term_capacity = 200
        array_slots = 23
        input_line_slots = 40
        extra_symbols = 75
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d_enabled
        next_alternate = ce
        next_count = 2
        input_function = d_enabled
        input_alternate = ce
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 16
    }

    fitter {
        input_format = 3
        name = "mapl2jed"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        columns = [name, function]
