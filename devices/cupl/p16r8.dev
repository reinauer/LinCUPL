# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16r8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2048
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 10
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 10
        input_line_slots = 21
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 0
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "d"
            function = d
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, clock, 0, 0),
            row(2, 2, unspecified, 0, 1),
            row(3, 19, register_feedback, 2, 3),
            row(4, 3, unspecified, 4, 5),
            row(5, 18, register_feedback, 6, 7),
            row(6, 4, unspecified, 8, 9),
            row(7, 17, register_feedback, 10, 11),
            row(8, 5, unspecified, 12, 13),
            row(9, 16, register_feedback, 14, 15),
            row(10, 6, unspecified, 16, 17),
            row(11, 15, register_feedback, 18, 19),
            row(12, 7, unspecified, 20, 21),
            row(13, 14, register_feedback, 22, 23),
            row(14, 8, unspecified, 24, 25),
            row(15, 13, register_feedback, 26, 27),
            row(16, 9, unspecified, 28, 29),
            row(17, 12, register_feedback, 30, 31),
            row(18, 10, ground, 0, 0),
            row(19, 20, supply, 0, 0),
            row(20, 11, output_enable, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, sharing_mode, active]
        rows = [
            row(1, 19, array, negative, 0, 32, 8, 0, no),
            row(1, 19, none, unspecified, 0, 0, 0, 2, no),
            row(1, 19, d, negative, 0, 0, 0, 0, yes),
            row(2, 18, array, negative, 256, 32, 8, 0, no),
            row(2, 18, none, unspecified, 0, 0, 0, 2, no),
            row(2, 18, d, negative, 0, 0, 0, 0, yes),
            row(3, 17, array, negative, 512, 32, 8, 0, no),
            row(3, 17, none, unspecified, 0, 0, 0, 2, no),
            row(3, 17, d, negative, 0, 0, 0, 0, yes),
            row(4, 16, array, negative, 768, 32, 8, 0, no),
            row(4, 16, none, unspecified, 0, 0, 0, 2, no),
            row(4, 16, d, negative, 0, 0, 0, 0, yes),
            row(5, 15, array, negative, 1024, 32, 8, 0, no),
            row(5, 15, none, unspecified, 0, 0, 0, 2, no),
            row(5, 15, d, negative, 0, 0, 0, 0, yes),
            row(6, 14, array, negative, 1280, 32, 8, 0, no),
            row(6, 14, none, unspecified, 0, 0, 0, 2, no),
            row(6, 14, d, negative, 0, 0, 0, 0, yes),
            row(7, 13, array, negative, 1536, 32, 8, 0, no),
            row(7, 13, none, unspecified, 0, 0, 0, 2, no),
            row(7, 13, d, negative, 0, 0, 0, 0, yes),
            row(8, 12, array, negative, 1792, 32, 8, 0, no),
            row(8, 12, none, unspecified, 0, 0, 0, 2, no),
            row(8, 12, d, negative, 0, 0, 0, 0, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 1),
            row(print_decrement, 1, "Pin #", 2, 1, 1, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(1, 1, ck, 0, 1, 1),
            row(1, 19, d, 0, 0, 0),
            row(2, 18, d, 0, 0, 0),
            row(3, 17, d, 0, 0, 0),
            row(4, 16, d, 0, 0, 0),
            row(5, 15, d, 0, 0, 0),
            row(6, 14, d, 0, 0, 0),
            row(7, 13, d, 0, 0, 0),
            row(8, 12, d, 0, 0, 0),
            row(19, 11, oe_term, 1, 1, 1),
            row(1, 19, d, 1, 0, 0),
            row(2, 18, d, 1, 0, 0),
            row(3, 17, d, 1, 0, 0),
            row(4, 16, d, 1, 0, 0),
            row(5, 15, d, 1, 0, 0),
            row(6, 14, d, 1, 0, 0),
            row(7, 13, d, 1, 0, 0),
            row(8, 12, d, 1, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
