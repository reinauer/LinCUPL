# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f18v8zs {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 1
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2689
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 7
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 72
        initial_term_capacity = 70
        array_slots = 17
        input_line_slots = 21
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column, config_bits, config_first_fuse]
        rows = [
            row(1, 1, unspecified, 32, 33, 0, 0),
            row(2, 2, unspecified, 0, 1, 0, 0),
            row(3, 3, unspecified, 4, 5, 0, 0),
            row(4, 4, unspecified, 8, 9, 0, 0),
            row(5, 5, unspecified, 12, 13, 0, 0),
            row(6, 6, unspecified, 16, 17, 0, 0),
            row(7, 7, unspecified, 20, 21, 0, 0),
            row(8, 8, unspecified, 24, 25, 0, 0),
            row(9, 9, unspecified, 28, 29, 0, 0),
            row(10, 11, unspecified, 34, 35, 0, 0),
            row(11, 10, ground, 0, 0, 0, 0),
            row(12, 20, supply, 0, 0, 0, 0),
            row(13, 19, feedback, 2, 3, 1, 2600),
            row(14, 18, feedback, 6, 7, 1, 2602),
            row(15, 17, feedback, 10, 11, 1, 2604),
            row(16, 16, feedback, 14, 15, 1, 2606),
            row(17, 15, feedback, 18, 19, 1, 2608),
            row(18, 14, feedback, 22, 23, 1, 2610),
            row(19, 13, feedback, 26, 27, 1, 2612),
            row(20, 12, feedback, 30, 31, 1, 2614),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, sharing_mode, active, legacy_width]
        rows = [
            row(1, 19, array, control, 0, 0, 0, 36, 0, 1, no, 0, no, 36),
            row(1, 19, oe, control, 0, 2600, 0, 1, 0, 0, no, 0, no, 0),
            row(2, 19, array, unspecified, 0, 36, 0, 36, 0, 8, no, 0, no, 36),
            row(2, 19, none, programmable_positive, 1, 2592, 2601, 1, 1, 0, yes, 1, yes, 0),
            row(2, 19, none, programmable_negative, 0, 2592, 2601, 1, 1, 0, yes, 1, yes, 0),
            row(3, 18, array, control, 0, 324, 0, 36, 0, 1, no, 0, no, 36),
            row(3, 18, oe, control, 0, 2603, 0, 1, 0, 0, no, 0, no, 0),
            row(4, 18, array, unspecified, 0, 360, 0, 36, 0, 8, no, 0, no, 36),
            row(4, 18, none, programmable_positive, 1, 2593, 2603, 1, 1, 0, yes, 1, yes, 0),
            row(4, 18, none, programmable_negative, 0, 2593, 2603, 1, 1, 0, yes, 1, yes, 0),
            row(5, 17, array, control, 0, 648, 0, 36, 0, 1, no, 0, no, 36),
            row(5, 17, oe, control, 0, 2604, 0, 1, 0, 0, no, 0, no, 0),
            row(6, 17, array, unspecified, 0, 684, 0, 36, 0, 8, no, 0, no, 36),
            row(6, 17, none, programmable_positive, 1, 2594, 2605, 1, 1, 0, yes, 1, yes, 0),
            row(6, 17, none, programmable_negative, 0, 2594, 2605, 1, 1, 0, yes, 1, yes, 0),
            row(7, 16, array, control, 0, 972, 0, 36, 0, 1, no, 0, no, 36),
            row(7, 16, oe, control, 0, 2606, 0, 1, 0, 0, no, 0, no, 0),
            row(8, 16, array, unspecified, 0, 1008, 0, 36, 0, 8, no, 0, no, 36),
            row(8, 16, none, programmable_positive, 1, 2595, 2607, 1, 1, 0, yes, 1, yes, 0),
            row(8, 16, none, programmable_negative, 0, 2595, 2607, 1, 1, 0, yes, 1, yes, 0),
            row(9, 15, array, control, 0, 1296, 0, 36, 0, 1, no, 0, no, 36),
            row(9, 15, oe, control, 0, 2608, 0, 1, 0, 0, no, 0, no, 0),
            row(10, 15, array, unspecified, 0, 1332, 0, 36, 0, 8, no, 0, no, 36),
            row(10, 15, none, programmable_positive, 1, 2596, 2609, 1, 1, 0, yes, 1, yes, 0),
            row(10, 15, none, programmable_negative, 0, 2596, 2609, 1, 1, 0, yes, 1, yes, 0),
            row(11, 14, array, control, 0, 1620, 0, 36, 0, 1, no, 0, no, 36),
            row(11, 14, oe, control, 0, 2610, 0, 1, 0, 0, no, 0, no, 0),
            row(12, 14, array, unspecified, 0, 1656, 0, 36, 0, 8, no, 0, no, 36),
            row(12, 14, none, programmable_positive, 1, 2597, 2611, 1, 1, 0, yes, 1, yes, 0),
            row(12, 14, none, programmable_negative, 0, 2597, 2611, 1, 1, 0, yes, 1, yes, 0),
            row(13, 13, array, control, 0, 1944, 0, 36, 0, 1, no, 0, no, 36),
            row(13, 13, oe, control, 0, 2612, 0, 1, 0, 0, no, 0, no, 0),
            row(14, 13, array, unspecified, 0, 1980, 0, 36, 0, 8, no, 0, no, 36),
            row(14, 13, none, programmable_positive, 1, 2598, 2613, 1, 1, 0, yes, 1, yes, 0),
            row(14, 13, none, programmable_negative, 0, 2598, 2613, 1, 1, 0, yes, 1, yes, 0),
            row(15, 12, array, control, 0, 2268, 0, 36, 0, 1, no, 0, no, 36),
            row(15, 12, oe, control, 0, 2614, 0, 1, 0, 0, no, 0, no, 0),
            row(16, 12, array, unspecified, 0, 2304, 0, 36, 0, 8, no, 0, no, 36),
            row(16, 12, none, programmable_positive, 1, 2599, 2615, 1, 1, 0, yes, 1, yes, 0),
            row(16, 12, none, programmable_negative, 0, 2599, 2615, 1, 1, 0, yes, 1, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2616),
            row(text, 0, "Config ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2592, 0, 0),
            row(set, 1, " ", 5, 2600, 0, 0),
            row(setup_loop, 1, " ", 1, 72, 0, 0),
            row(loop, 1, " ", 8, 0, 9, 13),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(add, 1, " ", 5, 1, 0, 0),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 36),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 36),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        defaults {
            value = 0
        }
        columns = [first_fuse, last_fuse]
        rows = [
            row(2600, 2601),
            row(2602, 2603),
            row(2604, 2605),
            row(2606, 2607),
            row(2608, 2609),
            row(2610, 2611),
            row(2612, 2613),
            row(2614, 2615),
            row(2616, 2616),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 19, none, 1, 0),
            row(1, 19, oe, 1, 1),
            row(4, 18, none, 2, 0),
            row(3, 18, oe, 2, 1),
            row(6, 17, none, 3, 0),
            row(5, 17, oe, 3, 1),
            row(8, 16, none, 4, 0),
            row(7, 16, oe, 4, 1),
            row(10, 15, none, 5, 0),
            row(9, 15, oe, 5, 1),
            row(12, 14, none, 6, 0),
            row(11, 14, oe, 6, 1),
            row(14, 13, none, 7, 0),
            row(13, 13, oe, 7, 1),
            row(16, 12, none, 8, 0),
            row(15, 12, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
