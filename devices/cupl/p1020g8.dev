# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p1020g8 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 1352
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = 1
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 32
        initial_term_capacity = 40
        array_slots = 5
        input_line_slots = 25
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "l"
            function = l
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 0, 1),
            row(2, 1, 21, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, feedback, 6, 7),
            row(5, 9, unspecified, 8, 9),
            row(6, 5, feedback, 10, 11),
            row(7, 10, unspecified, 12, 13),
            row(8, 7, feedback, 14, 15),
            row(9, 11, unspecified, 16, 17),
            row(10, 8, feedback, 18, 19),
            row(11, 13, 21, 20, 21),
            row(12, 17, feedback, 22, 23),
            row(13, 14, unspecified, 24, 25),
            row(14, 18, feedback, 26, 27),
            row(15, 15, unspecified, 28, 29),
            row(16, 20, feedback, 30, 31),
            row(17, 16, unspecified, 32, 33),
            row(18, 21, feedback, 34, 35),
            row(19, 22, unspecified, 36, 37),
            row(20, 23, unspecified, 38, 39),
            row(21, 12, negative_supply, 0, 0),
            row(22, 6, supply, 0, 0),
            row(23, 19, supply, 0, 0),
            row(24, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, has_default, active]
        rows = [
            row(1, 0, array, negative, 0, 0, 1288, 40, 2, 8, no, no),
            row(1, 4, l, programmable_positive, 0, 1280, 0, 1, 0, 0, yes, yes),
            row(1, 4, l, programmable_negative, 1, 1280, 0, 1, 0, 0, yes, yes),
            row(1, 5, l, programmable_positive, 0, 1281, 1, 1, 0, 0, yes, yes),
            row(1, 5, l, programmable_negative, 1, 1281, 1, 1, 0, 0, yes, yes),
            row(2, 0, array, negative, 0, 320, 1304, 40, 2, 8, no, no),
            row(2, 7, l, programmable_positive, 0, 1282, 0, 1, 0, 0, yes, yes),
            row(2, 7, l, programmable_negative, 1, 1282, 0, 1, 0, 0, yes, yes),
            row(2, 8, l, programmable_positive, 0, 1283, 1, 1, 0, 0, yes, yes),
            row(2, 8, l, programmable_negative, 1, 1283, 1, 1, 0, 0, yes, yes),
            row(3, 0, array, negative, 0, 640, 1320, 40, 2, 8, no, no),
            row(3, 17, l, programmable_positive, 0, 1284, 0, 1, 0, 0, yes, yes),
            row(3, 17, l, programmable_negative, 1, 1284, 0, 1, 0, 0, yes, yes),
            row(3, 18, l, programmable_positive, 0, 1285, 1, 1, 0, 0, yes, yes),
            row(3, 18, l, programmable_negative, 1, 1285, 1, 1, 0, 0, yes, yes),
            row(4, 0, array, negative, 0, 960, 1336, 40, 2, 8, no, no),
            row(4, 20, l, programmable_positive, 0, 1286, 0, 1, 0, 0, yes, yes),
            row(4, 20, l, programmable_negative, 1, 1286, 0, 1, 0, 0, yes, yes),
            row(4, 21, l, programmable_positive, 0, 1287, 1, 1, 0, 0, yes, yes),
            row(4, 21, l, programmable_negative, 1, 1287, 1, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, "", 4, 1280, 0, 0),
            row(set, 1, "", 5, 1288, 0, 0),
            row(setup_loop, 1, " ", 1, 8, 2, 4),
            row(if_equal, 1, " ", 1, 8, 0, 12),
            row(print_increment, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(print_increment, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(address, 1, "  ", 5, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 2),
            row(add, 1, " ", 5, 2, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(setup_loop, 2, " ", 1, 8, 2, 7),
            row(if_equal, 2, " ", 1, 8, 0, 12),
            row(print_increment, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 0, 0),
            row(print_increment, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(address, 2, "  ", 5, 0, 0, 0),
            row(fuses_forward, 2, "x-", 5, 0, 1, 2),
            row(add, 2, " ", 5, 2, 0, 0),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(setup_loop, 3, " ", 1, 8, 2, 17),
            row(if_equal, 3, " ", 1, 8, 0, 12),
            row(print_increment, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(add, 3, "", 4, 1, 0, 0),
            row(print_increment, 3, "Pin #", 2, 1, 0, 0),
            row(address, 3, " ", 4, 0, 0, 0),
            row(text, 3, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 4, 0, 1, 1),
            row(newline, 3, "", 1, 0, 0, 0),
            row(add, 3, "", 4, 1, 0, 0),
            row(address, 3, " ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 40),
            row(address, 3, "  ", 5, 0, 0, 0),
            row(fuses_forward, 3, "x-", 5, 0, 1, 2),
            row(add, 3, " ", 5, 2, 0, 0),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 40),
            row(setup_loop, 4, " ", 1, 8, 2, 20),
            row(if_equal, 4, " ", 1, 8, 0, 12),
            row(print_increment, 4, "Pin #", 2, 1, 0, 0),
            row(address, 4, " ", 4, 0, 0, 0),
            row(text, 4, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 4, 0, 1, 1),
            row(newline, 4, "", 1, 0, 0, 0),
            row(add, 4, "", 4, 1, 0, 0),
            row(print_increment, 4, "Pin #", 2, 1, 0, 0),
            row(address, 4, " ", 4, 0, 0, 0),
            row(text, 4, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 4, 0, 1, 1),
            row(newline, 4, "", 1, 0, 0, 0),
            row(add, 4, "", 4, 1, 0, 0),
            row(address, 4, " ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 40),
            row(address, 4, "  ", 5, 0, 0, 0),
            row(fuses_forward, 4, "x-", 5, 0, 1, 2),
            row(add, 4, " ", 5, 2, 0, 0),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(2, 1, le, 1, 1, 1),
            row(1, 4, l, 1, 0, 0),
            row(1, 5, l, 1, 0, 0),
            row(2, 7, l, 1, 0, 0),
            row(2, 8, l, 1, 0, 0),
            row(11, 13, le, 2, 1, 1),
            row(3, 17, l, 2, 0, 0),
            row(3, 18, l, 2, 0, 0),
            row(4, 20, l, 2, 0, 0),
            row(4, 21, l, 2, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
