            row(11, 19, none, 6, 0, 0, yes),
            row(10, 19, oe, 6, 1, 0, yes),
            row(14, 18, none, 7, 0, 0, yes),
            row(13, 18, oe, 7, 1, 0, yes),
            row(17, 17, none, 8, 0, 0, yes),
            row(16, 17, oe, 8, 1, 0, yes),
            row(20, 16, none, 9, 0, 0, yes),
            row(19, 16, oe, 9, 1, 0, yes),
            row(23, 15, none, 10, 0, 0, yes),
            row(22, 15, oe, 10, 1, 0, yes),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
