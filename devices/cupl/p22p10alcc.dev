# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p22p10alcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 3970
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 90
        initial_term_capacity = 70
        array_slots = 21
        input_line_slots = 29
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 2, 3),
            row(2, 3, unspecified, 0, 1),
            row(3, 4, unspecified, 4, 5),
            row(4, 26, feedback, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 25, feedback, 10, 11),
            row(7, 6, unspecified, 12, 13),
            row(8, 24, feedback, 14, 15),
            row(9, 7, unspecified, 16, 17),
            row(10, 23, feedback, 18, 19),
            row(11, 9, unspecified, 20, 21),
            row(12, 21, feedback, 22, 23),
            row(13, 10, unspecified, 24, 25),
            row(14, 20, feedback, 26, 27),
            row(15, 11, unspecified, 28, 29),
            row(16, 19, feedback, 30, 31),
            row(17, 12, unspecified, 32, 33),
            row(18, 18, feedback, 34, 35),
            row(19, 13, unspecified, 36, 37),
            row(20, 16, unspecified, 38, 39),
            row(21, 27, feedback, 40, 41),
            row(22, 17, feedback, 42, 43),
            row(23, 14, ground, 0, 0),
            row(24, 28, supply, 0, 0),
            row(25, 1, not_connected, 0, 0),
            row(26, 8, not_connected, 0, 0),
            row(27, 15, not_connected, 0, 0),
            row(28, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 27, array, control, 0, 0, 44, 1, 0, no, no),
            row(1, 27, oe, control, 0, 0, 0, 0, 2, no, no),
            row(2, 27, array, negative, 0, 44, 44, 8, 0, no, no),
            row(2, 27, none, programmable_positive, 1, 3960, 1, 0, 0, yes, yes),
            row(2, 27, none, programmable_negative, 0, 3960, 1, 0, 0, yes, yes),
            row(3, 26, array, control, 0, 396, 44, 1, 0, no, no),
            row(3, 26, oe, control, 0, 0, 0, 0, 2, no, no),
            row(4, 26, array, negative, 0, 440, 44, 8, 0, no, no),
            row(4, 26, none, programmable_positive, 1, 3961, 1, 0, 0, yes, yes),
            row(4, 26, none, programmable_negative, 0, 3961, 1, 0, 0, yes, yes),
            row(5, 25, array, control, 0, 792, 44, 1, 0, no, no),
            row(5, 25, oe, control, 0, 0, 0, 0, 2, no, no),
            row(6, 25, array, negative, 0, 836, 44, 8, 0, no, no),
            row(6, 25, none, programmable_positive, 1, 3962, 1, 0, 0, yes, yes),
            row(6, 25, none, programmable_negative, 0, 3962, 1, 0, 0, yes, yes),
            row(7, 24, array, control, 0, 1188, 44, 1, 0, no, no),
            row(7, 24, oe, control, 0, 0, 0, 0, 2, no, no),
            row(8, 24, array, negative, 0, 1232, 44, 8, 0, no, no),
            row(8, 24, none, programmable_positive, 1, 3963, 1, 0, 0, yes, yes),
            row(8, 24, none, programmable_negative, 0, 3963, 1, 0, 0, yes, yes),
            row(9, 23, array, control, 0, 1584, 44, 1, 0, no, no),
            row(9, 23, oe, control, 0, 0, 0, 0, 2, no, no),
            row(10, 23, array, negative, 0, 1628, 44, 8, 0, no, no),
            row(10, 23, none, programmable_positive, 1, 3964, 1, 0, 0, yes, yes),
            row(10, 23, none, programmable_negative, 0, 3964, 1, 0, 0, yes, yes),
            row(11, 21, array, control, 0, 1980, 44, 1, 0, no, no),
            row(11, 21, oe, control, 0, 0, 0, 0, 2, no, no),
            row(12, 21, array, negative, 0, 2024, 44, 8, 0, no, no),
            row(12, 21, none, programmable_positive, 1, 3965, 1, 0, 0, yes, yes),
            row(12, 21, none, programmable_negative, 0, 3965, 1, 0, 0, yes, yes),
            row(13, 20, array, control, 0, 2376, 44, 1, 0, no, no),
            row(13, 20, oe, control, 0, 0, 0, 0, 2, no, no),
            row(14, 20, array, negative, 0, 2420, 44, 8, 0, no, no),
            row(14, 20, none, programmable_positive, 1, 3966, 1, 0, 0, yes, yes),
            row(14, 20, none, programmable_negative, 0, 3966, 1, 0, 0, yes, yes),
            row(15, 19, array, control, 0, 2772, 44, 1, 0, no, no),
            row(15, 19, oe, control, 0, 0, 0, 0, 2, no, no),
            row(16, 19, array, negative, 0, 2816, 44, 8, 0, no, no),
            row(16, 19, none, programmable_positive, 1, 3967, 1, 0, 0, yes, yes),
            row(16, 19, none, programmable_negative, 0, 3967, 1, 0, 0, yes, yes),
            row(17, 18, array, control, 0, 3168, 44, 1, 0, no, no),
            row(17, 18, oe, control, 0, 0, 0, 0, 2, no, no),
            row(18, 18, array, negative, 0, 3212, 44, 8, 0, no, no),
            row(18, 18, none, programmable_positive, 1, 3968, 1, 0, 0, yes, yes),
            row(18, 18, none, programmable_negative, 0, 3968, 1, 0, 0, yes, yes),
            row(19, 17, array, control, 0, 3564, 44, 1, 0, no, no),
            row(19, 17, oe, control, 0, 0, 0, 0, 2, no, no),
            row(20, 17, array, negative, 0, 3608, 44, 8, 0, no, no),
            row(20, 17, none, programmable_positive, 1, 3969, 1, 0, 0, yes, yes),
            row(20, 17, none, programmable_negative, 0, 3969, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 27, 0, 0),
            row(setup_loop, 1, " ", 1, 90, 4, 3960),
            row(if_equal, 1, " ", 1, 46, 0, 1),
            row(set, 1, " ", 2, 21, 0, 0),
            row(loop, 1, " ", 7, 0, 9, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 44),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 44),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(2, 27, none, 1, 0),
            row(1, 27, oe, 1, 1),
            row(4, 26, none, 2, 0),
            row(3, 26, oe, 2, 1),
            row(6, 25, none, 3, 0),
            row(5, 25, oe, 3, 1),
            row(8, 24, none, 4, 0),
            row(7, 24, oe, 4, 1),
            row(10, 23, none, 5, 0),
            row(9, 23, oe, 5, 1),
            row(12, 21, none, 6, 0),
            row(11, 21, oe, 6, 1),
            row(14, 20, none, 7, 0),
            row(13, 20, oe, 7, 1),
            row(16, 19, none, 8, 0),
            row(15, 19, oe, 8, 1),
            row(18, 18, none, 9, 0),
            row(17, 18, oe, 9, 1),
            row(20, 17, none, 10, 0),
            row(19, 17, oe, 10, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
