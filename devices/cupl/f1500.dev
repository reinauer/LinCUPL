# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f1500 {
    representation = library

    package {
        pins = 44
        drawing_style = 1
        internal_nodes = 64
    }

    power {
        ground = 0
        supply = 0
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 0
    }

    fuses {
        count = 15360
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 96
        clocked_resources = 32
        default_extension = none
        product_rows = 320
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 109
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 32
    }

    fitter {
        input_format = 2
        name = "find1500"
        arguments = ""
        pla_options = [tool_header, jedec_keyword, copy_tt2, omit_pin_zero, short_labels]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("s", s),
            row("r", r),
            row("oe", oe),
            row("oemux", oemux),
            row("ck", ck),
            row("ckmux", ckmux),
            row("ar", ar),
            row("dq", dq),
            row("lq", lq),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
            row("ioar", ioar),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "REG"),
            row("t", "T"),
            row("l", "L"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
