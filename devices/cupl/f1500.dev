            row("le", "LE"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", "Q"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 131072
