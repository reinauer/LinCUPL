# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f157 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2108
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 15
        family = ifl
        extra_nodes_a = 1
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 6
        clocked_resources = 6
        default_extension = none
        product_rows = 43
        initial_term_capacity = 70
        array_slots = 15
        input_line_slots = 28
        extra_symbols = 6
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 12
