# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20v8as {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 2706
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 23
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 0, 1),
            row(2, 1, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 23, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 22, unspecified, 10, 11),
            row(6, 22, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 21, unspecified, 14, 15),
            row(8, 21, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 20, unspecified, 18, 19),
            row(10, 20, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 17, unspecified, 22, 23),
            row(12, 17, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 16, unspecified, 26, 27),
            row(14, 16, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 15, unspecified, 30, 31),
            row(16, 15, feedback, 30, 31),
            row(17, 10, unspecified, 32, 33),
            row(18, 14, unspecified, 34, 35),
            row(19, 11, unspecified, 36, 37),
            row(20, 13, unspecified, 38, 39),
            row(21, 12, ground, 0, 0),
            row(22, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, has_default, active]
        rows = [
            row(1, 22, array, negative, 0, 0, 0, 40, 0, 8, no, no),
            row(1, 22, none, programmable_positive, 1, 2560, 2632, 1, 1, 0, yes, yes),
            row(1, 22, none, programmable_negative, 0, 2560, 2632, 1, 1, 0, yes, yes),
            row(2, 21, array, negative, 0, 320, 0, 40, 0, 8, no, no),
            row(2, 21, none, programmable_positive, 1, 2561, 2633, 1, 1, 0, yes, yes),
            row(2, 21, none, programmable_negative, 0, 2561, 2633, 1, 1, 0, yes, yes),
            row(3, 20, array, negative, 0, 640, 0, 40, 0, 8, no, no),
            row(3, 20, none, programmable_positive, 1, 2562, 2634, 1, 1, 0, yes, yes),
            row(3, 20, none, programmable_negative, 0, 2562, 2634, 1, 1, 0, yes, yes),
            row(4, 19, array, negative, 0, 960, 0, 40, 0, 8, no, no),
            row(4, 19, none, programmable_positive, 1, 2563, 2635, 1, 1, 0, yes, yes),
            row(4, 19, none, programmable_negative, 0, 2563, 2635, 1, 1, 0, yes, yes),
            row(5, 18, array, negative, 0, 1280, 0, 40, 0, 8, no, no),
            row(5, 18, none, programmable_positive, 1, 2564, 2636, 1, 1, 0, yes, yes),
            row(5, 18, none, programmable_negative, 0, 2564, 2636, 1, 1, 0, yes, yes),
            row(6, 17, array, negative, 0, 1600, 0, 40, 0, 8, no, no),
            row(6, 17, none, programmable_positive, 1, 2565, 2637, 1, 1, 0, yes, yes),
            row(6, 17, none, programmable_negative, 0, 2565, 2637, 1, 1, 0, yes, yes),
            row(7, 16, array, negative, 0, 1920, 0, 40, 0, 8, no, no),
            row(7, 16, none, programmable_positive, 1, 2566, 2638, 1, 1, 0, yes, yes),
            row(7, 16, none, programmable_negative, 0, 2566, 2638, 1, 1, 0, yes, yes),
            row(8, 15, array, negative, 0, 2240, 0, 40, 0, 8, no, no),
            row(8, 15, none, programmable_positive, 1, 2567, 2639, 1, 1, 0, yes, yes),
            row(8, 15, none, programmable_negative, 0, 2567, 2639, 1, 1, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2704),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 22, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(set, 1, " ", 5, 2632, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 9),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2568, 2631, 0),
            row(2632, 2639, 1),
            row(2640, 2703, 1),
            row(2704, 2704, 1),
            row(2705, 2705, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
