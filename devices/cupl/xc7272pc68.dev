        defaults {
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
