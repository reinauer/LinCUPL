# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ispl2032_110lj44 {
    representation = library

    package {
        pins = 44
        drawing_style = 1
        internal_nodes = 32
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 99999
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 64
        clocked_resources = 32
        default_extension = none
        product_rows = 160
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 77
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 32
    }

    fitter {
        input_format = 4
        name = "plsifit"
        arguments = ""
        pla_options = [tool_header, omit_device, jedec_keyword, copy_tt2, omit_pin_zero, short_labels]
        part = ""
    }

    extensions {
