# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p16sp8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2168
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = 2
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 13
        input_line_slots = 19
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, unspecified, 0, 1),
            row(2, 1, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 18, feedback, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 17, feedback, 10, 11),
            row(7, 5, unspecified, 12, 13),
            row(8, 16, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 15, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 14, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 13, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 11, unspecified, 30, 31),
            row(17, 10, ground, 0, 0),
            row(18, 20, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 19, array, control, 0, 0, 0, 32, 0, 1, 0, no, no),
            row(1, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(2, 18, array, control, 0, 480, 0, 32, 0, 1, 0, no, no),
            row(2, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(3, 0, array, negative, 0, 32, 2056, 32, 2, 14, 0, no, no),
            row(3, 19, none, programmable_positive, 1, 2048, 0, 1, 0, 0, 0, yes, yes),
            row(3, 19, none, programmable_negative, 0, 2048, 0, 1, 0, 0, 0, yes, yes),
            row(3, 18, none, programmable_positive, 1, 2049, 1, 1, 0, 0, 0, yes, yes),
            row(3, 18, none, programmable_negative, 0, 2049, 1, 1, 0, 0, 0, yes, yes),
            row(4, 17, array, control, 0, 512, 0, 32, 0, 1, 0, no, no),
            row(4, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(5, 16, array, control, 0, 992, 0, 32, 0, 1, 0, no, no),
            row(5, 16, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(6, 0, array, negative, 0, 544, 2084, 32, 2, 14, 0, no, no),
            row(6, 17, none, programmable_positive, 1, 2050, 0, 1, 0, 0, 0, yes, yes),
            row(6, 17, none, programmable_negative, 0, 2050, 0, 1, 0, 0, 0, yes, yes),
            row(6, 16, none, programmable_positive, 1, 2051, 1, 1, 0, 0, 0, yes, yes),
            row(6, 16, none, programmable_negative, 0, 2051, 1, 1, 0, 0, 0, yes, yes),
            row(7, 15, array, control, 0, 1024, 0, 32, 0, 1, 0, no, no),
            row(7, 15, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(8, 14, array, control, 0, 1504, 0, 32, 0, 1, 0, no, no),
            row(8, 14, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(9, 0, array, negative, 0, 1056, 2112, 32, 2, 14, 0, no, no),
            row(9, 15, none, programmable_positive, 1, 2052, 0, 1, 0, 0, 0, yes, yes),
            row(9, 15, none, programmable_negative, 0, 2052, 0, 1, 0, 0, 0, yes, yes),
            row(9, 14, none, programmable_positive, 1, 2053, 1, 1, 0, 0, 0, yes, yes),
            row(9, 14, none, programmable_negative, 0, 2053, 1, 1, 0, 0, 0, yes, yes),
            row(10, 13, array, control, 0, 1536, 0, 32, 0, 1, 0, no, no),
            row(10, 13, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(11, 12, array, control, 0, 2016, 0, 32, 0, 1, 0, no, no),
            row(11, 12, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(12, 0, array, negative, 0, 1568, 2140, 32, 2, 14, 0, no, no),
            row(12, 13, none, programmable_positive, 1, 2054, 0, 1, 0, 0, 0, yes, yes),
            row(12, 13, none, programmable_negative, 0, 2054, 0, 1, 0, 0, 0, yes, yes),
            row(12, 12, none, programmable_positive, 1, 2055, 1, 1, 0, 0, 0, yes, yes),
            row(12, 12, none, programmable_negative, 0, 2055, 1, 1, 0, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2048, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 5, 2056),
            row(loop, 1, " ", 7, 0, 16, 12),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(if_equal, 1, " ", 1, 1, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 17),
            row(if_equal, 1, " ", 1, 16, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 15),
            row(if_equal, 1, " ", 1, 17, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 13),
            row(if_equal, 1, " ", 1, 32, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 11),
            row(if_equal, 1, " ", 1, 33, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 9),
            row(if_equal, 1, " ", 1, 48, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 7),
            row(if_equal, 1, " ", 1, 49, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 5),
            row(if_equal, 1, " ", 1, 64, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 3),
            row(address, 1, "  ", 5, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 2),
            row(add, 1, " ", 5, 2, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(3, 19, none, 1, 0),
            row(1, 19, oe, 1, 1),
            row(3, 18, none, 2, 0),
            row(2, 18, oe, 2, 1),
            row(6, 17, none, 3, 0),
            row(4, 17, oe, 3, 1),
            row(6, 16, none, 4, 0),
            row(5, 16, oe, 4, 1),
            row(9, 15, none, 5, 0),
            row(7, 15, oe, 5, 1),
            row(9, 14, none, 6, 0),
            row(8, 14, oe, 6, 1),
            row(12, 13, none, 7, 0),
            row(10, 13, oe, 7, 1),
            row(12, 12, none, 8, 0),
            row(11, 12, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
