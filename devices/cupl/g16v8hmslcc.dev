# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g16v8hmslcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 2
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2226
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2056
    }

    compiler {
        revision = 3
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 33
        input_line_slots = 29
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
