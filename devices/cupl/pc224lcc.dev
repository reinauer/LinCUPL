# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device pc224lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 2
        attribute_7 = 1
        attribute_20 = 1
    }

    fuses {
        count = 3204
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 72
        initial_term_capacity = 140
        array_slots = 17
        input_line_slots = 29
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            function = none
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, variant, true_column, complement_column]
        rows = [
            row(1, 2, clock_input, default, 1, 0),
            row(2, 3, unspecified, default, 3, 2),
            row(3, 4, unspecified, default, 5, 4),
            row(4, 5, unspecified, default, 7, 6),
            row(5, 6, unspecified, default, 9, 8),
            row(6, 7, unspecified, default, 11, 10),
            row(7, 9, unspecified, default, 13, 12),
            row(8, 10, unspecified, default, 15, 14),
            row(9, 11, unspecified, default, 17, 16),
            row(10, 12, unspecified, default, 19, 18),
            row(11, 13, unspecified, default, 21, 20),
            row(12, 16, unspecified, default, 23, 22),
            row(13, 17, unspecified, default, 25, 24),
            row(14, 18, feedback, default, 27, 26),
            row(14, 18, register_feedback, d, 27, 26),
            row(15, 19, feedback, default, 29, 28),
            row(15, 19, register_feedback, d, 29, 28),
            row(16, 20, feedback, default, 31, 30),
            row(16, 20, register_feedback, d, 31, 30),
            row(17, 21, feedback, default, 33, 32),
            row(17, 21, register_feedback, d, 33, 32),
            row(18, 23, feedback, default, 35, 34),
            row(18, 23, register_feedback, d, 35, 34),
            row(19, 24, feedback, default, 37, 36),
            row(19, 24, register_feedback, d, 37, 36),
            row(20, 25, feedback, default, 39, 38),
            row(20, 25, register_feedback, d, 39, 38),
            row(21, 26, feedback, default, 41, 40),
            row(21, 26, register_feedback, d, 41, 40),
            row(22, 27, unspecified, default, 43, 42),
            row(23, 14, ground, default, 0, 0),
            row(24, 28, supply, default, 0, 0),
            row(25, 1, not_connected, default, 0, 0),
            row(26, 8, not_connected, default, 0, 0),
            row(27, 15, not_connected, default, 0, 0),
            row(28, 22, not_connected, default, 0, 0),
        ]
    }

    node_functions {
        defaults {
            legacy_width = 0
            invert = no
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, row_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 26, array, unspecified, 0, 352, 44, 1, 0, no, 0, no),
            row(1, 26, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(2, 26, array, unspecified, 0, 0, 44, 8, 0, no, 0, no),
            row(2, 26, none, programmable_negative, 0, 3168, 4, 0, 0, yes, 1, yes),
            row(2, 26, none, programmable_positive, 3, 3168, 4, 0, 0, yes, 1, yes),
            row(2, 26, d, programmable_negative, 12, 3168, 4, 0, 0, yes, 1, yes),
            row(2, 26, d, programmable_positive, 15, 3168, 4, 0, 0, yes, 1, yes),
            row(3, 25, array, unspecified, 0, 748, 44, 1, 0, no, 0, no),
            row(3, 25, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(4, 25, array, unspecified, 0, 396, 44, 8, 0, no, 0, no),
            row(4, 25, none, programmable_negative, 0, 3172, 4, 0, 0, yes, 1, yes),
            row(4, 25, none, programmable_positive, 3, 3172, 4, 0, 0, yes, 1, yes),
            row(4, 25, d, programmable_negative, 12, 3172, 4, 0, 0, yes, 1, yes),
            row(4, 25, d, programmable_positive, 15, 3172, 4, 0, 0, yes, 1, yes),
            row(5, 24, array, unspecified, 0, 1144, 44, 1, 0, no, 0, no),
            row(5, 24, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(6, 24, array, unspecified, 0, 792, 44, 8, 0, no, 0, no),
            row(6, 24, none, programmable_negative, 0, 3176, 4, 0, 0, yes, 1, yes),
            row(6, 24, none, programmable_positive, 3, 3176, 4, 0, 0, yes, 1, yes),
            row(6, 24, d, programmable_negative, 12, 3176, 4, 0, 0, yes, 1, yes),
            row(6, 24, d, programmable_positive, 15, 3176, 4, 0, 0, yes, 1, yes),
            row(7, 23, array, unspecified, 0, 1540, 44, 1, 0, no, 0, no),
            row(7, 23, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(8, 23, array, unspecified, 0, 1188, 44, 8, 0, no, 0, no),
            row(8, 23, none, programmable_negative, 0, 3180, 4, 0, 0, yes, 1, yes),
            row(8, 23, none, programmable_positive, 3, 3180, 4, 0, 0, yes, 1, yes),
            row(8, 23, d, programmable_negative, 12, 3180, 4, 0, 0, yes, 1, yes),
            row(8, 23, d, programmable_positive, 15, 3180, 4, 0, 0, yes, 1, yes),
            row(9, 21, array, unspecified, 0, 1936, 44, 1, 0, no, 0, no),
            row(9, 21, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(10, 21, array, unspecified, 0, 1584, 44, 8, 0, no, 0, no),
            row(10, 21, none, programmable_negative, 0, 3184, 4, 0, 0, yes, 1, yes),
            row(10, 21, none, programmable_positive, 3, 3184, 4, 0, 0, yes, 1, yes),
            row(10, 21, d, programmable_negative, 12, 3184, 4, 0, 0, yes, 1, yes),
            row(10, 21, d, programmable_positive, 15, 3184, 4, 0, 0, yes, 1, yes),
            row(11, 20, array, unspecified, 0, 2332, 44, 1, 0, no, 0, no),
            row(11, 20, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(12, 20, array, unspecified, 0, 1980, 44, 8, 0, no, 0, no),
            row(12, 20, none, programmable_negative, 0, 3188, 4, 0, 0, yes, 1, yes),
            row(12, 20, none, programmable_positive, 3, 3188, 4, 0, 0, yes, 1, yes),
            row(12, 20, d, programmable_negative, 12, 3188, 4, 0, 0, yes, 1, yes),
            row(12, 20, d, programmable_positive, 15, 3188, 4, 0, 0, yes, 1, yes),
            row(13, 19, array, unspecified, 0, 2728, 44, 1, 0, no, 0, no),
            row(13, 19, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(14, 19, array, unspecified, 0, 2376, 44, 8, 0, no, 0, no),
            row(14, 19, none, programmable_negative, 0, 3192, 4, 0, 0, yes, 1, yes),
            row(14, 19, none, programmable_positive, 3, 3192, 4, 0, 0, yes, 1, yes),
            row(14, 19, d, programmable_negative, 12, 3192, 4, 0, 0, yes, 1, yes),
            row(14, 19, d, programmable_positive, 15, 3192, 4, 0, 0, yes, 1, yes),
            row(15, 18, array, unspecified, 0, 3124, 44, 1, 0, no, 0, no),
            row(15, 18, oe, control, 0, 0, 0, 0, 2, no, 0, no),
            row(16, 18, array, unspecified, 0, 2772, 44, 8, 0, no, 0, no),
            row(16, 18, none, programmable_negative, 0, 3196, 4, 0, 0, yes, 1, yes),
            row(16, 18, none, programmable_positive, 3, 3196, 4, 0, 0, yes, 1, yes),
            row(16, 18, d, programmable_negative, 12, 3196, 4, 0, 0, yes, 1, yes),
            row(16, 18, d, programmable_positive, 15, 3196, 4, 0, 0, yes, 1, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 4, 3168, 0, 0),
            row(setup_loop, 1, " ", 1, 36, 2, 26),
            row(loop, 1, " ", 5, 0, 9, 6),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Arch", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 4),
            row(add, 1, " ", 4, 4, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 44),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 44),
            row(set, 2, " ", 4, 3184, 0, 0),
            row(setup_loop, 2, " ", 1, 36, 2, 21),
            row(loop, 2, " ", 5, 0, 9, 6),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Arch", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 4),
            row(add, 2, " ", 4, 4, 0, 0),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 44),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 44),
            row(setup_loop, 3, " ", 1, 1, 0, 3200),
            row(newline, 3, " ", 2, 0, 0, 0),
            row(print_increment, 3, "MISER ", 0, 0, 0, 0),
            row(fuses_forward, 3, "x-", 0, 0, 1, 2),
            row(newline, 3, " ", 1, 0, 0, 0),
            row(end_row, 3, " ", 0, 0, 0, 2),
            row(setup_loop, 4, " ", 1, 1, 0, 3202),
            row(print_increment, 4, "TURBO ", 0, 0, 0, 0),
            row(fuses_forward, 4, "x-", 0, 0, 1, 2),
            row(newline, 4, " ", 1, 0, 0, 0),
            row(end_row, 4, " ", 0, 0, 0, 2),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(3200, 3201, 1),
            row(3202, 3203, 0),
        ]
    }

    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(1, 2, ck, 1, 1, 1, no),
            row(2, 26, d, 1, 0, 0, no),
            row(4, 25, d, 1, 0, 0, no),
            row(6, 24, d, 1, 0, 0, no),
            row(8, 23, d, 1, 0, 0, no),
            row(10, 21, d, 1, 0, 0, no),
            row(12, 20, d, 1, 0, 0, no),
            row(14, 19, d, 1, 0, 0, no),
            row(16, 18, d, 1, 0, 0, no),
            row(1, 26, oe, 2, 1, 0, yes),
            row(2, 26, none, 2, 0, 0, yes),
            row(2, 26, d, 2, 0, 0, yes),
            row(3, 25, oe, 3, 1, 0, yes),
            row(4, 25, none, 3, 0, 0, yes),
            row(4, 25, d, 3, 0, 0, yes),
            row(5, 24, oe, 4, 1, 0, yes),
            row(6, 24, none, 4, 0, 0, yes),
            row(6, 24, d, 4, 0, 0, yes),
            row(7, 23, oe, 5, 1, 0, yes),
            row(8, 23, none, 5, 0, 0, yes),
            row(8, 23, d, 5, 0, 0, yes),
            row(9, 21, oe, 6, 1, 0, yes),
            row(10, 21, none, 6, 0, 0, yes),
            row(10, 21, d, 6, 0, 0, yes),
            row(11, 20, oe, 7, 1, 0, yes),
            row(12, 20, none, 7, 0, 0, yes),
            row(12, 20, d, 7, 0, 0, yes),
            row(13, 19, oe, 8, 1, 0, yes),
            row(14, 19, none, 8, 0, 0, yes),
            row(14, 19, d, 8, 0, 0, yes),
            row(15, 18, oe, 9, 1, 0, yes),
            row(16, 18, none, 9, 0, 0, yes),
            row(16, 18, d, 9, 0, 0, yes),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
