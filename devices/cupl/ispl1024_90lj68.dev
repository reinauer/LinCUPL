# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ispl1024_90lj68 {
    representation = library

    package {
        pins = 68
        drawing_style = 1
        internal_nodes = 96
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 24480
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 144
        clocked_resources = 48
        default_extension = none
        product_rows = 480
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 165
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 48
    }

    fitter {
        input_format = 4
        name = "plsifit"
        arguments = ""
        pla_options = [tool_header, jedec_keyword, copy_tt2, omit_device, omit_pin_zero, short_labels]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("j", j),
            row("k", k),
            row("oe", oe),
            row("oemux", oemux),
            row("ck", ck),
            row("ckmux", ckmux),
            row("ar", ar),
            row("dq", dq),
            row("lq", lq),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
            row("ioar", ioar),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
