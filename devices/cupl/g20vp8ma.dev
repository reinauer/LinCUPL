# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g20vp8ma {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 18
        supply = 6
    }

    fuses {
        count = 2714
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2568
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 23
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("tec", tec),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 24, unspecified, 0, 1),
            row(3, 2, unspecified, 4, 5),
            row(4, 23, unspecified, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 21, feedback, 10, 11),
            row(7, 4, unspecified, 12, 13),
            row(8, 20, feedback, 14, 15),
            row(9, 5, unspecified, 16, 17),
            row(10, 19, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 17, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 16, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 15, feedback, 30, 31),
            row(17, 10, unspecified, 32, 33),
            row(18, 13, unspecified, 34, 35),
            row(19, 11, unspecified, 36, 37),
            row(20, 12, unspecified, 38, 39),
            row(21, 18, ground, 0, 0),
            row(22, 6, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, config_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 22, array, control, 0, 0, 0, 0, 40, 0, 1, 0, no, no),
            row(1, 22, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(2, 22, array, unspecified, 0, 0, 2706, 0, 1, 0, 1, 0, no, no),
            row(2, 22, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(3, 22, array, negative, 0, 0, 40, 0, 40, 0, 7, 0, no, no),
            row(3, 22, none, programmable_positive, 1, 1, 2560, 2632, 1, 1, 0, 0, yes, yes),
            row(3, 22, none, programmable_negative, 0, 1, 2560, 2632, 1, 1, 0, 0, yes, yes),
            row(4, 21, array, control, 0, 0, 320, 0, 40, 0, 1, 0, no, no),
            row(4, 21, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(5, 21, array, unspecified, 0, 0, 2707, 0, 1, 0, 1, 0, no, no),
            row(5, 21, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(6, 21, array, negative, 0, 0, 360, 0, 40, 0, 7, 0, no, no),
            row(6, 21, none, programmable_positive, 1, 1, 2561, 2633, 1, 1, 0, 0, yes, yes),
            row(6, 21, none, programmable_negative, 0, 1, 2561, 2633, 1, 1, 0, 0, yes, yes),
            row(7, 20, array, control, 0, 0, 640, 0, 40, 0, 1, 0, no, no),
            row(7, 20, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(8, 20, array, unspecified, 0, 0, 2708, 0, 1, 0, 1, 0, no, no),
            row(8, 20, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(9, 20, array, negative, 0, 0, 680, 0, 40, 0, 7, 0, no, no),
            row(9, 20, none, programmable_positive, 1, 1, 2562, 2634, 1, 1, 0, 0, yes, yes),
            row(9, 20, none, programmable_negative, 0, 1, 2562, 2634, 1, 1, 0, 0, yes, yes),
            row(10, 19, array, control, 0, 0, 960, 0, 40, 0, 1, 0, no, no),
            row(10, 19, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(11, 19, array, unspecified, 0, 0, 2709, 0, 1, 0, 1, 0, no, no),
            row(11, 19, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(12, 19, array, negative, 0, 0, 1000, 0, 40, 0, 7, 0, no, no),
            row(12, 19, none, programmable_positive, 1, 1, 2563, 2635, 1, 1, 0, 0, yes, yes),
            row(12, 19, none, programmable_negative, 0, 1, 2563, 2635, 1, 1, 0, 0, yes, yes),
            row(13, 17, array, control, 0, 0, 1280, 0, 40, 0, 1, 0, no, no),
            row(13, 17, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(14, 17, array, unspecified, 0, 0, 2710, 0, 1, 0, 1, 0, no, no),
            row(14, 17, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(15, 17, array, negative, 0, 0, 1320, 0, 40, 0, 7, 0, no, no),
            row(15, 17, none, programmable_positive, 1, 1, 2564, 2636, 1, 1, 0, 0, yes, yes),
            row(15, 17, none, programmable_negative, 0, 1, 2564, 2636, 1, 1, 0, 0, yes, yes),
            row(16, 16, array, control, 0, 0, 1600, 0, 40, 0, 1, 0, no, no),
            row(16, 16, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(17, 16, array, unspecified, 0, 0, 2711, 0, 1, 0, 1, 0, no, no),
            row(17, 16, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(18, 16, array, negative, 0, 0, 1640, 0, 40, 0, 7, 0, no, no),
            row(18, 16, none, programmable_positive, 1, 1, 2565, 2637, 1, 1, 0, 0, yes, yes),
            row(18, 16, none, programmable_negative, 0, 1, 2565, 2637, 1, 1, 0, 0, yes, yes),
            row(19, 15, array, control, 0, 0, 1920, 0, 40, 0, 1, 0, no, no),
            row(19, 15, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(20, 15, array, unspecified, 0, 0, 2712, 0, 1, 0, 1, 0, no, no),
            row(20, 15, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(21, 15, array, negative, 0, 0, 1960, 0, 40, 0, 7, 0, no, no),
            row(21, 15, none, programmable_positive, 1, 1, 2566, 2638, 1, 1, 0, 0, yes, yes),
            row(21, 15, none, programmable_negative, 0, 1, 2566, 2638, 1, 1, 0, 0, yes, yes),
            row(22, 14, array, control, 0, 0, 2240, 0, 40, 0, 1, 0, no, no),
            row(22, 14, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(23, 14, array, unspecified, 0, 0, 2713, 0, 1, 0, 1, 0, no, no),
            row(23, 14, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(24, 14, array, negative, 0, 0, 2280, 0, 40, 0, 7, 0, no, no),
            row(24, 14, none, programmable_positive, 1, 1, 2567, 2639, 1, 1, 0, 0, yes, yes),
            row(24, 14, none, programmable_negative, 0, 1, 2567, 2639, 1, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2704),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 22, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(set, 1, " ", 5, 2632, 0, 0),
            row(set, 1, " ", 6, 2706, 0, 0),
            row(setup_loop, 1, " ", 1, 32, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 13),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(address, 1, " ", 6, 0, 0, 0),
            row(text, 1, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 6, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(add, 1, "", 6, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(set, 2, " ", 2, 17, 0, 0),
            row(set, 2, " ", 4, 2564, 0, 0),
            row(set, 2, " ", 5, 2636, 0, 0),
            row(setup_loop, 2, " ", 1, 32, 6, 2710),
            row(loop, 2, " ", 7, 0, 8, 13),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(address, 2, " ", 5, 0, 0, 0),
            row(text, 2, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 5, 0, 1, 1),
            row(address, 2, " ", 6, 0, 0, 0),
            row(text, 2, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 6, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 5, 1),
            row(add, 2, "", 6, 1, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 40),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2568, 2631, 0),
            row(2632, 2639, 1),
            row(2640, 2703, 1),
            row(2704, 2704, 1),
            row(2705, 2705, 1),
            row(2706, 2713, 1),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(3, 22, none, 1, 0),
            row(1, 22, oe, 1, 1),
            row(6, 21, none, 2, 0),
            row(4, 21, oe, 2, 1),
            row(9, 20, none, 3, 0),
            row(7, 20, oe, 3, 1),
            row(12, 19, none, 4, 0),
            row(10, 19, oe, 4, 1),
            row(15, 17, none, 5, 0),
            row(13, 17, oe, 5, 1),
            row(18, 16, none, 6, 0),
            row(16, 16, oe, 6, 1),
            row(21, 15, none, 7, 0),
            row(19, 15, oe, 7, 1),
            row(24, 14, none, 8, 0),
            row(22, 14, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
