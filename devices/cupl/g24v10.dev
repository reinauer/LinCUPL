            row(30, 16, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

    alternatives {
        columns = [device, condition, priority]
        rows = [
            row("g24v10ms", uses_d, 4),
            row("g24v10ma", uses_combinational, 3),
            row("g24v10ma", uses_oe, 2),
            row("g24v10s", always, 1),
