# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g24v10 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 21
        supply = 7
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 3492
        default = 0
    }

    signature {
        bits = 80
        first_fuse = 3862
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 10
        clocked_resources = 10
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 31
        input_line_slots = 29
        extra_symbols = 10
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type]
        rows = [
            row(1, 1, unspecified),
            row(2, 2, unspecified),
            row(3, 3, unspecified),
            row(4, 4, unspecified),
            row(5, 5, unspecified),
            row(6, 6, unspecified),
            row(7, 8, unspecified),
            row(8, 9, unspecified),
            row(9, 10, unspecified),
            row(10, 11, unspecified),
            row(11, 12, unspecified),
            row(12, 13, unspecified),
            row(13, 14, unspecified),
            row(14, 15, unspecified),
            row(15, 16, unspecified),
            row(16, 17, unspecified),
            row(17, 18, unspecified),
            row(18, 19, unspecified),
            row(19, 20, unspecified),
            row(20, 22, unspecified),
            row(21, 23, unspecified),
            row(22, 24, unspecified),
            row(23, 25, unspecified),
            row(24, 26, unspecified),
            row(25, 27, unspecified),
            row(26, 28, unspecified),
            row(27, 14, ground),
            row(28, 28, supply),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, row_width, max_terms, default_rule, has_default, sharing_mode, active, legacy_width]
        rows = [
            row(1, 26, array, control, 48, 1, 0, no, 0, no, 48),
            row(1, 26, oe, control, 0, 0, 2, no, 0, no, 0),
            row(2, 26, array, negative, 48, 7, 0, no, 0, no, 48),
            row(2, 26, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(2, 26, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(3, 26, array, negative, 48, 8, 0, no, 0, no, 48),
            row(3, 26, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(3, 26, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(4, 25, array, control, 48, 1, 0, no, 0, no, 48),
            row(4, 25, oe, control, 0, 0, 2, no, 0, no, 0),
            row(5, 25, array, negative, 48, 7, 0, no, 0, no, 48),
            row(5, 25, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(5, 25, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(6, 25, array, negative, 48, 8, 0, no, 0, no, 48),
            row(6, 25, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(6, 25, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(7, 24, array, control, 48, 1, 0, no, 0, no, 48),
            row(7, 24, oe, control, 0, 0, 2, no, 0, no, 0),
            row(8, 24, array, negative, 48, 7, 0, no, 0, no, 48),
            row(8, 24, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(8, 24, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(9, 24, array, negative, 48, 8, 0, no, 0, no, 48),
            row(9, 24, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(9, 24, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(10, 23, array, control, 48, 1, 0, no, 0, no, 48),
            row(10, 23, oe, control, 0, 0, 2, no, 0, no, 0),
            row(11, 23, array, negative, 48, 7, 0, no, 0, no, 48),
            row(11, 23, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(11, 23, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(12, 23, array, negative, 48, 8, 0, no, 0, no, 48),
            row(12, 23, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(12, 23, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(13, 22, array, control, 48, 1, 0, no, 0, no, 48),
            row(13, 22, oe, control, 0, 0, 2, no, 0, no, 0),
            row(14, 22, array, negative, 48, 7, 0, no, 0, no, 48),
            row(14, 22, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(14, 22, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(15, 22, array, negative, 48, 8, 0, no, 0, no, 48),
            row(15, 22, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(15, 22, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(16, 20, array, control, 48, 1, 0, no, 0, no, 48),
            row(16, 20, oe, control, 0, 0, 2, no, 0, no, 0),
            row(17, 20, array, negative, 48, 7, 0, no, 0, no, 48),
            row(17, 20, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(17, 20, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(18, 20, array, negative, 48, 8, 0, no, 0, no, 48),
            row(18, 20, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(18, 20, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(19, 19, array, control, 48, 1, 0, no, 0, no, 48),
            row(19, 19, oe, control, 0, 0, 2, no, 0, no, 0),
            row(20, 19, array, negative, 48, 7, 0, no, 0, no, 48),
            row(20, 19, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(20, 19, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(21, 19, array, negative, 48, 8, 0, no, 0, no, 48),
            row(21, 19, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(21, 19, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(22, 18, array, control, 48, 1, 0, no, 0, no, 48),
            row(22, 18, oe, control, 0, 0, 2, no, 0, no, 0),
            row(23, 18, array, negative, 48, 8, 0, no, 0, no, 48),
            row(23, 18, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(23, 18, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
