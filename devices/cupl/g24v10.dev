            row(24, 18, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(25, 17, array, control, 48, 1, 0, no, 0, no, 48),
            row(25, 17, oe, control, 0, 0, 2, no, 0, no, 0),
            row(26, 17, array, negative, 48, 8, 0, no, 0, no, 48),
            row(26, 17, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(26, 17, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(27, 17, array, negative, 48, 8, 0, no, 0, no, 48),
            row(27, 17, d, programmable_positive, 0, 0, 0, no, 1, yes, 0),
            row(27, 17, d, programmable_negative, 0, 0, 0, no, 1, yes, 0),
            row(28, 16, array, control, 48, 1, 0, no, 0, no, 48),
            row(28, 16, oe, control, 0, 0, 2, no, 0, no, 0),
            row(29, 16, array, negative, 48, 8, 0, no, 0, no, 48),
            row(29, 16, none, programmable_positive, 0, 0, 0, yes, 1, yes, 0),
            row(29, 16, none, programmable_negative, 0, 0, 0, yes, 1, yes, 0),
            row(30, 16, array, negative, 48, 8, 0, no, 0, no, 48),
