    connections {
        defaults {
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin, compiler_link]
        rows = [
            row(2, 27, none, 1, 0, 0, yes),
            row(1, 27, oe, 1, 1, 0, yes),
