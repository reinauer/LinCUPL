# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20rs8lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 3338
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 19
        family = 1
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 80
        initial_term_capacity = 70
        array_slots = 9
        input_line_slots = 29
        extra_symbols = 2
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 10
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, clock, 0, 0),
            row(2, 3, unspecified, 0, 1),
            row(3, 27, feedback, 2, 3),
            row(4, 4, unspecified, 4, 5),
            row(5, 26, register_feedback, 6, 7),
            row(6, 5, unspecified, 8, 9),
            row(7, 25, register_feedback, 10, 11),
            row(8, 6, unspecified, 12, 13),
            row(9, 24, register_feedback, 14, 15),
            row(10, 7, unspecified, 16, 17),
            row(11, 23, register_feedback, 18, 19),
            row(12, 9, unspecified, 20, 21),
            row(13, 21, register_feedback, 22, 23),
            row(14, 10, unspecified, 24, 25),
            row(15, 20, register_feedback, 26, 27),
            row(16, 11, unspecified, 28, 29),
            row(17, 19, register_feedback, 30, 31),
            row(18, 12, unspecified, 32, 33),
            row(19, 18, register_feedback, 34, 35),
            row(20, 13, unspecified, 36, 37),
            row(21, 17, feedback, 38, 39),
            row(22, 16, output_enable, 0, 0),
            row(23, 14, ground, 0, 0),
            row(24, 28, supply, 0, 0),
            row(25, 1, not_connected, 0, 0),
            row(26, 8, not_connected, 0, 0),
            row(27, 15, not_connected, 0, 0),
            row(28, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, sharing_mode, active]
        rows = [
            row(1, 27, array, control, 0, 0, 0, 40, 0, 1, 0, no, 0, no),
            row(1, 27, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
