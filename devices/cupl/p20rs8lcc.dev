            row(4, 23, d, 3, 0, 0, no),
            row(5, 21, d, 3, 0, 0, no),
            row(5, 20, d, 3, 0, 0, no),
            row(6, 19, d, 3, 0, 0, no),
            row(6, 18, d, 3, 0, 0, no),
            row(22, 16, oe_term, 4, 1, 1, no),
            row(3, 26, d, 4, 0, 0, no),
