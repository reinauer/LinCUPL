            row(4, 23, d, programmable_positive, 1, 3204, 1, 1, 0, 0, 0, no, 0, yes),
            row(4, 23, d, programmable_negative, 0, 3204, 1, 1, 0, 0, 0, no, 0, yes),
            row(4, 23, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no),
            row(5, 0, array, negative, 0, 1600, 3274, 40, 2, 16, 0, no, 0, no),
            row(5, 21, d, programmable_positive, 1, 3205, 0, 1, 0, 0, 0, no, 0, yes),
            row(5, 21, d, programmable_negative, 0, 3205, 0, 1, 0, 0, 0, no, 0, yes),
            row(5, 21, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no),
