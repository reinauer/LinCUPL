            row(5, 20, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no),
            row(6, 0, array, negative, 0, 2240, 3306, 40, 2, 16, 0, no, 0, no),
            row(6, 19, d, programmable_positive, 1, 3207, 0, 1, 0, 0, 0, no, 0, yes),
            row(6, 19, d, programmable_negative, 0, 3207, 0, 1, 0, 0, 0, no, 0, yes),
            row(6, 19, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no),
            row(6, 18, d, programmable_positive, 1, 3208, 1, 1, 0, 0, 0, no, 0, yes),
            row(6, 18, d, programmable_negative, 0, 3208, 1, 1, 0, 0, 0, no, 0, yes),
            row(6, 18, none, unspecified, 0, 0, 0, 0, 0, 0, 0, no, 2, no),
            row(7, 17, array, control, 0, 3160, 0, 40, 0, 1, 0, no, 0, no),
            row(7, 17, oe, control, 0, 0, 0, 0, 0, 0, 2, no, 0, no),
            row(8, 17, array, negative, 0, 2880, 0, 40, 0, 7, 0, no, 0, no),
