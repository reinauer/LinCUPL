# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p18cv8 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 2696
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 2
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 74
        initial_term_capacity = 140
        array_slots = 20
        input_line_slots = 21
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 1
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("d", d),
            row("ar", ar),
            row("sp", sp),
            row("int", int),
            row("dfb", dfb),
            row("io", io),
        ]
    }

    pin_functions {
        columns = [line, pin, function, compiler_type, variant, true_column, complement_column, config_value, config_bits, config_first_fuse]
        rows = [
            row(1, 1, none, clock_input, default, 0, 1, 0, 0, 0),
