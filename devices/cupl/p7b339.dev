# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p7b339 {
    representation = library

    package {
        pins = 28
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 8
        supply = 22
    }

    fuses {
        count = 768
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 32
        initial_term_capacity = 140
        array_slots = 9
        input_line_slots = 21
        extra_symbols = 16
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "l"
            function = l
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 0, 1),
            row(2, 2, unspecified, 2, 3),
            row(3, 3, unspecified, 4, 5),
            row(4, 4, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 6, unspecified, 10, 11),
            row(7, 9, unspecified, 12, 13),
            row(8, 10, unspecified, 14, 15),
            row(9, 11, unspecified, 16, 17),
            row(10, 12, unspecified, 18, 19),
            row(11, 13, unspecified, 20, 21),
            row(12, 14, unspecified, 22, 23),
            row(13, 15, output_enable, 0, 0),
            row(14, 28, clock, 0, 0),
            row(15, 8, ground, 0, 0),
            row(16, 20, ground, 0, 0),
            row(17, 21, ground, 0, 0),
            row(18, 23, ground, 0, 0),
            row(19, 7, supply, 0, 0),
            row(20, 22, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            select_value = 0
            config_value = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, first_row_fuse, row_width, max_terms, has_default, sharing_mode, active]
        rows = [
            row(1, 27, l, negative, 0, 0, 0, yes, 0, yes),
            row(1, 27, none, unspecified, 0, 0, 0, no, 2, no),
            row(1, 27, array, negative, 0, 24, 4, no, 0, no),
            row(2, 26, l, negative, 0, 0, 0, yes, 0, yes),
            row(2, 26, none, unspecified, 0, 0, 0, no, 2, no),
            row(2, 26, array, negative, 96, 24, 4, no, 0, no),
            row(3, 25, l, negative, 0, 0, 0, yes, 0, yes),
            row(3, 25, none, unspecified, 0, 0, 0, no, 2, no),
            row(3, 25, array, negative, 192, 24, 4, no, 0, no),
            row(4, 24, l, negative, 0, 0, 0, yes, 0, yes),
            row(4, 24, none, unspecified, 0, 0, 0, no, 2, no),
            row(4, 24, array, negative, 288, 24, 4, no, 0, no),
            row(5, 19, l, negative, 0, 0, 0, yes, 0, yes),
            row(5, 19, none, unspecified, 0, 0, 0, no, 2, no),
            row(5, 19, array, negative, 384, 24, 4, no, 0, no),
            row(6, 18, l, negative, 0, 0, 0, yes, 0, yes),
            row(6, 18, none, unspecified, 0, 0, 0, no, 2, no),
            row(6, 18, array, negative, 480, 24, 4, no, 0, no),
            row(7, 17, l, negative, 0, 0, 0, yes, 0, yes),
            row(7, 17, none, unspecified, 0, 0, 0, no, 2, no),
            row(7, 17, array, negative, 576, 24, 4, no, 0, no),
            row(8, 16, l, negative, 0, 0, 0, yes, 0, yes),
            row(8, 16, none, unspecified, 0, 0, 0, no, 2, no),
            row(8, 16, array, negative, 672, 24, 4, no, 0, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 1, 16, 2, 27),
            row(loop, 1, " ", 3, 0, 4, 2),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(newline, 1, "", 1, 0, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 24),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 24),
            row(setup_loop, 2, " ", 1, 16, 2, 19),
            row(loop, 2, " ", 3, 0, 4, 2),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(newline, 2, "", 1, 0, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 24),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 24),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(14, 28, ck, 1, 1, 1),
            row(1, 27, l, 1, 0, 0),
            row(2, 26, l, 1, 0, 0),
            row(3, 25, l, 1, 0, 0),
            row(4, 24, l, 1, 0, 0),
            row(5, 19, l, 1, 0, 0),
            row(6, 18, l, 1, 0, 0),
            row(7, 17, l, 1, 0, 0),
            row(8, 16, l, 1, 0, 0),
            row(13, 15, oe_term, 2, 1, 1),
            row(1, 27, l, 2, 0, 0),
            row(2, 26, l, 2, 0, 0),
            row(3, 25, l, 2, 0, 0),
            row(4, 24, l, 2, 0, 0),
            row(5, 19, l, 2, 0, 0),
            row(6, 18, l, 2, 0, 0),
            row(7, 17, l, 2, 0, 0),
            row(8, 16, l, 2, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
