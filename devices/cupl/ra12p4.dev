# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ra12p4 {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 10
        supply = 20
    }

    fuses {
        count = 16384
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 4
        family = prom
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 4096
        initial_term_capacity = 70
        array_slots = 2
        input_line_slots = 17
        extra_symbols = 0
        download = ascii_hex
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 12
        data_width = 4
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 131072
        }
        columns = [line, pin, compiler_type, true_column]
        rows = [
            row(1, 1, unspecified, 8),
            row(2, 2, unspecified, 7),
            row(3, 3, unspecified, 6),
            row(4, 4, unspecified, 5),
            row(5, 5, unspecified, 4),
            row(6, 6, unspecified, 3),
            row(7, 7, unspecified, 2),
            row(8, 8, unspecified, 1),
            row(9, 9, unspecified, 0),
            row(10, 10, ground, 0),
            row(11, 15, output_enable, 0),
            row(12, 16, output_enable, 0),
            row(13, 17, unspecified, 11),
            row(14, 18, unspecified, 10),
            row(15, 19, unspecified, 9),
            row(16, 20, supply, 0),
        ]
    }

    node_functions {
        defaults {
            array = 1
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 131072
            config_first_fuse = 131072
            pair_first_fuse = 0
            row_width = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [pin, function, polarity, first_or_fuse, or_width, max_terms, active]
        rows = [
            row(14, none, programmable_negative, 0, 0, 0, yes),
            row(14, none, programmable_positive, 0, 0, 0, yes),
            row(13, none, programmable_negative, 1, 0, 0, yes),
            row(13, none, programmable_positive, 1, 0, 0, yes),
            row(12, none, programmable_negative, 2, 0, 0, yes),
            row(12, none, programmable_positive, 2, 0, 0, yes),
            row(11, none, programmable_negative, 3, 0, 0, yes),
            row(11, none, programmable_positive, 3, 0, 0, yes),
            row(0, array, positive, 0, 4, 4096, no),
        ]
    }

    plot {
        defaults {
            group = 0
            text = ""
            a = 0
            b = 0
            c = 0
            d = 0
        }
        columns = [operation]
        rows = [
            row(begin_fuses),
            row(prom),
            row(end),
        ]
    }

    connections {
        defaults {
            group = 1
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(11, 15, oe, 1, 1),
            row(12, 16, oe, 1, 1),
            row(1, 14, none, 0, 0),
            row(1, 13, none, 0, 0),
            row(1, 12, none, 0, 0),
            row(1, 11, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
