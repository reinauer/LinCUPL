# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f168lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 6
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 3553
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 5
        family = ifl
        extra_nodes_a = 1
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 14
        clocked_resources = 14
        default_extension = none
        product_rows = 48
        initial_term_capacity = 70
        array_slots = 4
        input_line_slots = 32
        extra_symbols = 0
        download = jedec_and_hl
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = high
        preload_polarity = 0
    }

    sequence {
        next_function = s
        next_alternate = r
        next_count = 2
        input_function = s
        input_alternate = r
        input_count = 2
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("s", s),
            row("r", r),
            row("ca", ca),
            row("oe", oe),
            row("ap", ap),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
