# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device mach120 {
    representation = library

    package {
        pins = 68
        drawing_style = 1
        internal_nodes = 48
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 12080
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 4
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 48
        extra_nodes_c = 0
        register_resources = 48
        clocked_resources = 48
        default_extension = none
        product_rows = 216
        initial_term_capacity = 480
        array_slots = 161
        input_line_slots = 117
        extra_symbols = 240
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 1
        power_up = low
        preload_polarity = 1
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 48
    }

    fitter {
        input_format = 10
        name = "machfitr"
        arguments = ""
        pla_options = [alternate_keywords, jedec_keyword, omit_plus]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("ap", ap),
            row("ar", ar),
            row("ckmux", ckmux),
            row("oe", oe),
            row("oemux", oemux),
            row("int", int),
            row("io", io),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "REG"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "C"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "C"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", "FB"),
        ]
    }

    pin_functions {
        defaults {
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type, variant, true_column, complement_column]
        rows = [
            row(0, 0, none, not_connected, default, 0, 0),
            row(1, 1, none, ground, default, 0, 0),
            row(2, 2, none, feedback, default, 0, 1),
            row(2, 2, none, registered, d, 0, 1),
            row(2, 2, none, registered, t, 0, 1),
            row(2, 2, none, registered, l, 0, 1),
            row(2, 2, int, register_feedback, default, 0, 1),
            row(2, 2, io, combinational, d, 0, 1),
