            row(158, 67, d, 145, 0, 0, yes, 0),
            row(158, 67, t, 145, 0, 0, yes, 0),
            row(158, 67, l, 145, 0, 0, yes, 0),
            row(158, 105, d, 145, 0, 0, yes, 0),
            row(158, 105, t, 145, 0, 0, yes, 0),
            row(158, 105, l, 145, 0, 0, yes, 0),
        ]
    }

    fitter_arguments {
        defaults {
            text = ""
        }
        columns = [kind]
        rows = [
            row(pla_file),
            row(none),
        ]
    }

}
