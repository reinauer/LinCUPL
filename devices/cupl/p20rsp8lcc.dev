# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20rsp8lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    fuses {
        count = 2696
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = 2
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 8
        clocked_resources = 8
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 5
        input_line_slots = 29
        extra_symbols = 2
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("oe", oe),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 2, clock, 0, 0),
            row(2, 3, unspecified, 0, 1),
            row(3, 27, unspecified, 2, 3),
            row(4, 4, unspecified, 4, 5),
            row(5, 26, register_feedback, 6, 7),
            row(6, 5, unspecified, 8, 9),
            row(7, 25, register_feedback, 10, 11),
            row(8, 6, unspecified, 12, 13),
            row(9, 24, register_feedback, 14, 15),
            row(10, 7, unspecified, 16, 17),
            row(11, 23, register_feedback, 18, 19),
            row(12, 9, unspecified, 20, 21),
            row(13, 21, register_feedback, 22, 23),
            row(14, 10, unspecified, 24, 25),
            row(15, 20, register_feedback, 26, 27),
            row(16, 11, unspecified, 28, 29),
            row(17, 19, register_feedback, 30, 31),
            row(18, 12, unspecified, 32, 33),
            row(19, 18, register_feedback, 34, 35),
            row(20, 13, unspecified, 36, 37),
            row(21, 17, unspecified, 38, 39),
            row(22, 16, output_enable, 0, 0),
            row(23, 14, ground, 0, 0),
            row(24, 28, supply, 0, 0),
            row(25, 1, not_connected, 0, 0),
            row(26, 8, not_connected, 0, 0),
            row(27, 15, not_connected, 0, 0),
            row(28, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, sharing_mode, active]
        rows = [
            row(1, 0, array, negative, 0, 0, 2568, 40, 2, 16, 0, no),
            row(1, 26, d, programmable_positive, 1, 2560, 0, 1, 0, 0, 0, yes),
            row(1, 26, d, programmable_negative, 0, 2560, 0, 1, 0, 0, 0, yes),
            row(1, 26, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(1, 25, d, programmable_positive, 1, 2561, 1, 1, 0, 0, 0, yes),
            row(1, 25, d, programmable_negative, 0, 2561, 1, 1, 0, 0, 0, yes),
            row(1, 25, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(2, 0, array, negative, 0, 640, 2600, 40, 2, 16, 0, no),
            row(2, 24, d, programmable_positive, 1, 2562, 0, 1, 0, 0, 0, yes),
            row(2, 24, d, programmable_negative, 0, 2562, 0, 1, 0, 0, 0, yes),
            row(2, 24, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(2, 23, d, programmable_positive, 1, 2563, 1, 1, 0, 0, 0, yes),
            row(2, 23, d, programmable_negative, 0, 2563, 1, 1, 0, 0, 0, yes),
            row(2, 23, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(3, 0, array, negative, 0, 1280, 2632, 40, 2, 16, 0, no),
            row(3, 21, d, programmable_positive, 1, 2564, 0, 1, 0, 0, 0, yes),
            row(3, 21, d, programmable_negative, 0, 2564, 0, 1, 0, 0, 0, yes),
            row(3, 21, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(3, 20, d, programmable_positive, 1, 2565, 1, 1, 0, 0, 0, yes),
            row(3, 20, d, programmable_negative, 0, 2565, 1, 1, 0, 0, 0, yes),
            row(3, 20, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(4, 0, array, negative, 0, 1920, 2664, 40, 2, 16, 0, no),
            row(4, 19, d, programmable_positive, 1, 2566, 0, 1, 0, 0, 0, yes),
            row(4, 19, d, programmable_negative, 0, 2566, 0, 1, 0, 0, 0, yes),
            row(4, 19, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
            row(4, 18, d, programmable_positive, 1, 2567, 1, 1, 0, 0, 0, yes),
            row(4, 18, d, programmable_negative, 0, 2567, 1, 1, 0, 0, 0, yes),
            row(4, 18, none, unspecified, 0, 0, 0, 0, 0, 0, 2, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 26, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 5, 2568),
            row(if_equal, 1, " ", 1, 33, 0, 1),
            row(set, 1, " ", 2, 21, 0, 0),
            row(loop, 1, " ", 7, 0, 16, 12),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(address, 1, "  ", 5, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 2),
            row(add, 1, " ", 5, 2, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, group, member, source_pin]
        rows = [
            row(1, 2, ck, 1, 1, 1),
            row(1, 26, d, 1, 0, 0),
            row(1, 25, d, 1, 0, 0),
            row(2, 24, d, 1, 0, 0),
            row(2, 23, d, 1, 0, 0),
            row(3, 21, d, 1, 0, 0),
            row(3, 20, d, 1, 0, 0),
            row(4, 19, d, 1, 0, 0),
            row(4, 19, d, 1, 0, 0),
            row(22, 16, oe_term, 2, 1, 1),
            row(1, 26, d, 2, 0, 0),
            row(1, 25, d, 2, 0, 0),
            row(2, 24, d, 2, 0, 0),
            row(2, 23, d, 2, 0, 0),
            row(3, 21, d, 2, 0, 0),
            row(3, 20, d, 2, 0, 0),
            row(4, 19, d, 2, 0, 0),
            row(4, 19, d, 2, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
