# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device mach465 {
    representation = library

    package {
        pins = 208
        drawing_style = 1
        internal_nodes = 255
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 121185
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 255
        extra_nodes_c = 0
        register_resources = 255
        clocked_resources = 255
        default_extension = none
        product_rows = 1440
        initial_term_capacity = 2000
        array_slots = 1
        input_line_slots = 255
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 1
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 128
    }

    fitter {
        input_format = 10
        name = "machfitr"
        arguments = ""
        pla_options = [alternate_keywords, jedec_keyword, omit_plus]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("t", t),
            row("l", l),
            row("dq", dq),
            row("lq", lq),
            row("ap", ap),
            row("ar", ar),
            row("ck", ck),
            row("ckmux", ckmux),
            row("le", le),
            row("lemux", lemux),
            row("oe", oe),
            row("oemux", oemux),
            row("int", int),
            row("io", io),
            row("iod", iod),
            row("iol", iol),
            row("iock", iock),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "REG"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "C"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "C"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("r", "R"),
            row("s", "S"),
            row("reg", "FB"),
        ]
    }

    pin_functions {
        defaults {
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, function, compiler_type]
        rows = [
            row(0, 0, none, not_connected),
            row(1, 1, none, ground),
            row(2, 2, none, unspecified),
            row(3, 3, none, feedback),
            row(3, 3, none, register_feedback),
            row(3, 3, int, register_feedback),
            row(3, 3, io, combinational),
            row(3, 3, iod, combinational),
            row(3, 3, iol, combinational),
            row(3, 3, dq, unspecified),
