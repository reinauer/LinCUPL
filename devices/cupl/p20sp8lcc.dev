# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device p20sp8lcc {
    representation = library

    package {
        pins = 28
        drawing_style = 4
        internal_nodes = 0
    }

    power {
        ground = 14
        supply = 28
    }

    compatibility {
        attribute_4 = 0
        attribute_5 = 0
        attribute_7 = 0
        attribute_20 = 1
    }

    fuses {
        count = 2680
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = 2
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 13
        input_line_slots = 27
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 2
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        defaults {
            name = "oe"
            function = oe
        }
        columns = []
        rows = [
            row(),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 3, unspecified, 0, 1),
            row(2, 2, unspecified, 2, 3),
            row(3, 4, unspecified, 4, 5),
            row(4, 27, unspecified, 6, 7),
            row(5, 5, unspecified, 8, 9),
            row(6, 25, feedback, 10, 11),
            row(7, 6, unspecified, 12, 13),
            row(8, 24, feedback, 14, 15),
            row(9, 7, unspecified, 16, 17),
            row(10, 23, feedback, 18, 19),
            row(11, 9, unspecified, 20, 21),
            row(12, 21, feedback, 22, 23),
            row(13, 10, unspecified, 24, 25),
            row(14, 20, feedback, 26, 27),
            row(15, 11, unspecified, 28, 29),
            row(16, 19, feedback, 30, 31),
            row(17, 12, unspecified, 32, 33),
            row(18, 17, unspecified, 34, 35),
            row(19, 13, unspecified, 36, 37),
            row(20, 16, unspecified, 38, 39),
            row(21, 14, ground, 0, 0),
            row(22, 28, supply, 0, 0),
            row(23, 1, not_connected, 0, 0),
            row(24, 8, not_connected, 0, 0),
            row(25, 15, not_connected, 0, 0),
            row(26, 22, not_connected, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, default_rule, has_default, active, legacy_width]
        rows = [
            row(1, 26, array, control, 0, 0, 0, 40, 0, 1, 0, no, no, 40),
            row(1, 26, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(2, 25, array, control, 0, 600, 0, 40, 0, 1, 0, no, no, 40),
            row(2, 25, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(3, 0, array, negative, 0, 40, 2568, 40, 2, 14, 0, no, no, 0),
            row(3, 26, none, programmable_positive, 1, 2560, 0, 1, 0, 0, 0, yes, yes, 0),
            row(3, 26, none, programmable_negative, 0, 2560, 0, 1, 0, 0, 0, yes, yes, 0),
            row(3, 25, none, programmable_positive, 1, 2561, 1, 1, 0, 0, 0, yes, yes, 0),
            row(3, 25, none, programmable_negative, 0, 2561, 1, 1, 0, 0, 0, yes, yes, 0),
            row(4, 24, array, control, 0, 640, 0, 40, 0, 1, 0, no, no, 40),
            row(4, 24, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(5, 23, array, control, 0, 1240, 0, 40, 0, 1, 0, no, no, 40),
            row(5, 23, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(6, 0, array, negative, 0, 680, 2596, 40, 2, 14, 0, no, no, 0),
            row(6, 24, none, programmable_positive, 1, 2562, 0, 1, 0, 0, 0, yes, yes, 0),
            row(6, 24, none, programmable_negative, 0, 2562, 0, 1, 0, 0, 0, yes, yes, 0),
            row(6, 23, none, programmable_positive, 1, 2563, 1, 1, 0, 0, 0, yes, yes, 0),
            row(6, 23, none, programmable_negative, 0, 2563, 1, 1, 0, 0, 0, yes, yes, 0),
            row(7, 21, array, control, 0, 1280, 0, 40, 0, 1, 0, no, no, 40),
            row(7, 21, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(8, 20, array, control, 0, 1880, 0, 40, 0, 1, 0, no, no, 40),
            row(8, 20, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(9, 0, array, negative, 0, 1320, 2624, 40, 2, 14, 0, no, no, 0),
            row(9, 21, none, programmable_positive, 1, 2564, 0, 1, 0, 0, 0, yes, yes, 0),
            row(9, 21, none, programmable_negative, 0, 2564, 0, 1, 0, 0, 0, yes, yes, 0),
            row(9, 20, none, programmable_positive, 1, 2565, 1, 1, 0, 0, 0, yes, yes, 0),
            row(9, 20, none, programmable_negative, 0, 2565, 1, 1, 0, 0, 0, yes, yes, 0),
            row(10, 19, array, control, 0, 1920, 0, 40, 0, 1, 0, no, no, 40),
            row(10, 19, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(11, 18, array, control, 0, 2520, 0, 40, 0, 1, 0, no, no, 40),
            row(11, 18, oe, control, 0, 0, 0, 0, 0, 0, 2, no, no, 0),
            row(12, 0, array, negative, 0, 1960, 2652, 40, 2, 14, 0, no, no, 0),
            row(12, 19, none, programmable_positive, 1, 2566, 0, 1, 0, 0, 0, yes, yes, 0),
            row(12, 19, none, programmable_negative, 0, 2566, 0, 1, 0, 0, 0, yes, yes, 0),
            row(12, 18, none, programmable_positive, 1, 2567, 1, 1, 0, 0, 0, yes, yes, 0),
            row(12, 18, none, programmable_negative, 0, 2567, 1, 1, 0, 0, 0, yes, yes, 0),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 2, 26, 0, 0),
            row(set, 1, " ", 4, 2560, 0, 0),
            row(setup_loop, 1, " ", 1, 64, 5, 2568),
            row(if_equal, 1, " ", 1, 33, 0, 1),
            row(set, 1, " ", 2, 21, 0, 0),
            row(loop, 1, " ", 7, 0, 16, 12),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 40),
            row(if_equal, 1, " ", 1, 1, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 17),
            row(if_equal, 1, " ", 1, 16, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 15),
            row(if_equal, 1, " ", 1, 17, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 13),
            row(if_equal, 1, " ", 1, 32, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 11),
            row(if_equal, 1, " ", 1, 33, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 9),
            row(if_equal, 1, " ", 1, 48, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 7),
            row(if_equal, 1, " ", 1, 49, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 5),
            row(if_equal, 1, " ", 1, 64, 0, 1),
            row(if_equal, 1, " ", 1, 65, 0, 3),
            row(address, 1, "  ", 5, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 2),
            row(add, 1, " ", 5, 2, 0, 0),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 40),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(3, 26, none, 1, 0),
            row(1, 26, oe, 1, 1),
            row(3, 25, none, 2, 0),
            row(2, 25, oe, 2, 1),
            row(6, 24, none, 3, 0),
            row(4, 24, oe, 3, 1),
            row(6, 23, none, 4, 0),
            row(5, 23, oe, 4, 1),
            row(9, 21, none, 5, 0),
            row(7, 21, oe, 5, 1),
            row(9, 20, none, 6, 0),
            row(8, 20, oe, 6, 1),
            row(12, 19, none, 7, 0),
            row(10, 19, oe, 7, 1),
            row(12, 18, none, 8, 0),
            row(11, 18, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
