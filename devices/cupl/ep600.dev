# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device ep600 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 6482
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 14
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 16
        clocked_resources = 16
        default_extension = none
        product_rows = 160
        initial_term_capacity = 280
        array_slots = 49
        input_line_slots = 25
        extra_symbols = 32
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 1
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    sequence {
        next_function = d
        next_alternate = none
        next_count = 1
        input_function = d
        input_alternate = none
        input_count = 1
    }

    prom {
        address_bits = 0
        data_width = 16
    }

