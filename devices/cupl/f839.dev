# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f839 {
    representation = library

    package {
        pins = 24
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 12
        supply = 24
    }

    fuses {
        count = 1094
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 9
        family = ifl
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 32
        initial_term_capacity = 70
        array_slots = 2
        input_line_slots = 19
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 2
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 6
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 8, unspecified, 0, 1),
            row(2, 7, unspecified, 2, 3),
            row(3, 6, unspecified, 4, 5),
            row(4, 5, unspecified, 6, 7),
            row(5, 4, unspecified, 8, 9),
            row(6, 3, unspecified, 10, 11),
            row(7, 2, unspecified, 12, 13),
            row(8, 23, unspecified, 14, 15),
            row(9, 22, unspecified, 16, 17),
            row(10, 21, unspecified, 18, 19),
            row(11, 20, unspecified, 20, 21),
            row(12, 19, unspecified, 22, 23),
            row(13, 18, unspecified, 24, 25),
            row(14, 17, unspecified, 26, 27),
            row(15, 1, 15, 0, 0),
            row(16, 13, 15, 0, 0),
            row(17, 12, ground, 0, 0),
            row(18, 24, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            array = 1
            invert = no
            config_value = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            config_bits = 0
            pair_bits = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [pin, function, polarity, select_value, first_row_fuse, first_or_fuse, row_width, or_width, max_terms, active]
        rows = [
            row(16, none, programmable_positive, 0, 1088, 28, 1, 0, 0, yes),
            row(16, none, programmable_negative, 1, 1088, 28, 1, 0, 0, yes),
            row(15, none, programmable_positive, 0, 1089, 29, 1, 0, 0, yes),
            row(15, none, programmable_negative, 1, 1089, 29, 1, 0, 0, yes),
            row(14, none, programmable_positive, 0, 1090, 30, 1, 0, 0, yes),
            row(14, none, programmable_negative, 1, 1090, 30, 1, 0, 0, yes),
            row(11, none, programmable_positive, 0, 1091, 31, 1, 0, 0, yes),
            row(11, none, programmable_negative, 1, 1091, 31, 1, 0, 0, yes),
            row(10, none, programmable_positive, 0, 1092, 32, 1, 0, 0, yes),
            row(10, none, programmable_negative, 1, 1092, 32, 1, 0, 0, yes),
            row(9, none, programmable_positive, 0, 1093, 33, 1, 0, 0, yes),
            row(9, none, programmable_negative, 1, 1093, 33, 1, 0, 0, yes),
            row(0, array, programmable, 0, 0, 0, 28, 6, 32, no),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(set, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 1, " ", 6, 1, 0, 1088),
            row(address, 1, "", 0, 0, 0, 0),
            row(text, 1, "POL  ", 0, 0, 0, 0),
            row(text, 1, "        ", 0, 0, 0, 0),
            row(fuses_forward, 1, "HL", 0, 0, 1, 6),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 0),
            row(setup_loop, 2, " ", 8, 32, 1, 0),
            row(address, 2, "", 1, 0, 0, 0),
            row(fuses_forward, 2, "0HL-", 1, 0, 2, 28),
            row(fuses_forward, 2, "A.", 1, 28, 1, 6),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 1, 34),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    connections {
        defaults {
            group = 1
            compiler_link = no
            config_value = 0
        }
        columns = [line, pin, function, member, source_pin]
        rows = [
            row(15, 1, extension_20, 1, 1),
            row(16, 13, oe_term, 1, 1),
            row(1, 16, none, 0, 0),
            row(1, 15, none, 0, 0),
            row(1, 14, none, 0, 0),
            row(1, 11, none, 0, 0),
            row(1, 10, none, 0, 0),
            row(1, 9, none, 0, 0),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
