# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device f2852 {
    representation = library

    package {
        pins = 84
        drawing_style = 0
        internal_nodes = 36
    }

    power {
        ground = 0
        supply = 0
    }

    fuses {
        count = 51624
        default = 0
    }

    signature {
        bits = 0
        first_fuse = 0
    }

    compiler {
        revision = 1
        family = external_fitter
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 52
        clocked_resources = 16
        default_extension = none
        product_rows = 226
        initial_term_capacity = 200
        array_slots = 1
        input_line_slots = 121
        extra_symbols = 0
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = low
        preload_polarity = 0
    }

    prom {
        address_bits = 0
        data_width = 40
    }

    fitter {
        input_format = 12
        name = "pmlfit"
        arguments = ""
        pla_options = [tool_header, jedec_keyword]
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("d", d),
            row("j", j),
            row("k", k),
            row("oe", oe),
            row("ck", ck),
            row("ap", ap),
            row("ar", ar),
            row("dq", dq),
        ]
    }

    fitter_extensions {
        columns = [extension, alias]
        rows = [
            row("d", "D"),
            row("t", "T"),
            row("l", "G"),
            row("dq", "R"),
            row("tq", "R"),
            row("lq", "L"),
            row("oe", "OE"),
            row("ar", "AR"),
            row("ap", "AP"),
            row("sp", "PR"),
            row("sr", "RE"),
            row("ck", "C"),
            row("le", "LH"),
            row("io", "PIN"),
            row("iod", "R"),
            row("iol", "L"),
            row("ioar", "AR"),
            row("ioap", "AP"),
            row("iosp", "PR"),
            row("iosr", "RE"),
            row("iock", "C"),
            row("int", "X"),
            row("ckmux", "C"),
            row("lemux", "LH"),
            row("oemux", "OE"),
            row("j", "J"),
            row("k", "K"),
            row("ce", "CE"),
            row("reg", ""),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            true_column = 0
            complement_column = 0
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type]
        rows = [
            row(0, 0, not_connected),
            row(1, 1, register_feedback),
            row(1, 1, feedback),
            row(2, 2, register_feedback),
            row(2, 2, feedback),
            row(3, 3, register_feedback),
            row(3, 3, feedback),
            row(4, 4, supply),
            row(5, 5, register_feedback),
            row(5, 5, feedback),
            row(6, 6, register_feedback),
            row(6, 6, feedback),
            row(7, 7, register_feedback),
            row(7, 7, feedback),
            row(8, 8, register_feedback),
            row(9, 9, register_feedback),
            row(10, 10, register_feedback),
            row(11, 11, register_feedback),
            row(12, 12, unspecified),
            row(13, 13, unspecified),
            row(14, 14, unspecified),
            row(15, 15, unspecified),
            row(16, 16, unspecified),
            row(17, 17, unspecified),
            row(18, 18, unspecified),
            row(19, 19, ground),
            row(20, 20, unspecified),
            row(21, 21, unspecified),
            row(22, 22, unspecified),
            row(23, 23, unspecified),
            row(24, 24, clock_input),
            row(25, 25, supply),
            row(26, 26, clock_input),
            row(27, 27, clock_input),
            row(28, 28, clock_input),
            row(29, 29, unspecified),
            row(30, 30, unspecified),
            row(31, 31, unspecified),
            row(32, 32, unspecified),
            row(33, 33, supply),
            row(34, 34, unspecified),
            row(35, 35, unspecified),
            row(36, 36, unspecified),
            row(37, 37, unspecified),
            row(38, 38, unspecified),
            row(39, 39, unspecified),
            row(40, 40, ground),
            row(41, 41, unspecified),
            row(42, 42, unspecified),
            row(43, 43, unspecified),
            row(44, 44, clock_input),
            row(45, 45, unspecified),
            row(46, 46, supply),
            row(47, 47, unspecified),
            row(48, 48, unspecified),
            row(49, 49, unspecified),
            row(50, 50, register_feedback),
            row(51, 51, register_feedback),
            row(52, 52, register_feedback),
            row(53, 53, register_feedback),
            row(54, 54, register_feedback),
            row(55, 55, register_feedback),
            row(56, 56, register_feedback),
            row(57, 57, register_feedback),
            row(58, 58, register_feedback),
            row(58, 58, feedback),
            row(59, 59, register_feedback),
            row(59, 59, feedback),
            row(60, 60, register_feedback),
            row(60, 60, feedback),
            row(61, 61, ground),
            row(62, 62, register_feedback),
            row(62, 62, feedback),
            row(63, 63, register_feedback),
            row(63, 63, feedback),
            row(64, 64, register_feedback),
            row(64, 64, feedback),
            row(65, 65, register_feedback),
            row(65, 65, feedback),
            row(66, 66, register_feedback),
            row(66, 66, feedback),
            row(67, 67, supply),
            row(68, 68, clock_input),
            row(69, 69, register_feedback),
            row(69, 69, feedback),
            row(70, 70, register_feedback),
            row(70, 70, feedback),
            row(71, 71, register_feedback),
            row(72, 72, register_feedback),
            row(73, 73, register_feedback),
            row(74, 74, register_feedback),
            row(75, 75, register_feedback),
            row(75, 75, feedback),
            row(76, 76, register_feedback),
            row(76, 76, feedback),
            row(77, 77, register_feedback),
            row(77, 77, feedback),
            row(78, 78, register_feedback),
            row(78, 78, feedback),
            row(79, 79, register_feedback),
            row(79, 79, feedback),
            row(80, 80, register_feedback),
            row(80, 80, feedback),
            row(81, 81, clock_input),
            row(82, 82, ground),
            row(83, 83, register_feedback),
            row(83, 83, feedback),
            row(84, 84, register_feedback),
            row(84, 84, feedback),
            row(85, 85, register_feedback),
            row(86, 86, register_feedback),
            row(87, 87, register_feedback),
            row(88, 88, register_feedback),
            row(89, 89, register_feedback),
            row(90, 90, register_feedback),
            row(91, 91, register_feedback),
            row(92, 92, register_feedback),
            row(93, 93, register_feedback),
            row(94, 94, register_feedback),
            row(95, 95, register_feedback),
            row(96, 96, register_feedback),
            row(97, 97, register_feedback),
            row(98, 98, register_feedback),
            row(99, 99, register_feedback),
            row(100, 100, register_feedback),
            row(101, 101, register_feedback),
            row(102, 102, register_feedback),
            row(103, 103, register_feedback),
            row(104, 104, register_feedback),
            row(105, 105, register_feedback),
            row(106, 106, register_feedback),
            row(107, 107, register_feedback),
            row(108, 108, register_feedback),
            row(109, 109, register_feedback),
            row(110, 110, register_feedback),
            row(111, 111, register_feedback),
            row(112, 112, register_feedback),
            row(113, 113, register_feedback),
            row(114, 114, register_feedback),
            row(115, 115, register_feedback),
            row(116, 116, register_feedback),
            row(117, 117, register_feedback),
            row(118, 118, register_feedback),
            row(119, 119, register_feedback),
            row(120, 120, register_feedback),
        ]
    }

    node_functions {
        defaults {
            array = 0
            pin = 0
            function = none
            polarity = unspecified
            invert = no
            select_value = 0
            config_value = 0
            first_row_fuse = 0
            first_or_fuse = 0
            config_first_fuse = 0
            pair_first_fuse = 0
            row_width = 0
            or_width = 0
            config_bits = 0
            pair_bits = 0
            max_terms = 0
            split_terms = 0
            default_rule = 0
            has_default = no
            sharing_mode = 0
            active = no
            alternate_step = 0
        }
        columns = []
        rows = [
            row(),
        ]
    }

    fitter_arguments {
        defaults {
            text = ""
        }
        columns = [kind]
        rows = [
            row(pla_file),
            row(none),
        ]
    }

}
