# Device library interface; field values and record order are retained.
# Compiler modes are ABI settings, not inferred hardware properties.
format = 1

device g16vp8ma {
    representation = library

    package {
        pins = 20
        drawing_style = 0
        internal_nodes = 0
    }

    power {
        ground = 15
        supply = 5
    }

    fuses {
        count = 2202
        default = 0
    }

    signature {
        bits = 64
        first_fuse = 2056
    }

    compiler {
        revision = 1
        family = pal
        extra_nodes_a = 0
        extra_nodes_b = 0
        extra_nodes_c = 0
        register_resources = 0
        clocked_resources = 0
        default_extension = none
        product_rows = 64
        initial_term_capacity = 70
        array_slots = 25
        input_line_slots = 19
        extra_symbols = 8
        download = jedec
    }

    simulation {
        output_enable_mode = 0
        output_polarity_mode = 0
        internal_polarity_mode = 0
        power_up = unknown
        preload_polarity = 0
    }

    sequence {
        next_function = none
        next_alternate = none
        next_count = 0
        input_function = none
        input_alternate = none
        input_count = 0
    }

    prom {
        address_bits = 0
        data_width = 8
    }

    fitter {
        input_format = 0
        name = ""
        arguments = ""
        pla_options = []
        part = ""
    }

    extensions {
        columns = [name, function]
        rows = [
            row("oe", oe),
            row("tec", tec),
        ]
    }

    pin_functions {
        defaults {
            function = none
            variant = default
            config_value = 0
            config_bits = 0
            config_first_fuse = 0
        }
        columns = [line, pin, compiler_type, true_column, complement_column]
        rows = [
            row(1, 1, unspecified, 2, 3),
            row(2, 20, unspecified, 0, 1),
            row(3, 2, unspecified, 4, 5),
            row(4, 18, feedback, 6, 7),
            row(5, 3, unspecified, 8, 9),
            row(6, 17, feedback, 10, 11),
            row(7, 4, unspecified, 12, 13),
            row(8, 16, feedback, 14, 15),
            row(9, 6, unspecified, 16, 17),
            row(10, 14, feedback, 18, 19),
            row(11, 7, unspecified, 20, 21),
            row(12, 13, feedback, 22, 23),
            row(13, 8, unspecified, 24, 25),
            row(14, 12, feedback, 26, 27),
            row(15, 9, unspecified, 28, 29),
            row(16, 10, unspecified, 30, 31),
            row(17, 15, ground, 0, 0),
            row(18, 5, supply, 0, 0),
        ]
    }

    node_functions {
        defaults {
            invert = no
            first_or_fuse = 0
            pair_first_fuse = 0
            or_width = 0
            pair_bits = 0
            split_terms = 0
            sharing_mode = 0
            alternate_step = 0
        }
        columns = [array, pin, function, polarity, select_value, config_value, first_row_fuse, config_first_fuse, row_width, config_bits, max_terms, default_rule, has_default, active]
        rows = [
            row(1, 19, array, control, 0, 0, 0, 0, 32, 0, 1, 0, no, no),
            row(1, 19, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(2, 19, array, unspecified, 0, 0, 2194, 0, 1, 0, 1, 0, no, no),
            row(2, 19, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(3, 19, array, negative, 0, 0, 32, 0, 32, 0, 7, 0, no, no),
            row(3, 19, none, programmable_positive, 1, 1, 2048, 2120, 1, 1, 0, 0, yes, yes),
            row(3, 19, none, programmable_negative, 0, 1, 2048, 2120, 1, 1, 0, 0, yes, yes),
            row(4, 18, array, control, 0, 0, 256, 0, 32, 0, 1, 0, no, no),
            row(4, 18, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(5, 18, array, unspecified, 0, 0, 2195, 0, 1, 0, 1, 0, no, no),
            row(5, 18, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(6, 18, array, negative, 0, 0, 288, 0, 32, 0, 7, 0, no, no),
            row(6, 18, none, programmable_positive, 1, 1, 2049, 2121, 1, 1, 0, 0, yes, yes),
            row(6, 18, none, programmable_negative, 0, 1, 2049, 2121, 1, 1, 0, 0, yes, yes),
            row(7, 17, array, control, 0, 0, 512, 0, 32, 0, 1, 0, no, no),
            row(7, 17, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(8, 17, array, unspecified, 0, 0, 2196, 0, 1, 0, 1, 0, no, no),
            row(8, 17, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(9, 17, array, negative, 0, 0, 544, 0, 32, 0, 7, 0, no, no),
            row(9, 17, none, programmable_positive, 1, 1, 2050, 2122, 1, 1, 0, 0, yes, yes),
            row(9, 17, none, programmable_negative, 0, 1, 2050, 2122, 1, 1, 0, 0, yes, yes),
            row(10, 16, array, control, 0, 0, 768, 0, 32, 0, 1, 0, no, no),
            row(10, 16, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(11, 16, array, unspecified, 0, 0, 2197, 0, 1, 0, 1, 0, no, no),
            row(11, 16, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(12, 16, array, negative, 0, 0, 800, 0, 32, 0, 7, 0, no, no),
            row(12, 16, none, programmable_positive, 1, 1, 2051, 2123, 1, 1, 0, 0, yes, yes),
            row(12, 16, none, programmable_negative, 0, 1, 2051, 2123, 1, 1, 0, 0, yes, yes),
            row(13, 14, array, control, 0, 0, 1024, 0, 32, 0, 1, 0, no, no),
            row(13, 14, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(14, 14, array, unspecified, 0, 0, 2198, 0, 1, 0, 1, 0, no, no),
            row(14, 14, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(15, 14, array, negative, 0, 0, 1056, 0, 32, 0, 7, 0, no, no),
            row(15, 14, none, programmable_positive, 1, 1, 2052, 2124, 1, 1, 0, 0, yes, yes),
            row(15, 14, none, programmable_negative, 0, 1, 2052, 2124, 1, 1, 0, 0, yes, yes),
            row(16, 13, array, control, 0, 0, 1280, 0, 32, 0, 1, 0, no, no),
            row(16, 13, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(17, 13, array, unspecified, 0, 0, 2199, 0, 1, 0, 1, 0, no, no),
            row(17, 13, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(18, 13, array, negative, 0, 0, 1312, 0, 32, 0, 7, 0, no, no),
            row(18, 13, none, programmable_positive, 1, 1, 2053, 2125, 1, 1, 0, 0, yes, yes),
            row(18, 13, none, programmable_negative, 0, 1, 2053, 2125, 1, 1, 0, 0, yes, yes),
            row(19, 12, array, control, 0, 0, 1536, 0, 32, 0, 1, 0, no, no),
            row(19, 12, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(20, 12, array, unspecified, 0, 0, 2200, 0, 1, 0, 1, 0, no, no),
            row(20, 12, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(21, 12, array, negative, 0, 0, 1568, 0, 32, 0, 7, 0, no, no),
            row(21, 12, none, programmable_positive, 1, 1, 2054, 2126, 1, 1, 0, 0, yes, yes),
            row(21, 12, none, programmable_negative, 0, 1, 2054, 2126, 1, 1, 0, 0, yes, yes),
            row(22, 11, array, control, 0, 0, 1792, 0, 32, 0, 1, 0, no, no),
            row(22, 11, oe, control, 0, 0, 0, 0, 0, 0, 0, 2, no, no),
            row(23, 11, array, unspecified, 0, 0, 2201, 0, 1, 0, 1, 0, no, no),
            row(23, 11, tec, control, 0, 0, 0, 0, 0, 0, 0, 0, no, no),
            row(24, 11, array, negative, 0, 0, 1824, 0, 32, 0, 7, 0, no, no),
            row(24, 11, none, programmable_positive, 1, 1, 2055, 2127, 1, 1, 0, 0, yes, yes),
            row(24, 11, none, programmable_negative, 0, 1, 2055, 2127, 1, 1, 0, 0, yes, yes),
        ]
    }

    plot {
        columns = [operation, group, text, a, b, c, d]
        rows = [
            row(begin_fuses, 0, "", 0, 0, 0, 0),
            row(setup_loop, 0, " ", 1, 1, 0, 2192),
            row(text, 0, "Syn ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(add, 0, " ", 0, 1, 0, 0),
            row(text, 0, "Ac0 ", 0, 0, 0, 0),
            row(address, 0, " ", 0, 0, 0, 0),
            row(fuses_forward, 0, "x-", 0, 0, 1, 1),
            row(newline, 0, " ", 2, 0, 0, 0),
            row(end_row, 0, " ", 0, 0, 0, 0),
            row(set, 1, " ", 2, 19, 0, 0),
            row(set, 1, " ", 4, 2048, 0, 0),
            row(set, 1, " ", 5, 2120, 0, 0),
            row(set, 1, " ", 6, 2194, 0, 0),
            row(setup_loop, 1, " ", 1, 32, 0, 0),
            row(loop, 1, " ", 7, 0, 8, 13),
            row(print_decrement, 1, "Pin #", 2, 1, 0, 0),
            row(address, 1, " ", 4, 0, 0, 0),
            row(text, 1, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 4, 0, 1, 1),
            row(address, 1, " ", 5, 0, 0, 0),
            row(text, 1, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 5, 0, 1, 1),
            row(address, 1, " ", 6, 0, 0, 0),
            row(text, 1, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 6, 0, 1, 1),
            row(newline, 1, "", 1, 0, 0, 0),
            row(add, 1, "", 4, 1, 5, 1),
            row(add, 1, "", 6, 1, 0, 0),
            row(address, 1, " ", 0, 0, 0, 0),
            row(fuses_forward, 1, "x-", 0, 0, 1, 32),
            row(newline, 1, " ", 1, 0, 0, 0),
            row(end_row, 1, " ", 0, 0, 0, 32),
            row(set, 2, " ", 4, 2052, 0, 0),
            row(set, 2, " ", 5, 2124, 0, 0),
            row(set, 2, " ", 6, 2198, 0, 0),
            row(setup_loop, 2, " ", 1, 32, 2, 14),
            row(loop, 2, " ", 7, 0, 8, 13),
            row(print_decrement, 2, "Pin #", 2, 1, 0, 0),
            row(address, 2, " ", 4, 0, 0, 0),
            row(text, 2, " Pol", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 4, 0, 1, 1),
            row(address, 2, " ", 5, 0, 0, 0),
            row(text, 2, " Ac1", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 5, 0, 1, 1),
            row(address, 2, " ", 6, 0, 0, 0),
            row(text, 2, " Ac2", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 6, 0, 1, 1),
            row(newline, 2, "", 1, 0, 0, 0),
            row(add, 2, "", 4, 1, 5, 1),
            row(add, 2, "", 6, 1, 0, 0),
            row(address, 2, " ", 0, 0, 0, 0),
            row(fuses_forward, 2, "x-", 0, 0, 1, 32),
            row(newline, 2, " ", 1, 0, 0, 0),
            row(end_row, 2, " ", 0, 0, 0, 32),
            row(end, 0, "", 0, 0, 0, 0),
        ]
    }

    initialization {
        columns = [first_fuse, last_fuse, value]
        rows = [
            row(2056, 2119, 0),
            row(2120, 2127, 1),
            row(2128, 2191, 1),
            row(2192, 2192, 1),
            row(2193, 2193, 1),
            row(2194, 2201, 1),
        ]
    }

    connections {
        defaults {
            source_pin = 0
            compiler_link = yes
            config_value = 0
        }
        columns = [line, pin, function, group, member]
        rows = [
            row(3, 19, none, 1, 0),
            row(1, 19, oe, 1, 1),
            row(6, 18, none, 2, 0),
            row(4, 18, oe, 2, 1),
            row(9, 17, none, 3, 0),
            row(7, 17, oe, 3, 1),
            row(12, 16, none, 4, 0),
            row(10, 16, oe, 4, 1),
            row(15, 14, none, 5, 0),
            row(13, 14, oe, 5, 1),
            row(18, 13, none, 6, 0),
            row(16, 13, oe, 6, 1),
            row(21, 12, none, 7, 0),
            row(19, 12, oe, 7, 1),
            row(24, 11, none, 8, 0),
            row(22, 11, oe, 8, 1),
        ]
    }

    fitter_arguments {
        defaults {
            kind = none
            text = ""
        }
        columns = []
        rows = [
            row(),
        ]
    }

}
