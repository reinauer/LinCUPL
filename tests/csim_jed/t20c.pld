Name     t20c;
PartNo   00;
Date     2026-01-01;
Revision 01;
Designer LinCUPL;
Company  LinCUPL;
Assembly None;
Location None;
Device   g20v8;

/* GAL20V8 in complex mode: three-state outputs with product term output
   enables, feedback from the pins, the two outputs without feedback
   (pins 15 and 22) */

Pin [1..6] = [a, b, c, d, e, f];
Pin 13 = g;
Pin 14 = h;
Pin 23 = i;
Pin 22 = x;
Pin 21 = !y;
Pin 20 = z;
Pin 19 = io;
Pin 16 = inp;
Pin 15 = w;

x = a & b # c & d # g & h & i;
x.oe = e;
y = a $ b # z;
y.oe = c & !f;
z = y & d # a & inp;
io = a & b;
io.oe = !d & c;
w = io # e & !a # h & !i;
